desc:Dripsody Master Sync (Central Timebase)
options:gmem=nowundo_sync

slider1:host_sync_main=0<0,1,1>-Host Sync (Main)
slider2:host_sync_chorus=0<0,1,1>-Host Sync (Chorus)
slider3:host_sync_bridge=0<0,1,1>-Host Sync (Bridge)
slider4:host_sync_meas=1<1,16,1>-Host Sync Measures (Reaper)
slider5:ui_scale=100<25,150,25>-UI Zoom (%)
slider6:sync_grid=0<0,4,1{Bar,Beat,1/8,Triplet,1/16}>-Exit Grid (Loop Sync)
slider7:sync_start=0<0,1,1{Off,On}>-Start Sync (wait grid before REC)
slider8:rephase_on=1<0,1,1{Off,On}>-Re-phase Host loops
slider9:rephase_ms=2<0.5,20,0.5>-Re-phase tolerance (ms)
slider10:at_force=0<0,64,1>-Auto-Tempo : temps forces (0 = Auto)

@init
ext_noinit = 1;
max_instances = 5;
ep_prev = 100;   // memoire des etats Host precedents (3 cases)
ep_prev[0] = 0; ep_prev[1] = 0; ep_prev[2] = 0;
// AUTO-TEMPO (fusionne ici, 21 nov. 2026 ; avant : script Lua "Auto-Tempo Sync") : ce JSFX devine les temps de la boucle
// maitre et publie le tempo voulu ; le script Launchpad l'applique a REAPER (un JSFX ne peut pas changer le tempo,
// ni lancer Play / Stop) quand AUTO-SYNC (gmem[95]) est ON.
//   gmem[917] = tempo voulu (0 = pas de boucle maitre) | [918] = nombre de temps choisi | [919] = compteur de changements
//   des temps forces (le Launchpad re-applique quand il change)
at_c = 200;
at_c[0] = 1; at_c[1] = 2; at_c[2] = 3; at_c[3] = 4; at_c[4] = 5; at_c[5] = 6; at_c[6] = 7; at_c[7] = 8;
at_c[8] = 12; at_c[9] = 16; at_c[10] = 24; at_c[11] = 32; at_c[12] = 48; at_c[13] = 64;
at_mv = 240;
mb_tv = 280;

// Réinitialise à 100 si la valeur en mémoire est hors-bornes (notamment l'ancien 1)
(slider5 < 25 || slider5 > 150) ? slider5 = 100;
ui_scale = slider5 / 100.0;

// --- COMMANDES EXTERNES (Virtual Launchpad) : gmem[96] Main | gmem[97] Chorus | gmem[98] Bridge
//     1 = Host Sync ON  |  2 = Host Sync OFF (unlock) ; remis a 0 apres traitement
function handle_ext_cmds() local(p, c, mask, off) (
    p = 1;
    loop(3,
        c = gmem[95 + p];
        off = (p - 1) * 10;
        mask = (p == 1 ? 1 : (p == 2 ? 2 : 4));
        c == 1 ? (
            p == 1 ? slider1 = 1 : (p == 2 ? slider2 = 1 : slider3 = 1);
            sliderchange(mask);
            slider_automate(mask);
            gmem[95 + p] = 0;
        ) : c == 2 ? (
            p == 1 ? slider1 = 0 : (p == 2 ? slider2 = 0 : slider3 = 0);
            gmem[off] == 2 ? gmem[off] = 0;
            sliderchange(mask);
            slider_automate(mask);
            gmem[95 + p] = 0;
        );
        p += 1;
    );
);

function handle_host_sync_all() local(beats_meas, host_bpm, b_len, m_len, total_beats, cur_beat, beat_in_cycle, phase_samples, mi, m_base, m_id, p, offset, enabled, main_locked, main_master_id, master_slot_idx, master_bpm_val, master_gmem_base, m_active_part, m_part_base, m_alias) (
    handle_ext_cmds();
    host_bpm = max(tempo, 20.0);
    beats_meas = ts_num > 0 ? ts_num : 4;
    total_beats = beats_meas * max(1, floor(slider4));
    
    b_len = (srate * 60.0) / host_bpm;
    m_len = b_len * total_beats;

    cur_beat = beat_position >= 0 ? beat_position : 0;
    beat_in_cycle = cur_beat % total_beats;
    phase_samples = floor(beat_in_cycle * b_len);

    p = 1;
    loop(3,
        offset = (p - 1) * 10;
        enabled = (p == 1 ? slider1 : (p == 2 ? slider2 : slider3));
        // epoch de synchro Host (gmem[914..916]) : +1 a chaque (re)activation. Les loopers enregistres sous un epoch
        // anterieur ne sont plus re-phases (ils n'ont plus de rapport avec la nouvelle synchro).
        // +1 a chaque (re)prise du Host : front montant du slider OU slot repris par autre chose (looper maitre...) puis rendu
        (enabled > 0.5 && (ep_prev[p - 1] == 0 || gmem[offset] != 2)) ? gmem[913 + p] = gmem[913 + p] + 1;
        ep_prev[p - 1] = enabled > 0.5 ? 1 : 0;

        enabled ? (
            gmem[offset] = 2; 
            gmem[offset + 1] = 0; 
            gmem[offset + 2] = m_len; 
            gmem[offset + 3] = phase_samples; 
        ) : (
            gmem[offset] == 2 ? (
                gmem[offset] = 0;
            );
        );
        p += 1;
    );

    main_locked = gmem[0];
    main_master_id = gmem[1];

    master_slot_idx = -1; 
    master_bpm_val = 0.0;

    (main_locked == 1 && main_master_id > 0) ? (
      mi = 0;
      loop(max_instances,
        m_base = 1000 + (mi * 600);
        m_id = gmem[m_base];
        m_alias = gmem[m_base + 1];
        (m_id == main_master_id || m_alias == main_master_id) ? (
          master_slot_idx = mi;
        );
        mi += 1;
      );
    );

    gmem[910] = master_slot_idx;

    (main_locked == 1 && master_slot_idx >= 0) ? (
        master_gmem_base = 1000 + (master_slot_idx * 600);
        m_active_part = gmem[master_gmem_base + 42];
        m_active_part < 1 ? m_active_part = 1;
        
        m_part_base = master_gmem_base + (m_active_part - 1) * 200;
        master_bpm_val = gmem[m_part_base + 155];
    );

    gmem[912] = master_bpm_val;
    gmem[99] = max(0, min(4, floor(slider6 + 0.5)));
    gmem[94] = slider7 > 0.5 ? 1 : 0;
    gmem[93] = rephase_on > 0.5 ? 1 : 0;
    gmem[92] = rephase_ms;
);

// score d'un nombre de temps : proche de 112 BPM, nombre entier de mesures (puissance de 2 de preference), proche du tempo courant
function at_score(b, bpm, cur, mb) local(s, k, kk) (
    s = 3 * abs(log(bpm / 112) / log(2));
    k = b / mb;
    k != floor(k) ? ( s += 4; ) : ( kk = floor(k); (kk & (kk - 1)) != 0 ? s += 1.5; );
    (cur >= 50 && cur <= 220) ? s += 0.5 * abs(log(bpm / cur) / log(2));
    s;
);

function at_compute() local(idx, base, part, len, hint, i, b, bpm, sc, best) (
    at_mb = ts_num >= 1 ? floor(ts_num + 0.5) : 4;
    len = (gmem[0] == 1 && gmem[1] > 0) ? gmem[2] : 0;
    at_dur = len > 0 ? len / srate : 0;
    hint = 0;
    idx = gmem[910];
    idx >= 0 ? (
        base = 1000 + floor(idx + 0.5) * 600;
        part = max(1, floor(gmem[base + 42] + 0.5));
        hint = gmem[base + (part - 1) * 200 + 31];
    );
    at_hint = hint;
    at_b = 0; at_bpm = 0;
    at_dur > 0.001 ? (
        slider10 >= 1 ? (
            at_b = max(floor(slider10 + 0.5), at_mb);
        ) : hint >= 1 ? (
            at_b = max(floor(hint + 0.5), at_mb);
        ) : (
            best = 1000000000; i = 0;
            loop(14,
                b = at_c[i];
                b >= at_mb ? (
                    bpm = b / at_dur * 60;
                    sc = at_score(b, bpm, tempo, at_mb);
                    sc < best ? ( best = sc; at_b = b; );
                );
                i += 1;
            );
            at_b == 0 ? at_b = at_mb;
        );
        at_bpm = at_b / at_dur * 60;
    );
    gmem[917] = at_bpm;
    gmem[918] = at_b;
);

function at_set(v) (
    slider10 = v;
    sliderchange(512);
    slider_automate(512);
    gmem[919] = gmem[919] + 1;
);

@slider
(slider5 < 25 || slider5 > 150) ? slider5 = 100;
ui_scale = slider5 / 100.0;
handle_host_sync_all();

@block
gmem[921] = time_precise();   // battement du MSV3 : sans lui, les loopers liberent une synchro Host restee en memoire
handle_host_sync_all();
at_compute();

@sample

@gfx 330 390
gfx_clear = 35 + 12 * 256 + 15 * 65536;

(slider5 < 25 || slider5 > 150) ? slider5 = 100;
ui_scale = max(0.25, min(2.0, slider5 / 100.0));

// Fonctions graphiques adaptées à l'échelle
function draw_rect(rx, ry, rw, rh) (
    gfx_rect(floor(rx * ui_scale), floor(ry * ui_scale), max(1, floor(rw * ui_scale)), max(1, floor(rh * ui_scale)));
);

function draw_frame(rx, ry, rw, rh) (
    gfx_rect(floor(rx * ui_scale), floor(ry * ui_scale), max(1, floor(rw * ui_scale)), max(1, floor(rh * ui_scale)), 0);
);

function set_pos(px, py) (
    gfx_x = floor(px * ui_scale);
    gfx_y = floor(py * ui_scale);
);

// Coordonnées souris virtuelles
mx = mouse_x / ui_scale;
my = mouse_y / ui_scale;

mouse_down = mouse_cap & 1;
mouse_click = mouse_down && !(last_mouse_cap & 1);

// Polices adaptées à l'échelle
f_title_sz = max(6, floor(13 * ui_scale));
f_slot_sz  = max(6, floor(13 * ui_scale));
f_ui_sz    = max(6, floor(10 * ui_scale));

gfx_setfont(1, "Arial", f_title_sz, 'b');
gfx_setfont(2, "Arial", f_ui_sz, 'b');
gfx_setfont(3, "Arial", f_slot_sz, 'b');
gfx_setfont(4, "Arial", f_ui_sz);

// --- BOUTON AUTO-SYNC ---
btn_auto_x = 155; btn_auto_y = 7; btn_auto_w = 100; btn_auto_h = 24;
auto_hov = mx >= btn_auto_x && mx <= btn_auto_x + btn_auto_w && my >= btn_auto_y && my <= btn_auto_y + btn_auto_h;

gmem[95] == 1 ? gfx_set(0.2, 0.6, 0.2, 1) : gfx_set(0.4, 0.1, 0.1, 1);
auto_hov ? (gmem[95] == 1 ? gfx_set(0.3, 0.7, 0.3, 1) : gfx_set(0.5, 0.2, 0.2, 1)); 
draw_rect(btn_auto_x, btn_auto_y, btn_auto_w, btn_auto_h);
gfx_set(1, 1, 1, 0.2); 
draw_frame(btn_auto_x, btn_auto_y, btn_auto_w, btn_auto_h);

gfx_setfont(2, "Arial", f_ui_sz, 'b');
gfx_set(1, 1, 1, 0.9);
set_pos(btn_auto_x + 9, btn_auto_y + 7);
gmem[95] == 1 ? gfx_drawstr("AUTO-SYNC: ON") : gfx_drawstr("AUTO-SYNC: OFF");

mouse_click && auto_hov ? (
    gmem[95] = 1 - gmem[95]; 
);

// --- BOUTON ZOOM CLICABLE (25% -> 50% -> 75% -> 100% -> 150%) ---
btn_zoom_x = 262; btn_zoom_y = 7; btn_zoom_w = 58; btn_zoom_h = 24;
zoom_hov = mx >= btn_zoom_x && mx <= btn_zoom_x + btn_zoom_w && my >= btn_zoom_y && my <= btn_zoom_y + btn_zoom_h;

gfx_set(0.20, 0.25, 0.35, 1);
zoom_hov ? gfx_set(0.28, 0.35, 0.48, 1);
draw_rect(btn_zoom_x, btn_zoom_y, btn_zoom_w, btn_zoom_h);
gfx_set(1, 1, 1, 0.2);
draw_frame(btn_zoom_x, btn_zoom_y, btn_zoom_w, btn_zoom_h);

gfx_setfont(2, "Arial", f_ui_sz, 'b');
gfx_set(1, 1, 1, 0.9);
set_pos(btn_zoom_x + 10, btn_zoom_y + 7);
sprintf(#zoom_txt, "%d%%", floor(slider5 + 0.5));
gfx_drawstr(#zoom_txt);

// Clic : avance d'un cran et envoie le bon bitmask (16 = slider 5)
mouse_click && zoom_hov ? (
    slider5 < 40 ? slider5 = 50 :
    slider5 < 65 ? slider5 = 75 :
    slider5 < 90 ? slider5 = 100 :
    slider5 < 125 ? slider5 = 150 :
    slider5 = 25;
    
    sliderchange(16);
    slider_automate(16);
);

// --- TITRE PRINCIPAL ---
gfx_setfont(1, "Arial", f_title_sz, 'b');
set_pos(12, 12); 
gfx_set(1, 1, 1, 1);
gfx_drawstr("DRIPSODY SYNC");

// --- SLOTS DE SYNC ---
function draw_slot(part_name, offset, y) local(locked, mid, mlen, btn_x, hov, slot_bpm, s_idx, si, s_b, s_part, s_part_base, inst_btn_w, inst_btn_x, inst_id_val, inst_alias_val, inst_hov, btn_host_hov, s_base, mask) (
    locked = gmem[offset];
    mid = gmem[offset + 1];
    mlen = gmem[offset + 2];
    mask = (offset == 0 ? 1 : (offset == 10 ? 2 : 4));
    
    gfx_set(0.18, 0.05, 0.07, 1); draw_rect(10, y, 310, 46);
    gfx_set(0.28, 0.10, 0.12, 1); draw_frame(10, y, 310, 46);
    
    gfx_setfont(3, "Arial", f_slot_sz, 'b');
    gfx_set(0.9, 0.8, 0.2, 1);
    set_pos(20, y + 5); 
    gfx_drawstr(part_name);
    
    slot_bpm = 0.0;
    locked == 1 && mid > 0 ? (
        s_idx = -1;
        si = 0;
        loop(max_instances,
            s_b = 1000 + (si * 600);
            (gmem[s_b] == mid || gmem[s_b + 1] == mid) ? s_idx = si;
            si += 1;
        );
        s_idx >= 0 ? (
            s_base = 1000 + (s_idx * 600);
            s_part = gmem[s_base + 42];
            s_part < 1 ? s_part = 1;
            s_part_base = s_base + (s_part - 1) * 200;
            slot_bpm = gmem[s_part_base + 155];
        );
    );

    gfx_setfont(4, "Arial", f_ui_sz);
    set_pos(20, y + 26);
    locked == 0 ? (
        gfx_set(0.2, 0.8, 0.3, 1); gfx_drawstr("FREE: Choisir source");
    ) : locked == 1 ? (
        gfx_set(0.9, 0.2, 0.2, 1); 
        slot_bpm > 0 ? (
            sprintf(#bpm_info, "MASTER (ID: %d) - %.1f BPM", mid, slot_bpm);
            gfx_drawstr(#bpm_info);
        ) : (
            sprintf(#bpm_info, "MASTER (ID: %d) - En attente...", mid);
            gfx_drawstr(#bpm_info);
        );
    ) : (
        gfx_set(0.2, 0.6, 0.9, 1); gfx_drawstr("HOST SYNC (Reaper)");
    );
    
    locked != 0 ? (
        btn_x = 252;
        hov = mx >= btn_x && mx <= btn_x + 58 && my >= y + 10 && my <= y + 36;
        gfx_set(0.3, 0.1, 0.15, 1); hov ? gfx_set(0.4, 0.15, 0.2, 1);
        draw_rect(btn_x, y + 10, 58, 26);
        gfx_set(1, 1, 1, 0.1); draw_frame(btn_x, y + 10, 58, 26);
        gfx_set(1, 1, 1, 0.8); 
        set_pos(btn_x + 8, y + 16); 
        gfx_drawstr("Unlock");
        
        mouse_click && hov ? (
            gmem[offset] = 0;
            offset == 0 ? slider1 = 0 : (offset == 10 ? slider2 = 0 : slider3 = 0);
            sliderchange(mask);
            slider_automate(mask);
        );
    ) : (
        btn_host_hov = mx >= 125 && mx <= 162 && my >= y + 10 && my <= y + 36;
        gfx_set(0.15, 0.3, 0.4, 1); btn_host_hov ? gfx_set(0.2, 0.4, 0.5, 1);
        draw_rect(125, y + 10, 37, 26);
        gfx_set(1, 1, 1, 0.1); draw_frame(125, y + 10, 37, 26);
        gfx_set(1, 1, 1, 0.8); 
        set_pos(129, y + 16); 
        gfx_drawstr("Host");
        
        mouse_click && btn_host_hov ? (
            offset == 0 ? slider1 = 1 : (offset == 10 ? slider2 = 1 : slider3 = 1);
            sliderchange(mask);
            slider_automate(mask);
            handle_host_sync_all();
        );
        
        inst_btn_x = 168;
        inst_btn_w = 24;
        si = 0;
        loop(max_instances,
            s_b = 1000 + (si * 600);
            inst_id_val = gmem[s_b];
            inst_alias_val = gmem[s_b + 1];
            
            inst_alias_val > 0 ? (
                inst_hov = mx >= inst_btn_x && mx <= inst_btn_x + inst_btn_w && my >= y + 10 && my <= y + 36;
                gfx_set(0.3, 0.15, 0.15, 1); inst_hov ? gfx_set(0.4, 0.2, 0.2, 1);
                draw_rect(inst_btn_x, y + 10, inst_btn_w, 26);
                gfx_set(1, 1, 1, 0.1); draw_frame(inst_btn_x, y + 10, inst_btn_w, 26);
                gfx_set(1, 1, 1, 0.8); 
                set_pos(inst_btn_x + 8, y + 16); 
                
                sprintf(#alias_txt, "%d", inst_alias_val % 10);
                gfx_drawstr(#alias_txt);
                
                mouse_click && inst_hov ? (
                    gmem[offset] = 1; 
                    gmem[offset + 1] = inst_alias_val;
                    offset == 0 ? slider1 = 0 : (offset == 10 ? slider2 = 0 : slider3 = 0);
                    sliderchange(mask);
                    slider_automate(mask);
                );
                inst_btn_x += inst_btn_w + 4;
            );
            si += 1;
        );
    );
);

draw_slot("MAIN", 0, 40);
draw_slot("CHORUS", 10, 95);
draw_slot("BRIDGE", 20, 150);

// --- SELECTEUR DE GRILLE DE SORTIE (sync looper : mesure / temps / croche / triolet / double) ---
gfx_setfont(4, "Arial", f_ui_sz);
gfx_set(0.9, 0.8, 0.2, 1);
set_pos(12, 200);
gfx_drawstr("Sortie Loop Sync : mesure / temps / subdivision");
gi_ = 0;
loop(5,
    gx_ = 10 + gi_ * 62; gy_ = 214; gw_ = 58; gh_ = 22;
    ghov_ = mx >= gx_ && mx <= gx_ + gw_ && my >= gy_ && my <= gy_ + gh_;
    floor(slider6 + 0.5) == gi_ ? gfx_set(0.55, 0.40, 0.08, 1) : gfx_set(0.20, 0.25, 0.35, 1);
    ghov_ ? ( floor(slider6 + 0.5) == gi_ ? gfx_set(0.65, 0.48, 0.12, 1) : gfx_set(0.28, 0.35, 0.48, 1); );
    draw_rect(gx_, gy_, gw_, gh_);
    gfx_set(1, 1, 1, 0.2); draw_frame(gx_, gy_, gw_, gh_);
    gfx_setfont(2, "Arial", f_ui_sz, 'b');
    gfx_set(1, 1, 1, 0.9);
    set_pos(gx_ + 8, gy_ + 6);
    gi_ == 0 ? gfx_drawstr("BAR") : gi_ == 1 ? gfx_drawstr("BEAT") : gi_ == 2 ? gfx_drawstr("1/8") : gi_ == 3 ? gfx_drawstr("TRIPLET") : gfx_drawstr("1/16");
    mouse_click && ghov_ ? (
        slider6 = gi_;
        sliderchange(32);
        slider_automate(32);
        gmem[99] = gi_;
    );
    gi_ += 1;
);

// --- OPTION : ATTENDRE LE POINT DE SYNCHRO AVANT D'ENTRER EN REC (meme grille que la sortie) ---
sx_ = 10; sy_ = 242; sw_ = 310; sh_ = 22;
shov_ = mx >= sx_ && mx <= sx_ + sw_ && my >= sy_ && my <= sy_ + sh_;
slider7 > 0.5 ? gfx_set(0.15, 0.50, 0.30, 1) : gfx_set(0.20, 0.25, 0.35, 1);
shov_ ? ( slider7 > 0.5 ? gfx_set(0.20, 0.60, 0.38, 1) : gfx_set(0.28, 0.35, 0.48, 1); );
draw_rect(sx_, sy_, sw_, sh_);
gfx_set(1, 1, 1, 0.2); draw_frame(sx_, sy_, sw_, sh_);
gfx_setfont(2, "Arial", f_ui_sz, 'b');
gfx_set(1, 1, 1, 0.9);
set_pos(sx_ + 10, sy_ + 6);
slider7 > 0.5 ? gfx_drawstr("START SYNC : ON  (1er REC, hors Auto-Rec)") : gfx_drawstr("START SYNC : OFF  (REC immediat)");
mouse_click && shov_ ? (
    slider7 = slider7 > 0.5 ? 0 : 1;
    sliderchange(64);
    slider_automate(64);
    gmem[94] = slider7;
);

// --- OPTION : RE-PHASAGE DES LOOPERS SYNCHRO HOST SUR L'HORLOGE DE REAPER ---
rx_ = 10; ry_ = 270; rw_ = 310; rh_ = 22;
rhov_ = mx >= rx_ && mx <= rx_ + rw_ && my >= ry_ && my <= ry_ + rh_;
rephase_on > 0.5 ? gfx_set(0.15, 0.50, 0.30, 1) : gfx_set(0.20, 0.25, 0.35, 1);
rhov_ ? ( rephase_on > 0.5 ? gfx_set(0.20, 0.60, 0.38, 1) : gfx_set(0.28, 0.35, 0.48, 1); );
draw_rect(rx_, ry_, rw_, rh_);
gfx_set(1, 1, 1, 0.2); draw_frame(rx_, ry_, rw_, rh_);
gfx_setfont(2, "Arial", f_ui_sz, 'b');
gfx_set(1, 1, 1, 0.9);
set_pos(rx_ + 10, ry_ + 6);
rephase_on > 0.5 ? gfx_drawstr("RE-PHASE HOST : ON  (loopers de la synchro courante)") : gfx_drawstr("RE-PHASE HOST : OFF");
mouse_click && rhov_ ? (
    rephase_on = rephase_on > 0.5 ? 0 : 1;
    sliderchange(128);
    slider_automate(128);
    gmem[93] = rephase_on;
);

// --- REGLAGES (avant : sliders natifs, maintenant caches) : mesures du Host Sync | tolerance du Re-phase (menus) ---
function menu_btn(x, y, w, h, txt) local(hov) (
    hov = mx >= x && mx <= x + w && my >= y && my <= y + h;
    hov ? gfx_set(0.28, 0.35, 0.48, 1) : gfx_set(0.20, 0.25, 0.35, 1);
    draw_rect(x, y, w, h);
    gfx_set(1, 1, 1, 0.2); draw_frame(x, y, w, h);
    gfx_setfont(2, "Arial", f_ui_sz, 'b');
    gfx_set(1, 1, 1, 0.9);
    set_pos(x + 8, y + 6);
    gfx_drawstr(txt);
    mouse_click && hov;
);
sprintf(#mb_t, "HOST : %d MESURE%s  v", slider4, slider4 > 1 ? "S" : "");
menu_btn(10, 298, 150, 22, #mb_t) ? (
    #mb_m = ""; mb_k = 1;
    loop(16,
        sprintf(#mb_i, "%s%s%d mesure%s", mb_k > 1 ? "|" : "", floor(slider4 + 0.5) == mb_k ? "!" : "", mb_k, mb_k > 1 ? "s" : "");
        strcat(#mb_m, #mb_i);
        mb_k += 1;
    );
    set_pos(10, 320);
    mb_p = gfx_showmenu(#mb_m);
    mb_p >= 1 ? ( slider4 = mb_p; sliderchange(8); slider_automate(8); );
);
sprintf(#mb_t, "TOLERANCE RE-PHASE : %.1f ms  v", slider9);
menu_btn(166, 298, 154, 22, #mb_t) ? (
    #mb_m = ""; mb_k = 0;
    loop(10,
