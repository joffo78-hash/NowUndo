    wr_id == 40 ? ( cloud_lfo_rate = max(0.1, min(4, wr_v)); slider39 = cloud_lfo_rate; ) :
    wr_id == 41 ? ( cloud_lfo_depth = max(0, min(100, wr_v)); slider40 = cloud_lfo_depth; ) :
    wr_id == 11 ? ( trans_sens = max(0.01, min(0.8, wr_v)); slider10 = trans_sens; ) :
    wr_id == 12 ? ( trans_hold_ms = max(30, min(1000, wr_v)); slider11 = trans_hold_ms; ) :
    wr_id == 14 ? ( slicer_mode = max(0, min(5, floor(wr_v + 0.5))); slider13 = slicer_mode; slicer_regen(); ) :
    wr_id == 15 ? ( slicer_sub = max(0, min(5, floor(wr_v + 0.5))); slider14 = slicer_sub; ) :
    wr_id == 16 ? ( slice_decay_ms = max(4, min(2000, wr_v)); slice_decay_pos = decay_ms_to_pos(slice_decay_ms); slider15 = slice_decay_pos; ) :
    wr_id == 32 ? ( slicer_src = wr_v >= 0.5 ? 1 : 0; slider31 = slicer_src; src_auto = 0; slider56 = 0; ) :
    wr_id == 57 ? ( src_auto = wr_v >= 0.5 ? 1 : 0; slider56 = src_auto; src_auto ? start_analysis_ex(1); ) :
    wr_id == 33 ? ( grid_sub = max(0, min(9, floor(wr_v + 0.5))); slider32 = grid_sub; ) :
    wr_id == 37 ? ( cloud_pos_mode = wr_v >= 0.5 ? 1 : 0; slider36 = cloud_pos_mode; ) :
    wr_id == 39 ? ( cloud_lfo_shape = max(0, min(2, floor(wr_v + 0.5))); slider38 = cloud_lfo_shape; ) :
    wr_id == 42 ? ( sampler_root = max(0, min(127, floor(wr_v + 0.5))); slider42 = sampler_root; ) :
    wr_id == 43 ? ( sampler_pitch_mode = wr_v >= 0.5 ? 1 : 0; slider43 = sampler_pitch_mode; ) :
    wr_id == 44 ? ( sampler_release = max(0, min(3000, wr_v)); slider44 = sampler_release; ) :
    wr_id == 47 ? ( slicer_steps = max(1, min(32, floor(wr_v + 0.5))); slider47 = slicer_steps; ) :
