);

@slider
abs(slice_decay_pos - decay_ms_to_pos(slice_decay_ms)) > 0.06 ? ( slice_decay_ms = decay_pos_to_ms(slice_decay_pos); slice_decay_ms < 1950 ? slice_decay_ms = max(4, floor(slice_decay_ms + 0.5)); );
// slider45 == manual_id (meme variable JSFX)
loop_pos_pct != last_slider9 ? ( length > 0 ? ( req_p = (loop_pos_pct * 0.01) * length; abs(req_p - pos) > 10 ? trigger_pos_jump(req_p); ); last_slider9 = loop_pos_pct; );
(det_thresh != last_det_t || det_hold_ms != last_det_h) ? ( last_det_t = det_thresh; last_det_h = det_hold_ms; det_chg = 1; ) : slicer_mode != last_slicer_mode ? ( step_len = get_slicer_len(); generate_slicer_sequence(step_len); last_slicer_mode = slicer_mode; slicer_current_step = 0; );
slicer_pitch_spread != last_pitch_spread ? ( last_pitch_spread = slicer_pitch_spread; update_slicer_pitches(get_slicer_len()); );
cloud_on = slider23; loop_quant = slider24;
  (last_loop_quant >= 0 && loop_quant != last_loop_quant && br_on) ? br_refresh();
  last_loop_quant = loop_quant; cloud_density = slider25; cloud_chaos = slider26; cloud_spread = slider27; cloud_pitch_spread = slider34; cloud_mix = slider35; cloud_pos_mode = slider36; cloud_pos_pct = slider37; cloud_lfo_shape = slider38; cloud_lfo_rate = slider39; cloud_lfo_depth = slider40; grid_sub = slider32; looper_hue = slider41;
loop_start != prev_loop_start || loop_width != prev_loop_width ? sync_hard_resync = 1;

@sample
in0 = spl0; in1 = spl1; wet_s0 = 0; wet_s1 = 0;
qs_i += 1;
pos_step = 0;
peak_in_vu = max(peak_in_vu * vu_rel, max(abs(in0), abs(in1)));

ms_off = (active_part - 1) * 10;
is_slave = (gmem[ms_off] > 0 && gmem[ms_off + 1] != instance_id && gmem[ms_off + 1] != instance_alias);

is_slave && length > 0 ? (
    master_pos += 1.0;
    master_pos >= length ? (
        master_pos -= length;
        clk_cyc = (clk_cyc + 1) % 840;
        slicer_sample_counter = 1000000000;
        rp_pend != 0 ? ( master_pos += rp_pend; master_pos -= length * floor(master_pos / length); rp_pend = 0; rp_cnt = 0; sync_hard_resync = 1; );   // V3.12
    );
    active_part == 1 ? master_pos1 = master_pos : (active_part == 2 ? master_pos2 = master_pos : master_pos3 = master_pos);
) : (
    len_part1 > 0 ? (
      master_pos1 += 1.0;
      master_pos1 >= len_part1 ? (master_pos1 -= len_part1; active_part == 1 ? (clk_cyc = (clk_cyc + 1) % 840; slicer_sample_counter = 1000000000;));
      (gmem[0] == 1 && (gmem[1] == instance_id || gmem[1] == instance_alias)) ? (
        gmem[2] = (base_len_part1 > 0 ? base_len_part1 : len_part1);
        gmem[3] = master_pos1; gmem[4] = (active_part == 1 ? clk_cyc : clk_cyc1);
      );
    );
    len_part2 > 0 ? (
      master_pos2 += 1.0;
      master_pos2 >= len_part2 ? (master_pos2 -= len_part2; active_part == 2 ? (clk_cyc = (clk_cyc + 1) % 840; slicer_sample_counter = 1000000000;));
      (gmem[10] == 1 && (gmem[11] == instance_id || gmem[11] == instance_alias)) ? (
        gmem[12] = (base_len_part2 > 0 ? base_len_part2 : len_part2);
        gmem[13] = master_pos2; gmem[14] = (active_part == 2 ? clk_cyc : clk_cyc2);
      );
    );
    len_part3 > 0 ? (
      master_pos3 += 1.0;
      master_pos3 >= len_part3 ? (master_pos3 -= len_part3; active_part == 3 ? (clk_cyc = (clk_cyc + 1) % 840; slicer_sample_counter = 1000000000;));
      (gmem[20] == 1 && (gmem[21] == instance_id || gmem[21] == instance_alias)) ? (
        gmem[22] = (base_len_part3 > 0 ? base_len_part3 : len_part3);
        gmem[23] = master_pos3; gmem[24] = (active_part == 3 ? clk_cyc : clk_cyc3);
      );
    );
    active_part == 1 ? master_pos = master_pos1 : (active_part == 2 ? master_pos = master_pos2 : master_pos = master_pos3);
);

curr_peak = max(abs(in0), abs(in1));
ih_n += 1; ih_n >= 1073741824 ? ih_wrap(); ih_l[ih_n & ih_mask] = in0; ih_r[ih_n & ih_mask] = in1;
curr_peak >= trans_sens ? ( input_signal_active = 1; hold_samples_left = srate * (trans_hold_ms * 0.001); ) : ( hold_samples_left > 0 ? ( hold_samples_left -= 1; input_signal_active = 1; ) : ( input_signal_active = 0; ); );
init_done == 0 ? ( sm_pitch = pitch; sm_speed = speed; init_done = 1; );
sm_pitch += (pitch - sm_pitch) * 0.005; sm_speed += (speed - sm_speed) * 0.005;
pitch_ratio = 2 ^ (sm_pitch / 12); varispeed = sm_speed * pitch_ratio; rec_speed = varispeed;
// V3.7: en Slicer et Cloud le moteur granulaire pitch/speed est inactif -> vari-speed applique meme si Link est Off
link_eff = (link_on || play_mode == 1 || cloud_on);
is_one_shot_mode = (play_mode == 2);
slice_att_eff_ms = slice_decay_ms > 1950 ? slice_attack_ms : min(slice_attack_ms, slice_decay_ms);

mclk_trk && mclk_valid ? ( mclk_pos += 1.0; mclk_pos >= mclk_len ? ( mclk_pos -= mclk_len; mclk_cyc = (mclk_cyc + 1) % 840; ); );
state >= 2 && play_mode == 1 && trans_count > 0 ? (
  beats_per_step = slicer_sub == 0 ? 1.0 : (slicer_sub == 1 ? 0.5 : (slicer_sub == 2 ? 1.0/3.0 : (slicer_sub == 3 ? 0.25 : (slicer_sub == 4 ? 1.0/6.0 : 0.125))));
  mclk_on && mclk_valid ? (
    mclk_hb = (60 / max(tempo, 20)) * srate;
