    active_part == 1 ? (len_part1 = 0; base_len_part1 = 0; master_pos1 = 0;) : active_part == 2 ? (len_part2 = 0; base_len_part2 = 0; master_pos2 = 0;) : (len_part3 = 0; base_len_part3 = 0; master_pos3 = 0;);
    idx_clr = active_part - 1; part_speed[idx_clr] = 1.0; part_pitch[idx_clr] = 0.0; part_rev[idx_clr] = 0; part_pingpong[idx_clr] = 0; part_play_mode[idx_clr] = 0; part_cloud_on[idx_clr] = 0; part_link_on[idx_clr] = 0; switch_history_slot(0);
    history_head = 0; history_count = 1; hist_undo = 0; hist_redo = 0; active_history_idx = 0;
    pending_part_switch = 0;
    ms_off = (active_part - 1) * 10; (gmem[ms_off] == 1 && (gmem[ms_off+1] == instance_id || gmem[ms_off+1] == instance_alias)) ? gmem[ms_off] = 0;
  );
  last_state_target = 0; state = 0;
  state_transition_fade = 0; xf_on = 0; rd_valid = 0; rp_tail_on = 0;
  sync_hard_resync = 1;
);
function slicer_mode_name(m) ( m == 0 ? "Random" : (m == 5 ? "All" : "Steps"); );
function grid_rate_name(m) ( m == 0 ? "1/4" : (m == 1 ? "1/8" : (m == 2 ? "1/12" : (m == 3 ? "1/16" : (m == 4 ? "1/24" : (m == 5 ? "1/32" : (m == 6 ? "1/48" : (m == 7 ? "1/64" : (m == 8 ? "1/96" : "1/128")))))))); );
function slicer_rate_name(m) ( m == 0 ? "1/4" : (m == 1 ? "1/8" : (m == 2 ? "1/12" : (m == 3 ? "1/16" : (m == 4 ? "1/24" : "1/32")))); );
function lfo_shape_name(s) ( s == 0 ? "Sine" : (s == 1 ? "Saw" : "Inv Saw"); );
function quant_name(q) ( q == 0 ? "Free" : q == 1 ? "1/2" : q == 2 ? "1/3" : q == 3 ? "1/4" : q == 4 ? "1/6" : q == 5 ? "1/8" : q == 6 ? "1/12" : q == 7 ? "1/16" : q == 8 ? "1/32" : "1/64"; );
function quant_val(q) ( q == 0 ? 0 : q == 1 ? 2 : q == 2 ? 3 : q == 3 ? 4 : q == 4 ? 6 : q == 5 ? 8 : q == 6 ? 12 : q == 7 ? 16 : q == 8 ? 32 : 64; );
function loop_max_len() ( length > 0 ? length : (state == 1 ? pos : buf_len); );
function quant_grid() local(ml, qv) ( ml = loop_max_len(); qv = quant_val(loop_quant); (qv > 0 && ml > 0) ? ml / qv : 0; );
function min_width() local(g) ( g = quant_grid(); g > 0 ? g : srate * 0.05; );
function apply_quant_start(val_s) local(ml, g) ( ml = loop_max_len(); g = quant_grid(); g > 0 ? val_s = floor(val_s / g + 0.5) * g; max(0, min(val_s, ml - min_width())); );
function apply_quant_width(val_w, s_pos) local(ml, g, mw) ( ml = loop_max_len(); g = quant_grid(); mw = min_width(); g > 0 ? val_w = floor(val_w / g + 0.5) * g; max(mw, min(val_w, max(mw, ml - s_pos))); );

// Duree d'une subdivision BR en samples, RELATIVE AU TEMPS (pas a la longueur de boucle).
// 1/4 = 1 beat, 1/8 = 1/2 beat, 1/16 = 1/4 beat, etc. (base mesure 4/4).
function br_quant_len() local(qv, hb) (
  qv = quant_val(loop_quant);
  qv <= 0 ? 0 : (
    hb = loop_beat_len();
    max(srate * 0.01, hb * (4.0 / qv))
  );
);

function do_beat_repeat(want) local(i, nx, g, cur, best, bd, d) (
  length <= 0 ? ( br_on = 0; ) : (
    want ? (
      !br_on ? ( br_saved_start = loop_start; br_saved_width = loop_width; br_bg_s = loop_start; br_bg_e = min(length, loop_start + loop_width); br_bg_pos = max(br_bg_s, min(br_bg_e - 1, pos)); );
      cur = max(0, min(pos, length - srate * 0.01));
      // In = slice (transitoire) la plus proche de la tete de lecture
      best = cur; bd = 1000000000000;
      trans_count > 0 ? (
        i = 0;
        loop(trans_count,
          d = abs(trans_mem[i] - cur);
          d < bd ? ( bd = d; best = trans_mem[i]; );
          i += 1;
        );
      );
      loop_start = max(0, min(best, length - srate * 0.01));
      loop_quant == 0 ? (
        // Free : Out = prochaine slice apres In
        nx = length; i = 0;
        loop(trans_count, (trans_mem[i] > loop_start + 1 && trans_mem[i] < nx) ? nx = trans_mem[i]; i += 1; );
        loop_width = max(srate * 0.01, (nx < length ? nx : length) - loop_start);
      ) : (
        // Quantise musicale : Out = In + 1 subdivision (1/16 = double, etc.)
        g = br_quant_len();
        g > 0 ? loop_width = min(g, length - loop_start)
              : loop_width = max(srate * 0.01, length - loop_start);
      );
      br_on = 1; sync_hard_resync = 1; br_suppress_an = 1;
    ) : (
      br_on ? (
        loop_start = br_saved_start; loop_width = br_saved_width;
        br_on = 0; sync_hard_resync = 1; br_suppress_an = 1;
      );
    );
  );
);

// Recalcule la fenetre BR (garde In, adapte Out a la quantize courante) sans toucher au snapshot
function br_refresh() local(i, nx, g) (
  br_on && length > 0 ? (
    loop_quant == 0 ? (
      nx = length; i = 0;
      loop(trans_count, (trans_mem[i] > loop_start + 1 && trans_mem[i] < nx) ? nx = trans_mem[i]; i += 1; );
      loop_width = max(srate * 0.01, (nx < length ? nx : length) - loop_start);
    ) : (
      g = br_quant_len();
      g > 0 ? loop_width = min(g, length - loop_start) : 0;
    );
    sync_hard_resync = 1; br_suppress_an = 1;
  );
);

// Fraction BR la plus proche d'une largeur w (samples) : renvoie l'index loop_quant 1..9
function br_nearest_q(w) local(q, best, bd, d) (
  best = 7; bd = 1000000000000; q = 1;
  loop(9, d = abs(w - max(srate * 0.01, loop_beat_len() * (4.0 / quant_val(q)))); d < bd ? ( bd = d; best = q; ); q += 1; );
  best;
);
// Beat Repeat : Out = choix de la fraction (largeur -> fraction la plus proche)
function br_set_width(w) ( loop_quant = br_nearest_q(w); slider24 = loop_quant; br_refresh(); );

function fmt_note(dst, n) local(nm, oc) (
  nm = floor(n) % 12; oc = floor(n / 12) - 1;
  sprintf(dst, "%s%d", nm == 0 ? "C" : (nm == 1 ? "C#" : (nm == 2 ? "D" : (nm == 3 ? "D#" : (nm == 4 ? "E" : (nm == 5 ? "F" : (nm == 6 ? "F#" : (nm == 7 ? "G" : (nm == 8 ? "G#" : (nm == 9 ? "A" : (nm == 10 ? "A#" : "B")))))))))), oc);
);
function sampler_mode_now() ( (state == 0 && length > 0) ? ( play_mode == 1 ? (trans_count > 0 ? 1 : 0) : 2 ) : 0; );
function sampler_slice_end(st) local(i, nx) (
  nx = min(loop_start + loop_width, length);
  nx <= st + 16 ? nx = length;
  i = 0; loop(trans_count, (trans_mem[i] > st + 1 && trans_mem[i] < nx) ? nx = trans_mem[i]; i += 1; );
  nx;
);
function sampler_release_all(step) local(v, vb) (
  v = 0; loop(smp_nv, vb = smp_voice + v * smp_vs; vb[0] == 1 ? ( vb[0] = 2; vb[9] = step; ); v += 1; );
);
function sampler_note_off(note) local(v, vb, rt) (
  rt = sampler_release; v = 0;
  loop(smp_nv,
    vb = smp_voice + v * smp_vs;
    (vb[0] == 1 && vb[6] == note && (vb[11] > 0 || rt > 0)) ? ( vb[0] = 2; vb[9] = 1.0 / (max(5, rt) * 0.001 * srate); );
    v += 1;
  );
);
function sampler_note_on(note, vel) local(k, kmode, ok, st, en, v, vb, fr, old, old_age) (
  kmode = (smp_mode == 2);
  k = note - sampler_root;
  ok = kmode ? 1 : (k >= 0 && k < trans_count);
  ok ? (
    kmode ? ( st = floor(loop_start); en = floor(min(loop_start + loop_width, length)); ) : ( st = floor(trans_mem[k]); en = floor(sampler_slice_end(st)); );
    en > st + 8 ? (
      fr = -1; old = 0; old_age = 1000000000000; v = 0;
      loop(smp_nv,
        vb = smp_voice + v * smp_vs;
        (vb[0] == 1 && vb[6] == note) ? ( vb[0] = 2; vb[9] = smp_choke_rel; );
        (vb[0] == 0 && fr < 0) ? fr = v;
        (vb[0] > 0 && vb[8] < old_age) ? ( old_age = vb[8]; old = v; );
        v += 1;
      );
      fr < 0 ? fr = old;
      vb = smp_voice + fr * smp_vs; smp_age += 1;
      vb[0] = 1; vb[1] = rev_on ? en - 1 : st; vb[2] = st; vb[3] = en; vb[4] = vel / 127;
      vb[5] = 0; vb[6] = note; vb[7] = rev_on ? -1 : 1; vb[8] = 0; vb[9] = 0;
      vb[10] = kmode ? 2 ^ (k / 12) : 1;
      vb[11] = kmode ? (sampler_pitch_mode == 0 ? 1 : 2) : 0;
      vb[12] = vb[1]; vb[13] = 0; vb[14] = vb[1]; vb[15] = 1;
    );
  );
);
function sampler_read(p, st, en) local(i, fr, mx, a, b, c, d) (
  i = floor(p); fr = p - i; mx = en - 1;
  a = max(st, min(mx, i - 1)); b = max(st, min(mx, i)); c = max(st, min(mx, i + 1)); d = max(st, min(mx, i + 2));
  smp_rl = hermite(fr, left_buf[a], left_buf[b], left_buf[c], left_buf[d]);
  smp_rr = hermite(fr, right_buf[a], right_buf[b], right_buf[c], right_buf[d]);
);
function sampler_render() local(v, vb, p, d, m, i, rem, g, dead, ph, ageb, wa, wb, sa, sb, r, slice_env_smp, slice_decay_step_smp) (
  smp_l = 0; smp_r = 0; smp_nact = 0; v = 0;
  smp_G = max(64, floor(srate * grain_ms * 0.001)); smp_Gh = smp_G * 0.5;
  loop(smp_nv,
    vb = smp_voice + v * smp_vs;
    vb[0] > 0 ? (
      smp_nact += 1; p = vb[1]; d = vb[7]; m = vb[11]; i = floor(p);
      
      dead = (d > 0 ? p >= vb[3] : p < vb[2]) || vb[3] > length;
      dead ? ( vb[0] = 0; ) : (
        vb[0] == 1 ? ( vb[5] = min(1, vb[5] + smp_att); ) : ( vb[5] -= vb[9]; vb[5] <= 0 ? ( vb[5] = 0; vb[0] = 0; ); );
        rem = (d > 0 ? vb[3] - p : p - vb[2] + 1) / (m == 1 ? vb[10] : 1);
        g = (vb[0] == 2 ? vb[5] * vb[5] : vb[5]) * vb[4]; 
        rem < smp_tail ? g *= max(0, rem / smp_tail);
        
        vb[8] += 1.0;
        slice_att_eff_ms > 0 ? g *= min(1, vb[8] / max(1, srate * slice_att_eff_ms * 0.001));
        slice_decay_ms < 1950 ? ( 
          g *= max(0, 1.0 - vb[8] * (1.0 / max(2, srate * (slice_decay_ms * 0.001))));
        );
        
        m == 0 ? (
          smp_l += left_buf[i] * g; smp_r += right_buf[i] * g;
          vb[1] = p + d;
        ) : m == 1 ? (
          sampler_read(p, vb[2], vb[3]); smp_l += smp_rl * g; smp_r += smp_rr * g;
          vb[1] = p + d * vb[10];
        ) : (
          r = vb[10]; ph = vb[13] + 1;
          ph >= smp_G ? ( ph -= smp_G; vb[12] = p; vb[15] = 0; );
          (vb[13] < smp_Gh && ph >= smp_Gh) ? vb[14] = p;
          vb[13] = ph;
          ageb = ph >= smp_Gh ? ph - smp_Gh : ph + smp_Gh;
          wa = (vb[15] && ph < smp_Gh) ? 1 : lut_cos[floor(ph / smp_G * lut_size) % lut_size];
          wb = (vb[15] && ph < smp_Gh) ? 0 : lut_cos[floor(ageb / smp_G * lut_size) % lut_size];
          sa = vb[12] + d * r * ph; sb = vb[14] + d * r * ageb;
          (wa > 0.0001 && sa >= vb[2] && sa < vb[3]) ? ( sampler_read(sa, vb[2], vb[3]); smp_l += smp_rl * g * wa; smp_r += smp_rr * g * wa; );
          (wb > 0.0001 && sb >= vb[2] && sb < vb[3]) ? ( sampler_read(sb, vb[2], vb[3]); smp_l += smp_rl * g * wb; smp_r += smp_rr * g * wb; );
          vb[1] = p + d;
        );
      );
    );
    v += 1;
  );
);
function ui_arc(cx, cy, r, a0, a1) local(n, step, aa, bb) ( n = max(1, ceil(abs(a1 - a0) / 0.12)); step = (a1 - a0) / n; aa = a0; loop(n, bb = aa + step; gfx_line(cx + cos(aa) * r, cy + sin(aa) * r, cx + cos(bb) * r, cy + sin(bb) * r); gfx_line(cx + cos(aa) * (r - 1), cy + sin(aa) * (r - 1), cx + cos(bb) * (r - 1), cy + sin(bb) * (r - 1)); aa = bb; ); );
function ui_text(x, y, str, r, g, b, a, align) local(tw, th) ( gfx_set(r, g, b, a); gfx_measurestr(str, tw, th); gfx_x = align == 1 ? x - tw : x; gfx_y = y; gfx_drawstr(str); );
function ui_panel(x, y, w, h, title) ( gfx_set(r_bg * 0.68, g_bg * 0.68, b_bg * 0.68); gfx_rect(x, y, w, h); gfx_set(r_bg * 0.68 + 0.10, g_bg * 0.68 + 0.10, b_bg * 0.68 + 0.10); gfx_rect(x, y, w, h, 0); gfx_set(ui_ar, ui_ag, ui_ab); gfx_rect(x, y, w, 2); gfx_setfont(2); gfx_set(ui_ar, ui_ag, ui_ab, 0.95); gfx_x = x + 10; gfx_y = y + 5; gfx_drawstr(title); gfx_setfont(1); );
function ui_btn(x, y, w, h, label, on, cr, cg, cb) local(hov, tw, th, ua) ( ua = ui_en ? 1 : 0.4; hov = ui_en && mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h; ui_hov = hov; on ? gfx_set(cr, cg, cb, ua) : (hov ? gfx_set(0.32, 0.12, 0.15, ua) : gfx_set(0.22, 0.07, 0.09, ua)); gfx_rect(x, y, w, h); gfx_set(1, 1, 1, on ? 0.2 : 0.06); gfx_line(x, y, x + w - 1, y); gfx_set(cr, cg, cb, (on ? 0 : 0.8) * ua); gfx_rect(x, y + h - 2, w, 2); gfx_set(0, 0, 0, 0.4); gfx_rect(x, y, w, h, 0); gfx_setfont(1); gfx_set(1, 1, 1, (on ? 1 : 0.82) * ua); gfx_measurestr(label, tw, th); gfx_x = x + (w - tw) * 0.5; gfx_y = y + (h - th) * 0.5; gfx_drawstr(label); mouse_click && hov; );
function ui_knob(id, cx, cy, r, val, mn, mx, label, fmt, def) local(rng, hot, d, norm, ang, ua, tw, th, act) ( ui_chg = 0; rng = max(mx - mn, 0.000001); hot = ui_en && abs(mouse_x - cx) <= r + 5 && abs(mouse_y - cy) <= r + 5; ui_en && mouse_click && active_control == 0 && hot ? ( (mouse_cap & 4) ? ( val = def; ui_chg = 1; ) : ( active_control = id; ); ); ui_en && active_control == id ? ( d = last_mouse_y - mouse_y; (mouse_cap & 8) ? d *= 0.2; d != 0 ? ( val = max(mn, min(mx, val + d * rng / 200)); ui_chg = 1; ); ); ua = ui_en ? 1 : 0.4; act = (active_control == id); norm = max(0, min(1, (val - mn) / rng)); ang = 0.75 * $pi + norm * 1.5 * $pi; gfx_set(0.12, 0.04, 0.05, ua); gfx_circle(cx, cy, r - 2, 1); gfx_set(0.30, 0.12, 0.15, ua); gfx_circle(cx, cy, r - 2, 0); gfx_set(0.24, 0.09, 0.11, ua); ui_arc(cx, cy, r + 3, 0.75 * $pi, 2.25 * $pi); norm > 0.004 ? ( gfx_set(ui_ar, ui_ag, ui_ab, ua); ui_arc(cx, cy, r + 3, 0.75 * $pi, ang); ); gfx_set(1, 1, 1, ua * (act ? 1 : 0.9)); gfx_line(cx + cos(ang) * r * 0.3, cy + sin(ang) * r * 0.3, cx + cos(ang) * (r - 4), cy + sin(ang) * (r - 4)); gfx_setfont(1); gfx_set(0.85, 0.75, 0.78, ua); gfx_measurestr(label, tw, th); gfx_x = cx - tw * 0.5; gfx_y = cy - r - 18; gfx_drawstr(label); ui_ds_on ? strcpy(#knobval, #ui_ds) : sprintf(#knobval, fmt, ui_dv_on ? ui_dv : val); ui_dv_on = 0; ui_ds_on = 0; (act || hot) ? gfx_set(1, 1, 1, ua) : gfx_set(0.9, 0.82, 0.84, ua); gfx_measurestr(#knobval, tw, th); gfx_x = cx - tw * 0.5; gfx_y = cy + r + 7; gfx_drawstr(#knobval); val; );
function ui_hbar(id, x, y, w, h, val, mn, mx, def, fmt) local(hot, nv, tw, th, tx) (
  ui_chg = 0; hot = mouse_x >= x && mouse_x < x + w && mouse_y >= y - 3 && mouse_y <= y + h + 3;
  mouse_click && active_control == 0 && hot ? ( (mouse_cap & 4) ? ( val = def; ui_chg = 1; ) : ( active_control = id; ); );
  active_control == id ? ( nv = mn + max(0, min(1, (mouse_x - x) / w)) * (mx - mn); nv != val ? ( val = nv; ui_chg = 1; ); );
  gfx_set(0.24, 0.09, 0.11, 1); gfx_rect(x, y, w, h);
  gfx_set(0.95, 0.5, 0.25, 1); gfx_rect(x, y, w * max(0, min(1, (val - mn) / (mx - mn))), h);
  (hot || active_control == id) ? ( sprintf(#hbtip, fmt, val); gfx_setfont(1); gfx_measurestr(#hbtip, tw, th); tx = min(x, 746 - tw - 8); gfx_set(0.05, 0.02, 0.03, 0.95); gfx_rect(tx - 3, y - th - 8, tw + 8, th + 4); gfx_set(1, 1, 1, 1); gfx_x = tx; gfx_y = y - th - 6; gfx_drawstr(#hbtip); );
  val;
);
function ui_hbar_log(id, x, y, w, h, val, mn, mx, def, fmt) local(hot, nv, tw, th, tx, lmn, lrg) (
  ui_chg = 0; hot = mouse_x >= x && mouse_x < x + w && mouse_y >= y - 3 && mouse_y <= y + h + 3;
  mouse_click && active_control == 0 && hot ? ( (mouse_cap & 4) ? ( val = def; ui_chg = 1; ) : ( active_control = id; ); );
  lmn = log(mn); lrg = log(mx) - lmn; active_control == id ? ( nv = exp(lmn + max(0, min(1, (mouse_x - x) / w)) * lrg); nv != val ? ( val = nv; ui_chg = 1; ); );
  gfx_set(0.24, 0.09, 0.11, 1); gfx_rect(x, y, w, h);
  gfx_set(0.95, 0.5, 0.25, 1); gfx_rect(x, y, w * max(0, min(1, (log(max(val, mn)) - lmn) / lrg)), h);
  (hot || active_control == id) ? ( sprintf(#hbtip, fmt, val); gfx_setfont(1); gfx_measurestr(#hbtip, tw, th); tx = min(x, 746 - tw - 8); gfx_set(0.05, 0.02, 0.03, 0.95); gfx_rect(tx - 3, y - th - 8, tw + 8, th + 4); gfx_set(1, 1, 1, 1); gfx_x = tx; gfx_y = y - th - 6; gfx_drawstr(#hbtip); );
  val;
);
function ui_log_knob(id, cx, cy, r, val, mn, mx, label, fmt, def) local(log_mn, log_mx, log_rng, log_val, hot, d, norm, ang, ua, tw, th, act) ( ui_chg = 0; log_mn = log(mn); log_mx = log(mx); log_rng = max(log_mx - log_mn, 0.000001); log_val = log(max(val, mn)); hot = ui_en && abs(mouse_x - cx) <= r + 5 && abs(mouse_y - cy) <= r + 5; ui_en && mouse_click && active_control == 0 && hot ? ( (mouse_cap & 4) ? ( val = def; ui_chg = 1; ) : ( active_control = id; ); ); ui_en && active_control == id ? ( d = last_mouse_y - mouse_y; (mouse_cap & 8) ? d *= 0.2; d != 0 ? ( log_val = max(log_mn, min(log_mx, log_val + d * log_rng / 200)); val = exp(log_val); ui_chg = 1; ); ); ua = ui_en ? 1 : 0.4; act = (active_control == id); norm = max(0, min(1, (log_val - log_mn) / log_rng)); ang = 0.75 * $pi + norm * 1.5 * $pi; gfx_set(0.12, 0.04, 0.05, ua); gfx_circle(cx, cy, r - 2, 1); gfx_set(0.30, 0.12, 0.15, ua); gfx_circle(cx, cy, r - 2, 0); gfx_set(0.24, 0.09, 0.11, ua); ui_arc(cx, cy, r + 3, 0.75 * $pi, 2.25 * $pi); norm > 0.004 ? ( gfx_set(ui_ar, ui_ag, ui_ab, ua); ui_arc(cx, cy, r + 3, 0.75 * $pi, ang); ); gfx_set(1, 1, 1, ua * (act ? 1 : 0.9)); gfx_line(cx + cos(ang) * r * 0.3, cy + sin(ang) * r * 0.3, cx + cos(ang) * (r - 4), cy + sin(ang) * (r - 4)); gfx_setfont(1); gfx_set(0.85, 0.75, 0.78, ua); gfx_measurestr(label, tw, th); gfx_x = cx - tw * 0.5; gfx_y = cy - r - 18; gfx_drawstr(label); ui_ds_on ? strcpy(#knobval, #ui_ds) : sprintf(#knobval, fmt, val); ui_ds_on = 0; (act || hot) ? gfx_set(1, 1, 1, ua) : gfx_set(0.9, 0.82, 0.84, ua); gfx_measurestr(#knobval, tw, th); gfx_x = cx - tw * 0.5; gfx_y = cy + r + 7; gfx_drawstr(#knobval); val; );

// ===================== V3.11 : CHARGEMENT D'UN FICHIER AUDIO (envoye par le panel via gmem) =====================
// Le panel decode le fichier avec REAPER et depose les echantillons dans gmem :
//   gmem[LD_BASE+1] N (requete) | +2 id | +3 id repondu | +4 reference active | +5 longueur adaptee | +6 longueur reference | +7 capacite
//   gmem[LD_BASE+8] N final | +9 mode reference (1 = esclave du maitre actif) | +10 id termine
//   gmem[LD_BASE+16 ...] canal L | gmem[LD_BASE+16+LD_MAXN ...] canal R
// cmd 32 = requete de longueur ; cmd 31 = copie dans la boucle (par blocs) puis fin comme un REC, looper laisse a l'ARRET.
function ld_query() local(ms_off, locked, mid, is_self, ml, n) (
  ms_off = (active_part - 1) * 10; locked = gmem[ms_off]; mid = gmem[ms_off + 1];
  is_self = (locked == 1 && (mid == instance_id || mid == instance_alias));
  ml = (locked == 2) ? host_measure_len() : ((locked == 1 && !is_self && gmem[ms_off + 2] > 0) ? gmem[ms_off + 2] : 0);
  n = floor(gmem[LD_BASE + 1]);
  gmem[LD_BASE + 4] = ml > 0 ? 1 : 0;
  gmem[LD_BASE + 5] = ml > 0 ? floor(calc_sync_len(n, ml) + 0.5) : n;
  gmem[LD_BASE + 6] = ml;
  gmem[LD_BASE + 7] = min(single_buf_len, LD_MAXN);
  gmem[LD_BASE + 3] = gmem[LD_BASE + 2];
);
function ld_begin() local(n) (
  n = floor(gmem[LD_BASE + 8]); ld_ref = floor(gmem[LD_BASE + 9]);
  (n >= 1 && n <= min(single_buf_len, LD_MAXN)) ? (
    ld_qid = gmem[LD_BASE + 2];
    (length > 0 || state != 0) ? do_clear(0);                   // remplace une boucle existante
    state_target = 0; last_state_target = 0; state = 0;
    analysing = 0; one_shot_playing = 0; switch_history_slot(0); history_head = 0; history_count = 1; hist_undo = 0; hist_redo = 0; dirty_len = 0;
    pos = 0; master_pos = 0; clk_cyc = 0; length = 0; loop_start = 0; loop_width = 0;
    sy_clear(active_part - 1); rec_ref_kind = 0;
    ld_active = 1; ld_i = 0; ld_n = n; ld_part = active_part;
  );
);
function ld_finish() local(idx, mb, sp, locked) (
  idx = active_part - 1;
  pos = ld_n; rec_ref_kind = 0;
  finish_rec(0);                                                // longueur, historique, maitre automatique s'il n'y en a pas ; looper ARRETE
  ld_ref == 1 ? (
    locked = gmem[idx * 10];
    locked == 2 ? (
      part_sp[idx] = 0; part_sref[idx] = 9; part_sm[idx] = host_measure_len(); part_sep[idx] = gmem[914 + idx];
    ) : (
      mb = sy_master_blk(idx);
      (mb >= 0 && !sy_is_master(idx)) ? (
        part_sref[idx] = gmem[mb + 183] > 0 ? gmem[mb + 183] : gmem[idx * 10 + 1];
        sp = max(0, gmem[mb + 182]); part_sp[idx] = sp - length * floor(sp / length);
        part_sm[idx] = gmem[mb + 184] > 0 ? min(gmem[mb + 184], gmem[idx * 10 + 2]) : gmem[idx * 10 + 2];
      );
    );
  );
  gmem[LD_BASE + 10] = ld_qid; ld_active = 0;
);
function ld_step() local(n_i, k) (
  active_part != ld_part ? ( ld_active = 0; ) : (
    n_i = min(ld_n - ld_i, 32768); k = 0;
    loop(n_i,
      left_buf[ld_i + k] = gmem[LD_BASE + 16 + ld_i + k];
      right_buf[ld_i + k] = gmem[LD_BASE + 16 + LD_MAXN + ld_i + k];
      k += 1;
    );
    ld_i += n_i;
    ld_i >= ld_n ? ld_finish();
  );
);

@serialize
// Sauvegarde dediee de l'ID (entier). Au chargement projet, restaure
// slider45/manual_id meme si un re-init a reinitialise le slider.
file_var(0, saved_manual_id);
file_avail(0) >= 0 ? (
  // lecture projet
  saved_manual_id = floor(saved_manual_id + 0.5);
  saved_manual_id < 0 ? saved_manual_id = 0 : saved_manual_id > 8 ? saved_manual_id = 8;
  manual_id = saved_manual_id;
  slider45 = manual_id;
  instance_id = manual_id > 0 ? manual_id : 1;
  instance_alias = instance_id;
  inst_idx = instance_id - 1;
) : (
  // ecriture projet
  saved_manual_id = floor(manual_id + 0.5);
  saved_manual_id < 0 ? saved_manual_id = 0 : saved_manual_id > 8 ? saved_manual_id = 8;
);

@block
smp_ev_n = 0; smp_ev_i = 0;
qs_b0 = beat_position; qs_i = 0;
rp_check();   // V3.12 : re-phasage Host
// V3.6.10: Cloud et Slicer exclusifs. Le dernier active gagne.
(play_mode == 1 && cloud_on) ? ( cloud_on != prev_xcl ? ( play_mode = 0; slider6 = 0; ) : ( cloud_on = 0; slider23 = 0; ); );
prev_xcl = cloud_on;

// ---- SLICER CLOCK : suivi de la position du looper master ----
blk_ms = (active_part - 1) * 10;
// V3.10 : le suivi du maitre (mclk_pos) tourne toujours (reference du sync point) ; mclk_on = suivi + Slicer Clock = Master
mclk_trk = (gmem[blk_ms] == 1 && gmem[blk_ms + 1] != instance_id && gmem[blk_ms + 1] != instance_alias && gmem[blk_ms + 2] > 0);
mclk_on = (clk_src == 0 && mclk_trk);
// V3.10 : source du "moment commun" pour le mode exclusif
xarm != 0 && x_part != active_part ? xarm = 0;
xarm != 0 ? x_select_mode();
ld_active ? ld_step();
mclk_trk ? (
  mclk_len = gmem[blk_ms + 2]; mclk_m = gmem[blk_ms + 3];
  (!mclk_valid || mclk_len != mclk_len_prev) ? (
    mclk_pos = mclk_m; mclk_cyc = gmem[blk_ms + 4] % 840; mclk_valid = 1; mclk_len_prev = mclk_len; mclk_on ? last_slicer_step = -1;
  ) : (
    mclk_d = mclk_m - mclk_pos; mclk_d -= mclk_len * floor(mclk_d / mclk_len + 0.5);
    mclk_np = mclk_pos + (abs(mclk_d) > 4096 ? mclk_d : mclk_d * 0.1);
    mclk_np >= mclk_len ? ( mclk_np -= mclk_len; mclk_cyc = (mclk_cyc + 1) % 840; ) : ( mclk_np < 0 ? ( mclk_np += mclk_len; mclk_cyc = (mclk_cyc + 839) % 840; ); );
    mclk_pos = mclk_np;
  );
) : ( mclk_valid = 0; );
while (midirecv(mo_off, mo_m1, mo_m2, mo_m3)) (
  midisend(mo_off, mo_m1, mo_m2, mo_m3);
  mo_t = mo_m1 & 240;
  (mo_t == 144 && mo_m3 > 0) ? (
    smp_ev_n < smp_evmax ? ( smp_ev_off[smp_ev_n] = mo_off; smp_ev_note[smp_ev_n] = mo_m2; smp_ev_vel[smp_ev_n] = mo_m3; smp_ev_n += 1; );
  ) : ((mo_t == 128 || mo_t == 144) ? (
    smp_ev_n < smp_evmax ? ( smp_ev_off[smp_ev_n] = mo_off; smp_ev_note[smp_ev_n] = mo_m2; smp_ev_vel[smp_ev_n] = 0; smp_ev_n += 1; );
  ) : (
    (mo_t == 176 && (mo_m2 == 123 || mo_m2 == 120)) ? smp_alloff = 1;
  ));
);

(slicer_src != last_slicer_src || grid_sub != last_grid_sub) ? ( last_slicer_src = slicer_src; last_grid_sub = grid_sub; grid_sig = -1; length > 0 ? start_analysis_ex(1); );
slicer_pitch_spread != last_pitch_spread ? ( last_pitch_spread = slicer_pitch_spread; update_slicer_pitches(get_slicer_len()); );
(slicer_src == 1 && length > 0 && !analysing && grid_signature() != grid_sig) ? (
  br_suppress_an ? grid_sig = grid_signature() : start_analysis_ex(1);
);
slicer_link != last_link ? ( last_link = slicer_link; last_slicer_step = -1; (slicer_src == 1 && length > 0) ? ( grid_sig = -1; start_analysis_ex(1); ); );
grid_pending ? ( generate_slicer_sequence(get_slicer_len()); slicer_current_step = 0; grid_pending = 0; );
// ---- STEPS libres + PRESETS de table + MAX SLICES ----
slicer_steps != last_steps ? (
  slicer_mode == 1 ? slicer_resize(floor(last_steps + 0.5), floor(slicer_steps + 0.5));
  last_steps = slicer_steps;
  (ana_mode == 1 && max_slices < 1 && slicer_src == 0 && length > 0) ? start_analysis_ex(1);
);
preset_cur < 0 ? (
  preset_cur = max(0, min(3, floor(slicer_preset + 0.5) - 1)); last_preset = slicer_preset;
) : (
  slicer_preset != last_preset ? ( last_preset = slicer_preset; preset_switch(max(0, min(3, floor(slicer_preset + 0.5) - 1))); );
);
(max_slices != last_max_sl && active_control != 48) ? ( last_max_sl = max_slices; length > 0 ? start_analysis_ex(1); );   // V3.16 : garde les slices actuelles pendant le re-scan (pas de coupure)
// V3.8 : re-analyse automatique a chaque overdub : a chaque tour de boucle pendant Dub/Replace/Auto-Rep
// (une fois le commit du dub termine), a la sortie du dub, et apres undo / redo.
(an_prev_state >= 3 && an_prev_state <= 6 && (state < 3 || state > 6) && state != 8) ? an_exit_pending = 1;
an_prev_state = state;
an_prev_hist != active_history_idx ? ( (state < 3 || state > 6) ? an_exit_pending = 1; an_prev_hist = active_history_idx; );
(an_exit_pending && !cm_active && state != 8) ? (
  an_exit_pending = 0; an_wrap_pending = 0;
  length > 0 ? start_analysis_ex(1);
);
(an_wrap_pending && !cm_active && !analysing) ? (
  an_wrap_pending = 0;
  (length > 0 && state >= 3 && state <= 6 && (play_mode == 1 || smp_mode > 0)) ? start_analysis_ex(1);
);
// V3.9 : fenetre de boucle (loop_start / loop_width) ou longueur modifiee -> re-analyse une fois la valeur stabilisee (250 ms)
// Beat Repeat : engagé/relâché ne doit PAS rescanner les slices (captures rapprochées)
an_win_sig = floor(loop_start) * 3 + floor(loop_width) * 7 + length * 13;
an_win_sig != an_win_last ? (
  an_win_last = an_win_sig;
  br_suppress_an ? (
    br_suppress_an = 0; an_win_pend = 0;
    // absorbe aussi un rebuild grille purement du a la fenetre BR
    (slicer_src == 1) ? grid_sig = grid_signature();
  ) : (
    an_win_t = time_precise() + 0.25; an_win_pend = 1;
  );
);
(an_win_pend && time_precise() >= an_win_t && !cm_active && state != 8) ? (
  an_win_pend = 0;
  (length > 0 && !(slicer_src == 1 && !src_auto)) ? start_analysis_ex(1);
);
det_chg ? ( det_chg = 0; (length > 0 && !analysing && !cm_active && state != 8 && !(slicer_src == 1 && !src_auto)) ? start_analysis_ex(1); );
analysing == 1 ? (
  // V3.13 : detection legere. Par echantillon : 2 suiveurs d'enveloppe seulement (rapide / fond), pas de FFT, pas de log.
  ana_budget = max(1024, floor(samplesblock * 8));
  i = 0; odf_ls = floor(loop_start); odf_lw = max(1, floor(loop_width));
  while (i < ana_budget && ana_k < ana_end) (
    odf_ix = ana_k < odf_ls ? odf_ls + (((ana_k - odf_ls) % odf_lw) + odf_lw) % odf_lw : ana_k;
    dv_a = max(abs(left_buf[odf_ix]), abs(right_buf[odf_ix]));
    dv_f = max(dv_a, dv_f * dv_rf);
    dv_s += (dv_a - dv_s) * dv_cs;
    dv_hold > 0 ? dv_hold -= 1;
    dv_trk > 0 ? ( dv_trk -= 1; dv_a > cand_s[cand_n - 1] ? cand_s[cand_n - 1] = dv_a; );
    (ana_k >= odf_ls && dv_hold <= 0 && dv_f >= det_thresh && dv_f > dv_s * 2.5 && cand_n < cand_max) ? (
      cand_k[cand_n] = ana_k; cand_s[cand_n] = dv_a; cand_ok[cand_n] = 1; cand_n += 1;
      dv_hold = srate * det_hold_ms * 0.001; dv_trk = dv_trkn;
    );
    dv_a > ana_max_peak ? ana_max_peak = dv_a;
    ana_k += 1; i += 1;
  );
  ana_k >= ana_end ? (
    // V3.14 : filtre relatif - ecarte les candidats sous det_rel x pic de la boucle (bruit de fond, queues)
    dv_j = 0; dv_m = 0; dv_lim = det_rel * ana_max_peak;
    loop(cand_n,
      cand_s[dv_j] >= dv_lim ? ( cand_k[dv_m] = cand_k[dv_j]; cand_s[dv_m] = cand_s[dv_j]; cand_ok[dv_m] = 1; dv_m += 1; );
      dv_j += 1;
    );
    cand_n = dv_m;
    an_ns = cand_n; an_nr = cand_n; an_ne = cand_n;
    an_N = (slicer_src == 0 || src_auto) ? min(det_cap, floor(max_slices + 0.5)) : 0;
    an_wasg = (slicer_src == 1);
    sel_n = 0; ana_mode = 0;
    (det_strict ? an_ne < 1 : (an_ne < 2 || (an_N >= 1 && an_ne < 0.12 * an_N))) ? (
      det_strict ? (
        src_auto && an_wasg ? ( slicer_src = 0; slider31 = 0; last_slicer_src = 0; );
        an_keep ? ( analysing = 0; ) : ( an_keep = 0; an_commit(); );   // V3.17 : rien de detecte pendant un re-scan -> on garde les slices actuels (jamais de coupure)
      ) : src_auto ? (
        an_osub = grid_sub;
        an_N >= 1 ? grid_pick(an_N);
        slicer_src = 1; slider31 = 1; last_slicer_src = 1; last_grid_sub = grid_sub; slider32 = grid_sub;
        (!an_wasg || grid_sub != an_osub || grid_signature() != grid_sig) ? grid_build() : (analysing = 0);
        ana_mode = 2; an_keep = 0;
      ) : (
        an_fractions(an_N >= 1 ? an_N : max(2, floor(slicer_steps + 0.5)));
        an_commit();
      );
    ) : (
      src_auto && an_wasg ? ( slicer_src = 0; slider31 = 0; last_slicer_src = 0; an_keep = 0; );
      an_dmin = 1; an_done = 0;
      analysing = 3;
    );
  );
) : analysing == 3 ? (
  an_target = an_N >= 1 ? min(an_N, max_transients) : min(det_cap, max_transients);
  an_r = 0;
  while (an_r < 2 && !an_done) (
    sel_n >= an_target ? an_done = 1 : (
      an_bj = -1; an_bs = -1000000; an_j = 0;
      while (an_j < cand_n) ( (cand_ok[an_j] && cand_s[an_j] > an_bs) ? ( an_bs = cand_s[an_j]; an_bj = an_j; ); an_j += 1; );
      an_bj < 0 ? an_done = 1 : (
        an_kk = cand_k[an_bj];
        sel_k[sel_n] = odf_refine(an_kk - floor(srate * 0.001));
        sel_s[sel_n] = min(1, cand_s[an_bj] / ana_max_peak);
        sel_n += 1;
        an_j = an_bj; while (an_j >= 0 && an_kk - cand_k[an_j] < an_dmin) ( cand_ok[an_j] = 0; an_j -= 1; );
        an_j = an_bj + 1; while (an_j < cand_n && cand_k[an_j] - an_kk < an_dmin) ( cand_ok[an_j] = 0; an_j += 1; );
      );
    );
    an_r += 1;
  );
  an_done ? ( an_sortfill(); an_commit(); );
);
// MAJ DE L'ID (slider manuel) — entier stable 0..8
manual_id = floor(manual_id + 0.5);
manual_id < 0 ? manual_id = 0 : manual_id > 8 ? manual_id = 8;
// Si le slider a ete remis a 0 par un glitch de restore mais saved_manual_id est valide
(manual_id == 0 && saved_manual_id > 0 && saved_manual_id <= 8) ? (
  manual_id = saved_manual_id; slider45 = manual_id;
);
saved_manual_id = manual_id;
instance_id = manual_id > 0 ? manual_id : 1;
instance_alias = instance_id;
inst_idx = instance_id - 1;

gmem[100 + inst_idx] = instance_id;
gmem[130 + inst_idx] = time_precise();
gmem[160 + inst_idx] = looper_hue;

// Invalidate old parameter snapshots first. Only the currently active
// Song Part is republished below; this guarantees a blank/clean display
// during startup and immediately after changing Song Part.
param_clear_i = 0;
loop(3,
  param_clear_base = 110000 + ((inst_idx * 3) + param_clear_i) * 60;
  gmem[param_clear_base + 59] = 0;
  param_clear_i += 1;
);

p = 0;
loop(3,
  gmem_base = 1000 + (inst_idx * 600) + p * 200;
  
  cmd = gmem[gmem_base + 48];
  cmd > 0 ? (
    // Remote transport / mode commands (Launchpad / Virtual Launchpad)
    // +48 = cmd, +49 = optional numeric arg (speed/pitch step, etc.)
    cmd_arg = gmem[gmem_base + 49];
    // cmd 12 = switch de part quantize (comme les boutons Main/Chorus/Bridge de l'UI) :
    //   length > 0 -> pending jusqu'a fin de cycle ; sinon switch immediat.
    //   re-tap sur la part active / cible = annule le pending.
    cmd == 12 ? (
      req_part = p + 1;
      req_part == active_part ? (
        pending_part_switch = 0;
      ) : (
        pending_part_switch && target_part == req_part ? (
          pending_part_switch = 0; // re-tap = annule
        ) : (
          length > 0 ? ( target_part = req_part; pending_part_switch = 1; ) : switch_part(req_part);
        );
      );
    ) : (
      // autres commandes : bascule d'abord sur la part du slot si besoin
      p != (active_part - 1) ? switch_part(p + 1);
      cmd == 1 ? ( length > 0 && state != 1 && state != 8 ? state_target = (state == 3 ? 2 : 3) : rec_cmd = 1; ) :
      cmd == 2 ? ( do_clear(0); state_target = 0; ) :
      cmd == 3 ? ( state_target = (state == 0 || state == 7) ? 2 : 0; ) :
      cmd == 4 ? ( rev_on = !rev_on; slider16 = rev_on; ) :
      cmd == 5 ? ( pingpong_on = !pingpong_on; slider17 = pingpong_on; ) :
      cmd == 6 ? ( play_mode = (play_mode == 1 ? 0 : 1); slider6 = play_mode; play_mode == 1 ? ( cloud_on = 0; slider23 = 0; ); ) :
      cmd == 7 ? ( cloud_on = !cloud_on; slider23 = cloud_on; cloud_on && play_mode == 1 ? ( play_mode = 0; slider6 = 0; ); ) :
      cmd == 8 ? ( link_on = !link_on; slider7 = link_on; ) :
      cmd == 9 ? ( state_target = (state == 4 ? 2 : 4); ) :
      cmd == 10 ? ( state_target = (state == 5 ? 2 : 5); ) :
      cmd == 11 ? ( do_clear(1); state_target = 0; ) :
      cmd == 13 ? ( state_target = (state == 6 ? 2 : 6); ) : // Multiply
    cmd == 14 ? undo_state() :
    cmd == 15 ? redo_state() :
    cmd == 16 ? trigger_restart() :
    cmd == 17 ? ( do_clear(0); state_target = 1; ) : // Re-Rec
    cmd == 18 ? ( // One-Shot toggle
      play_mode = (play_mode == 2 ? 0 : 2); slider6 = play_mode;
      play_mode == 2 ? ( cloud_on = 0; slider23 = 0; );
    ) :
    cmd == 19 ? ( auto_on = !auto_on; ) :
    cmd == 20 ? ( // relative speed step: arg in semitones-ish ratio factors via 2^(st/12)
      st = cmd_arg;
      abs(st) < 0.0001 ? st = 12;
      speed = max(0.01, min(100, speed * (2 ^ (st / 12)))); slider1 = speed;
    ) :
    cmd == 21 ? ( // relative pitch step in semitones
      st = cmd_arg;
      abs(st) < 0.0001 ? st = 12;
      pitch = max(-48, min(48, pitch + st)); slider2 = pitch;
    ) :
    cmd == 22 ? ( // Full Loop
      length > 0 ? ( loop_start = 0; loop_width = length; sync_hard_resync = 1; );
    ) :
    cmd == 23 ? ( // Quantise In/Out cycle
      loop_quant = (loop_quant >= 9 ? 0 : loop_quant + 1); slider24 = loop_quant;
      br_on ? br_refresh() : (
        length > 0 ? ( loop_start = apply_quant_start(loop_start); loop_width = apply_quant_width(loop_width, loop_start); sync_hard_resync = 1; );
      );
    ) :
    cmd == 24 ? reset_all_params() :
    cmd == 25 ? x_arm(1) :
    cmd == 26 ? x_arm(2) :
    cmd == 27 ? x_arm(0) :
    cmd == 28 ? x_adopt(cmd_arg) :
    cmd == 29 ? x_arm(3) :
    cmd == 31 ? ld_begin() :
    cmd == 32 ? ld_query() :
    cmd == 33 ? do_beat_repeat(!br_on) :
    cmd == 30 ? ( x_free = (cmd_arg > 0); x_arm(4); ) :
    0;
    );
    gmem[gmem_base + 48] = 0;
    gmem[gmem_base + 49] = 0;
  );

  // Dashboard Twister In/Out/Width:
  // 160=1 +161=in  -> set In, keep Out fixed (mode Out)
  // 160=5 +161=in  -> set In, keep Width fixed (mode Width) ; shrink width if hits end
  // 160=2 +162=out -> set Out absolute
  // 160=3 +162=w   -> set Width
  // 160=4          -> reset full loop
  edit_cmd = gmem[gmem_base + 160];
  edit_cmd > 0 ? (
    p != (active_part - 1) ? switch_part(p + 1);
    length > 0 ? (
      br_on && edit_cmd == 1 ? edit_cmd = 5;   // BR : la fraction (écart) ne change pas quand In bouge
      br_on && (edit_cmd == 2 || edit_cmd == 3) ? (
        // BR : Out / Width = choix de la fraction
        br_set_width(edit_cmd == 2 ? gmem[gmem_base + 162] - loop_start : gmem[gmem_base + 162]);
      ) :
      edit_cmd == 1 ? (
        // Mode Out: move In, preserve end
        new_in = gmem[gmem_base + 161];
        new_in = apply_quant_start(max(0, min(new_in, length - min_width())));
        old_end = loop_start + loop_width;
        loop_start = new_in;
        loop_width = max(min_width(), old_end - loop_start);
        loop_width = min(loop_width, length - loop_start);
        sync_hard_resync = 1;
      ) :
      edit_cmd == 5 ? (
        // Mode Width: move In, preserve width (shrink only if right edge hits length)
        new_in = gmem[gmem_base + 161];
        keep_w = max(min_width(), loop_width);
        new_in = apply_quant_start(max(0, min(new_in, length - min_width())));
        new_in = max(0, min(new_in, length - keep_w));   // borne In (la largeur ne change JAMAIS)
        loop_start = new_in;
        loop_width = keep_w;
        sync_hard_resync = 1;
      ) :
      
      edit_cmd == 2 ? (
        new_out = gmem[gmem_base + 162];
        gq = quant_grid();
        gq > 0 ? new_out = floor(new_out / gq + 0.5) * gq;
        new_out = max(loop_start + min_width(), min(new_out, length));
        loop_width = new_out - loop_start;
        sync_hard_resync = 1;
      ) :
      edit_cmd == 3 ? (
        new_w = gmem[gmem_base + 162];
        loop_width = apply_quant_width(new_w, loop_start);
        sync_hard_resync = 1;
      ) :
      edit_cmd == 4 ? (
        loop_start = 0;
        loop_width = length;
        sync_hard_resync = 1;
      );
    );
    gmem[gmem_base + 160] = 0;
    gmem[gmem_base + 161] = 0;
    gmem[gmem_base + 162] = 0;
  );

  // Remote param write (ReaImGui / external): +180 = param id, +181 = value
