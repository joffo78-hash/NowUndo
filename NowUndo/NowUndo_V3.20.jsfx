dens_seg = 0; dens_T = 0; dens_Ton = 0; dens_next_on = 1; dens_first = 1; dens_minlen = max(16, floor(srate * 0.03));
// ===== V3.20 : AUTO-REPLACE par comparaison de niveau entree / boucle =====
ar_in = 0; ar_lp = 0; ar_cnt = 0; rp_tail_on = 0; ar_att = 1 - exp(-1 / (srate * 0.0005)); ar_rel = 1 - exp(-1 / (srate * 0.04));
ar_hold = floor(srate * 0.03); ar_up = 1.0 / (srate * 0.003); ar_dn = 1.0 / (srate * 0.025);
slice_env = 1.0; slice_decay_samples = srate * 0.15; slice_decay_step = 1.0 / slice_decay_samples; slice_att = 1.0; slice_att_step = 0; slice_att_eff_ms = 0;
replace_fade = 0; replace_fade_coeff = 1.0 / (srate * 0.02); state_transition_fade = 1.0;
prev_in0 = 0; prev_in1 = 0; grain_mix = 0; xfade_coeff = 1.0 / (srate * 0.01); init_done = 0;
tape_lpf_l = 0; tape_lpf_r = 0; tape_lpf_l_b = 0; tape_lpf_r_b = 0; tape_lpf_l_c = 0; tape_lpf_r_c = 0; tape_lpf_l_d = 0; tape_lpf_r_d = 0;
slice_pan = 0; dub_pan = 0; last_slider9 = loop_pos_pct; last_sens = trans_sens; last_hold = trans_hold_ms; last_det_t = det_thresh; last_det_h = det_hold_ms;
last_slicer_mode = slicer_mode; last_grid_sub = grid_sub; last_pitch_spread = slicer_pitch_spread;
last_slicer_src = -1;
slicer_sample_counter = 0; slicer_current_step = 0; auto_rep_hold_counter = 0; auto_rep_active = 0; input_env = 0; ping_pong_dir = 1;  last_slicer_step = -1;
one_shot_playing = 0; one_shot_pp_state = 0;
analysing = 0; ana_k = 0; ana_end = 0; ana_max_peak = 0.0001; ana_min_dist = 0; ana_win_size = 0; ana_env = 0; ana_last_trig = 0;
ui_en = 1; ui_chg = 0; ui_hov = 0; ui_ar = 1; ui_ag = 1; ui_ab = 1; last_mouse_cap = 0; last_mouse_y = 0;
auto_on = 0; clr_press_time = 0; clr_long_pressed = 0; input_signal_active = 0; hold_samples_left = 0;
cloud_on = 0; cloud_density = 0.5; cloud_chaos = 0.0; cloud_spread = 0.1; cloud_pitch_spread = 0.0; cloud_mix = 1.0; cloud_pos_mode = 1; cloud_pos_pct = 50.0; cloud_lfo_shape = 0; cloud_lfo_rate = 1.0; cloud_lfo_depth = 0.0; loop_quant = 0;
grid_pending = 0; grid_sig = -1; last_link = slicer_link; an_win_last = -1; an_win_pend = 0; an_win_t = 0;
peak_in_vu = 0; peak_loop_vu = 0; peak_out_vu = 0; vu_rel = exp(-1.0 / (srate * 0.4));

prev_sm_speed = -1; prev_loop_start = -1; prev_loop_width = -1;
prev_pitch_ratio_sig = -1; prev_pingpong_on = 0;
prev_play_mode = -1; prev_state_for_sync = -1;
sync_hard_resync = 0;
loop_edit_mode = 0; io_w_lock = 0; io_e_lock = 0;
br_on = 0; br_saved_start = 0; br_saved_width = 0; br_mix_s = br_mix; slx_mix_s = slx_mix; slx_pos = 0; slx_prev = 0; br_bg_pos = 0; br_bg_s = 0; br_bg_e = 0; last_loop_quant = -1; br_suppress_an = 0;
rec_start_time = 0;

function slicer_beats() ( slicer_sub == 0 ? 1.0 : (slicer_sub == 1 ? 0.5 : (slicer_sub == 2 ? 1.0/3.0 : (slicer_sub == 3 ? 0.25 : (slicer_sub == 4 ? 1.0/6.0 : 0.125)))); );
function grid_beats() ( grid_sub == 0 ? 1.0 : (grid_sub == 1 ? 0.5 : (grid_sub == 2 ? 1.0/3.0 : (grid_sub == 3 ? 0.25 : (grid_sub == 4 ? 1.0/6.0 : (grid_sub == 5 ? 0.125 : (grid_sub == 6 ? 1.0/12.0 : (grid_sub == 7 ? 0.0625 : (grid_sub == 8 ? 1.0/24.0 : 0.03125)))))))); );
// V3.9 : nombre de divisions de la boucle pour la subdivision Grid (1/4 -> 4 ... 1/128 -> 128)
function grid_div() ( max(1, floor(4.0 / grid_beats() + 0.5)); );
// Link actif = option On + source Grid effective + boucle existante
function sl_linked() ( slicer_link >= 0.5 && slicer_src == 1 && length > 0; );
function grid_pick(n) local(s, c, bs, bd, d) (
  bd = 1000000000; bs = grid_sub; s = 0;
  loop(10,
    grid_sub = s;
    c = min(max_transients, loop_width / max(srate * 0.005, loop_beat_len() * grid_beats()));
    d = abs(log(max(1, c) / n));
    d < bd ? ( bd = d; bs = s; );
    s += 1;
  );
  grid_sub = bs;
);
function grid_signature() ( length + loop_start * 3 + loop_width * 7 + loop_beat_len() * 13 + grid_sub * 101 + loop_beats * 1009 + (slicer_link >= 0.5 ? 10007 : 0); );
function grid_build() local(st, e) (
  // toujours relatif au temps (1/16 = double-croche), jamais longueur_boucle/N
  st = max(srate * 0.005, loop_beat_len() * grid_beats()); e = loop_start + loop_width - 1; trans_count = 0;
  while (trans_count < max_transients && loop_start + trans_count * st < e) ( trans_mem[trans_count] = loop_start + trans_count * st; trans_count += 1; );
  analysing = 0; grid_pending = 1; grid_sig = grid_signature();
);
function odf_refine(p) local(a, pk, j, k, q, z) (
  p = floor(max(loop_start, p));
  pk = 0; j = 0;
  loop(odf_hop * 4,
    k = p + j;
    k < length ? (
      a = abs(left_buf[k]) + abs(right_buf[k]);
      a > pk ? pk = a;
    );
    j += 1;
  );
  q = -1; j = 0;
  while (q < 0 && j < odf_hop * 3) (
    k = p + j;
    (k < length && (abs(left_buf[k]) + abs(right_buf[k])) > pk * 0.15) ? q = k;
    j += 1;
  );
  q < 0 ? q = p;
  q = max(floor(loop_start) + 2, q - floor(srate * 0.0005));
  z = q; j = 0;
  while (j < floor(srate * 0.001) && q - j > floor(loop_start) + 1) (
    ((left_buf[q - j] + right_buf[q - j]) * (left_buf[q - j - 1] + right_buf[q - j - 1])) <= 0 ? (
      z = q - j; j = 100000;
    ) : j += 1;
  );
  z;
);
function start_analysis_ex(keep) local(j) (
  length > 0 ? (
    (slicer_src == 1 && !src_auto) ? grid_build() : (
      !keep ? trans_count = 0;
      an_keep = keep;
      ana_k = floor(loop_start) - odf_hop * 40; ana_end = floor(loop_start + loop_width);
      cand_n = 0; dv_f = 0; dv_s = 0; dv_hold = 0; dv_trk = 0; ana_max_peak = 0.0001;   // V3.13 : detecteur leger
      analysing = 1;
    );
  );
);
function start_analysis() ( start_analysis_ex(0); );
function switch_history_slot(idx) (
  active_history_idx = idx;
  idx == 0 ? ( left_buf = active_part == 1 ? buf_part1_l : (active_part == 2 ? buf_part2_l : buf_part3_l); right_buf = active_part == 1 ? buf_part1_r : (active_part == 2 ? buf_part2_r : buf_part3_r);
  ) : ( left_buf = hist_mem_start + (idx - 1) * slot_size; right_buf = left_buf + single_buf_len; );
);
function transparent_soft_clip(x) local(ax, excess) ( ax = abs(x); ax > 0.95 ? ( excess = ax - 0.95; (x > 0 ? 1 : -1) * (0.95 + 0.05 * (excess / (0.05 + excess))); ) : ( x; ); );
function wg_splat(a, b, env, sb) local(lo, hi, span, k, k_end, steps, seg_a, seg_b, wgt, tn, vL, vR, kk, w_, mono, yr_b, w_b) (
  lo = min(a, b); hi = max(a, b); span = max(hi - lo, 0.0001); k = floor(lo); k_end = floor(hi); steps = min(k_end - k + 1, 24); yr_b = sb + acc_len; w_b = sb + acc_len * 2;
  loop(steps,
    seg_a = max(lo, k); seg_b = min(hi, k + 1); wgt = seg_b - seg_a;
    wgt > 0 ? (
      tn = ((seg_a + seg_b) * 0.5 - lo) / span; a > b ? tn = 1.0 - tn;
      vL = wg_p0 + (wg_c0 - wg_p0) * tn; vR = wg_p1 + (wg_c1 - wg_p1) * tn;
      stereo_width > 0.0001 ? ( mono = (vL + vR) * 0.5; vL = mono * wg_gL; vR = mono * wg_gR; );
      kk = k - wg_es; kk -= floor(kk / wg_el) * wg_el; kk += wg_es;
      kk >= 0 && kk < (length > 0 ? length : buf_len) ? (
        w_ = env * wgt * wg_rf; sb[kk] += vL * w_; yr_b[kk] += vR * w_; w_b[kk] += w_;
        kk < acc_lo ? acc_lo = kk; kk > acc_hi ? acc_hi = kk;
      );
    ); k += 1;
  );
);
// V3.6.10 WSOLA : cherche le decalage source (-Sn..+Sn) dont le debut de grain colle le mieux a la suite du grain precedent.
function wg_pick(s_nom, t0, Sn, Wn) local(best, bestd, dd, k, c, num, en, sc, stp) (
  stp = (Sn * Wn > 40000) ? 2 : 1; best = -1000000000; bestd = 0; dd = -Sn;
  while (dd <= Sn) (
    num = 0; en = 0.000000001; k = 0;
    while (k < Wn) (
      c = ih_l[(s_nom + dd + k) & ih_mask] + ih_r[(s_nom + dd + k) & ih_mask];
      num += c * (ih_l[(t0 + k) & ih_mask] + ih_r[(t0 + k) & ih_mask]);
      en += c * c; k += stp;
    );
    sc = num / sqrt(en); sc > best ? ( best = sc; bestd = dd; );
    dd += stp;
  );
  bestd;
);
function ih_wrap() local(gi, gb) ( ih_n -= 1073741824; wg_prev_src -= 1073741824; wg_prev_n -= 1073741824; gi = 0; loop(max_wgrains, gb = wg_mem + gi * wg_stride; gb[3] -= 1073741824; gi += 1; ); );
// V3.6.10 WSOLA LECTURE : le debut de chaque grain de lecture est decale (-Sn..+Sn) pour coller a la suite du grain precedent.
function rd_tp(x) local(k) ( k = floor(x); k -= floor((k - floor(eff_start)) / max(floor(eff_end) - floor(eff_start), 1)) * max(floor(eff_end) - floor(eff_start), 1); k = max(floor(eff_start), min(floor(eff_end) - 1, k)); left_buf[k] + right_buf[k]; );
function rd_score(p, stp, n) local(i, num, en, c) ( num = 0; en = 0.000000001; i = 0; while (i < n) ( c = rd_tp(p + stp * i * 4); num += c * rd_tmp[i]; en += c * c; i += 1; ); num / sqrt(en); );
function rd_pick(p0, ts, ph_prev, Sn, Wn, rr, dir) local(k, n, dd, best, bestd, sc, st, en_) (
  n = 0; k = 0; while (k < Wn) ( rd_tmp[n] = rd_tp(ts + dir * rr * (ph_prev + k)); n += 1; k += 4; );
  best = -1000000000; bestd = 0; dd = -Sn;
  while (dd <= Sn) ( sc = rd_score(p0 + dd, dir * rr, n); sc > best ? ( best = sc; bestd = dd; ); dd += 4; );
  st = bestd; dd = st - 3;
  while (dd <= st + 3) ( dd >= -Sn && dd <= Sn ? ( sc = rd_score(p0 + dd, dir * rr, n); sc > best ? ( best = sc; bestd = dd; ); ); dd += 1; );
  bestd;
);
function dub_grain_tick(head, rev, spawn_ok) local(dur, hop_t, d, gi, gb, fslot, ph0, ph1, pn, e, a, b, sb, pa, rr, max_l, Sn, Wn, Ln, dl, s_nom, t0, ot, src, si, ip, ic) (
  dur = srate * dub_grain_ms * 0.001; rr = pitch_ratio; d = rev ? -1 : 1;
  hop_t = max(wg_hop * dur * rr / max(sm_speed, 0.0001), dur / (max_wgrains - 1)); max_l = length > 0 ? length : buf_len;
  wg_es = floor(eff_start); wg_el = max(floor(eff_end) - wg_es, 16); sb = acc_cur ? acc_set1 : acc_set0; acc_mode = (state == 3) ? 1 : 2; wg_rf = (state == 3) ? 1.0 : replace_fade; wg_rf *= dens_g * sl_gate;
  wg_fade = max(0.01, min(0.5, grain_fade * 0.01));
 stereo_width > 0.0001 ? ( 
  pa = (dub_pan * stereo_width + 1.0) * 0.25 * $pi; 
  wg_gL = cos(pa) * 1.414; 
  wg_gR = sin(pa) * 1.414; 
) : ( 
  wg_gL = 1.0; 
  wg_gR = 1.0; 
);
  wg_timer += 1; wg_timer >= hop_t ? ( wg_timer = 0; spawn_ok ? ( gi = 0; fslot = -1; loop(max_wgrains, gb = wg_mem + gi * wg_stride; fslot < 0 && gb[2] == 0 ? fslot = gi; gi += 1; ); fslot >= 0 ? ( 
    Sn = floor(dub_align_ms * 0.001 * srate + 0.5); Wn = min(512, floor(0.4 * dur)); Ln = 0; dl = 0;
    (Sn > 0 && Wn >= 64) ? (
      Ln = Sn + Wn; s_nom = ih_n - Ln;
      wg_prev_ok ? ( ot = floor(sm_speed * (ih_n - wg_prev_n) / max(rr, 0.0001) + 0.5); t0 = wg_prev_src + ot; (ot > 0 && ot < dur - Wn && t0 + Wn <= ih_n) ? dl = wg_pick(s_nom, t0, Sn, Wn); );
    ) : ( Sn = 0; s_nom = ih_n; );
    src = s_nom + dl; wg_prev_src = src; wg_prev_n = ih_n; wg_prev_ok = 1; wg_Lcur = Ln;
    gb = wg_mem + fslot * wg_stride; gb[0] = head - d * sm_speed * Ln; gb[1] = 0; gb[2] = 1; gb[3] = src; ); ); );
  gi = 0; loop(max_wgrains, gb = wg_mem + gi * wg_stride; gb[2] == 1 ? ( ph0 = gb[1]; ph1 = ph0 + 1; pn = (ph0 + 0.5) / dur; e = 1.0; pn < wg_fade ? e = pn / wg_fade : (pn > 1.0 - wg_fade ? e = (1.0 - pn) / wg_fade); e = max(0, min(1, e)); e = 0.5 - 0.5 * cos(e * $pi); a = gb[0] + d * rr * ph0; b = gb[0] + d * rr * ph1; si = gb[3] + ph0; ip = (si - 1) & ih_mask; ic = si & ih_mask; wg_p0 = ih_l[ip]; wg_c0 = ih_l[ic]; wg_p1 = ih_r[ip]; wg_c1 = ih_r[ic]; wg_splat(a, b, e, sb); gb[1] = ph1; ph1 >= dur ? gb[2] = 0; ); gi += 1; );
  acc_cur_dirty = 1;
);
function dub_merge_cell(k, sb) local(wv, c, dubL, dubR, oldL, oldR, fb, targetL, targetR, deg, deg_amt, cutoff, lpf_alpha, yl_b, yr_b, w_b, drive, souffle) (
  w_b = sb + acc_len * 2; wv = w_b[k];
  wv > 0.000001 ? (
    yl_b = sb; yr_b = sb + acc_len; dubL = yl_b[k] / wv; dubR = yr_b[k] / wv; yl_b[k] = 0; yr_b[k] = 0; w_b[k] = 0; oldL = left_buf[k]; oldR = right_buf[k];
    cm_mode == 2 ? ( c = min(1.0, wv / acc_wrep); targetL = oldL * (1.0 - c) + dubL * c; targetR = oldR * (1.0 - c) + dubR * c; ) : ( c = min(1.0, wv / acc_wmin); fb = 1.0 - c * (1.0 - feedback); targetL = oldL * fb + dubL * c; targetR = oldR * fb + dubR * c; );
    deg = degradation;
    deg > 0.0001 && abs(feedback - 1.0) > 0.001 ? (
      deg_amt = deg * abs(feedback - 1.0);
      drive = 1.0 + deg_amt * 4.0;
      targetL = fast_tanh(targetL * drive) / drive;
      targetR = fast_tanh(targetR * drive) / drive;
      cutoff = max(200, 20000 * exp(-3.2 * deg_amt)); lpf_alpha = 1 - exp(-2 * $pi * cutoff / srate);
      tape_lpf_l += lpf_alpha * (targetL - tape_lpf_l); tape_lpf_l_b += lpf_alpha * (tape_lpf_l - tape_lpf_l_b); tape_lpf_l_c += lpf_alpha * (tape_lpf_l_b - tape_lpf_l_c); tape_lpf_l_d += lpf_alpha * (tape_lpf_l_c - tape_lpf_l_d);
      tape_lpf_r += lpf_alpha * (targetR - tape_lpf_r); tape_lpf_r_b += lpf_alpha * (tape_lpf_r - tape_lpf_r_b); tape_lpf_r_c += lpf_alpha * (tape_lpf_r_b - tape_lpf_r_c); tape_lpf_r_d += lpf_alpha * (tape_lpf_r_c - tape_lpf_r_d);
      targetL = targetL * (1.0 - deg_amt) + tape_lpf_l_d * deg_amt; targetR = targetR * (1.0 - deg_amt) + tape_lpf_r_d * deg_amt;
      souffle = (rand(2.0) - 1.0) * 0.0001 * deg_amt;
      targetL += souffle; targetR += souffle;
    );
    left_buf[k] = targetL; right_buf[k] = targetR;
  );
);
function dub_commit_step(n) local(cnt) ( cnt = 0; while (cm_active && cnt < n) ( dub_merge_cell(cm_k, cm_sb); cm_k += cm_dir; (cm_k < cm_lo || cm_k >= cm_hi) ? cm_active = 0; cnt += 1; ); );
function dub_commit_begin(fwd) ( while (cm_active) ( dub_commit_step(262144); ); acc_cur_dirty && acc_hi >= acc_lo ? ( cm_sb = acc_cur ? acc_set1 : acc_set0; cm_mode = acc_mode; cm_lo = acc_lo; cm_hi = acc_hi + 1; cm_dir = fwd ? 1 : -1; cm_k = fwd ? cm_lo : acc_hi; cm_active = 1; acc_cur = 1 - acc_cur; ); acc_cur_dirty = 0; acc_lo = 1000000000; acc_hi = -1; );
function dub_merge_behind(head) local(margin, safe_hi, k, sb, n) (
  acc_cur_dirty && !cm_active && acc_hi >= acc_lo ? (
    margin = max(64, floor(srate * dub_grain_ms * 0.001 * max(1.0, abs(pitch_ratio)) + delay_len + 32 + wg_Lcur * max(1.0, abs(sm_speed))));
    safe_hi = floor(head) - margin;
    safe_hi > acc_lo ? (
      sb = acc_cur ? acc_set1 : acc_set0;
      k = acc_lo; n = 0;
      while (k < safe_hi && k <= acc_hi && n < 64) (
        dub_merge_cell(k, sb);
        k += 1; n += 1;
      );
      acc_lo = k;
      acc_lo > acc_hi ? ( acc_cur_dirty = 0; acc_lo = 1000000000; acc_hi = -1; );
    );
  );
);
function dub_flush() local(gi, gb) ( dub_commit_begin(1); while (cm_active) ( dub_commit_step(262144); ); gi = 0; loop(max_wgrains, gb = wg_mem + gi * wg_stride; gb[2] = 0; gi += 1; ); wg_timer = 0; wg_prev_ok = 0; );
function dub_discard() local(gi, gb) ( acc_ok && (acc_cur_dirty || cm_active) ? memset(acc_set0, 0, acc_size * 2); cm_active = 0; acc_cur_dirty = 0; acc_lo = 1000000000; acc_hi = -1; gi = 0; loop(max_wgrains, gb = wg_mem + gi * wg_stride; gb[2] = 0; gi += 1; ); wg_timer = 0; wg_prev_ok = 0; );

// ================= V3.10 : SYNC POINT =================
// Le point de synchro d'un looper = position (en samples, dans son buffer) ou tombe le DEBUT (phase 0) de sa reference
// (looper maitre ou mesure Host). Maitre : toujours 0. Esclave : deduit au REC.
//   phi0 = phase de la reference au 1er sample enregistre ; M = longueur de la reference ; L = longueur de la boucle enregistree
//   tau  = (M - phi0) mod M      -> temps ecoule entre le debut du REC et le 1er depart de la reference
//   s    = tau mod L             -> position dans le buffer (si L < M, la boucle repasse plusieurs fois sur s : meme position)
function ref_host_phase() local(bl, nb, b) (
  bl = srate * 60.0 / max(tempo, 20); nb = ts_num > 0 ? ts_num : 4;
  b = qs_b0 + qs_i * tempo / (60.0 * srate); b -= nb * floor(b / nb);
  b * bl;
);
function sy_is_master(idx) local(o) ( o = idx * 10; gmem[o] == 1 && (gmem[o + 1] == instance_id || gmem[o + 1] == instance_alias); );
// V3.10 : identite de reference (uid) = (ms*10 + id du looper qui a cree la reference) ; 9 = Host. Elle SURVIT a la suppression du maitre.
// Un looper enregistre sans maitre est son propre maitre : il cree sa reference (sync point 0). Un esclave promu maitre garde la sienne.
function sy_make_own(idx, base) ( part_sp[idx] = 0; part_sref[idx] = (floor(time_precise() * 1000) % 1000000) * 10 + instance_id; part_sm[idx] = base; );
// base GMEM (part idx) du looper actuellement maitre de la part idx, -1 si aucun
function sy_master_blk(idx) local(mid, k, r) (
  mid = gmem[idx * 10 + 1]; r = -1; k = 0;
  loop(8, gmem[1000 + k * 600 + 1] == mid ? r = 1000 + k * 600 + idx * 200; k += 1; );
  r;
);
function sy_pos(idx, plen) ( plen > 0 ? part_sp[idx] : -1; );
function sy_id(idx, plen) ( plen > 0 && part_sp[idx] >= 0 ? part_sref[idx] : 0; );
function sy_len(idx, plen, pbase) ( plen > 0 && part_sp[idx] >= 0 ? part_sm[idx] : 0; );
function sy_live(idx, plen) local(o, bk) (
  o = idx * 10;
  plen > 0 && part_sp[idx] >= 0 ? (
    sy_is_master(idx) ? 1 : (
      part_sref[idx] == 9 ? (gmem[o] == 2) : (
        gmem[o] == 1 ? ( bk = sy_master_blk(idx); bk >= 0 && gmem[bk + 183] == part_sref[idx] ) : 0
      )
    )
  ) : 0;
);
function sy_clear(idx) ( part_sp[idx] = -1; part_sref[idx] = 0; part_sm[idx] = 0; part_sep[idx] = 0; );
// ===== V3.10 : MODE EXCLUSIF - arret / depart arme sur le prochain passage commun par le synchro point =====
// xarm : 0 rien | 1 arret arme | 2 depart arme (a son synchro point). Le moment commun est :
//   x_mode 1 : le maitre vivant (meme reference) repasse par son synchro point (suivi mclk)
//   x_mode 2 : ce looper est le maitre : son horloge repasse par son synchro point
//   x_mode 0 : pas de maitre de meme reference : le looper repasse par son propre synchro point
// cmd 28 : adopte la reference du looper src (1..8) pour la part active : sync point 0 (enregistres ensemble, meme depart)
function x_adopt(src) local(bk, idx) (
  idx = active_part - 1; src = floor(src + 0.5);
  src >= 1 && src <= 8 && length > 0 ? (
    bk = 1000 + (src - 1) * 600 + idx * 200;
    gmem[bk + 183] > 0 ? (
      part_sp[idx] = 0; part_sref[idx] = gmem[bk + 183]; part_sm[idx] = gmem[bk + 184] > 0 ? gmem[bk + 184] : length;
      part_sep[idx] = part_sref[idx] == 9 ? gmem[914 + idx] : 0;
    );
  );
);
// choisit la source du moment commun (appele a l'armement ET a chaque bloc)
function x_select_mode() local(xi_b, xmb) (
  xi_b = active_part - 1; x_mode = 0;
  sy_is_master(xi_b) ? ( x_mode = 2; x_ms = part_sp[xi_b]; x_per = base_loop_length > 0 ? base_loop_length : length; ) :
  (gmem[(active_part - 1) * 10] == 1 && mclk_valid) ? (
    xmb = sy_master_blk(xi_b);
    xmb >= 0 ? ( x_mode = 1; x_ms = max(0, gmem[xmb + 182]); x_per = mclk_len; );   // le maitre vivant (meme reference ou non) donne le moment commun
  ) : (gmem[(active_part - 1) * 10] == 2 && (play_state & 1)) ? (
    x_mode = 3; x_ms = 0; x_per = host_measure_len();       // synchro Host : debut de mesure
  );
);
function x_arm(mode) (
  x_part = active_part; x_ph_prev = -1; x_event = 0;
  mode == 1 ? ( xarm = (length > 0 && state != 0 && state != 7) ? 1 : 0; ) :
  mode == 2 ? ( xarm = (length > 0 && (state == 0 || state == 7)) ? 2 : 0; ) :
  mode == 3 ? ( xarm = (length > 0 && (state == 0 || state == 7)) ? 3 : 0; ) :   // depart en OVERDUB a son synchro point
  mode == 4 ? ( xarm = (length <= 0 && state == 0) ? 4 : 0; ) :                   // looper VIDE : depart du REC au moment commun
  ( xarm = 0; );
  xarm != 0 ? x_select_mode();     // source du moment commun fixee des l'armement (sinon 1er bloc = depart immediat)
);
// Capture de la reference au 1er sample du REC. kind : 0 aucune | 1 looper maitre | 2 Host (id 9)
function rec_ref_capture() local(ms_off, locked, mid, is_self, mb, ms_s) (
  rec_ref_kind = 0; rec_ref_id = 0; rec_ref_len = 0; rec_ref_ph = 0;
  ms_off = (active_part - 1) * 10; locked = gmem[ms_off]; mid = gmem[ms_off + 1];
  is_self = (locked == 1 && (mid == instance_id || mid == instance_alias));
  (locked == 2 && (play_state & 1)) ? (
    rec_ref_kind = 2; rec_ref_id = 9; rec_ref_len = host_measure_len(); rec_ref_ph = ref_host_phase();
  ) : (locked == 1 && !is_self && gmem[ms_off + 2] > 0) ? (
    // reference du maitre : son uid, son sync point (decalage de son horloge par rapport a sa reference) et sa periode
    mb = sy_master_blk(active_part - 1);
    rec_ref_kind = 1; rec_ref_id = (mb >= 0 && gmem[mb + 183] > 0) ? gmem[mb + 183] : mid;
    ms_s = (mb >= 0 && gmem[mb + 182] > 0) ? gmem[mb + 182] : 0;
    rec_ref_len = gmem[ms_off + 2];
    (mb >= 0 && gmem[mb + 184] > 0) ? rec_ref_len = min(rec_ref_len, gmem[mb + 184]);
    rec_ref_ph = (mclk_valid ? mclk_pos : gmem[ms_off + 3]) - ms_s;
  );
  rec_ref_kind > 0 ? ( rec_ref_ph -= rec_ref_len * floor(rec_ref_ph / rec_ref_len); );
  rec_force_free ? ( rec_ref_kind = 0; rec_force_free = 0; );
);
// Depart declenche par Start Sync : la phase est connue (grille d'attente) -> on l'arrondit pour effacer la gigue de bloc
function rec_ref_snap() local(g) (
  rec_ref_kind > 0 ? (
    g = qs_mode == 1 ? qs_unit * 60.0 * srate / max(tempo, 20) : qs_unit;
    qs_frac ? g *= 0.125;
    g > 1 ? (
      rec_ref_ph = floor(rec_ref_ph / g + 0.5) * g;
      rec_ref_ph >= rec_ref_len ? rec_ref_ph -= rec_ref_len;
    );
  );
);
function sync_store(idx) local(t, s) (
  length > 0 && rec_ref_kind > 0 && rec_ref_len > 0 ? (
    t = rec_ref_len - rec_ref_ph; t -= rec_ref_len * floor(t / rec_ref_len);
    s = t - length * floor(t / length);
    part_sp[idx] = s; part_sref[idx] = rec_ref_id; part_sm[idx] = rec_ref_len;
    part_sep[idx] = rec_ref_kind == 2 ? gmem[914 + idx] : 0;
  );
  rec_ref_kind = 0;
);

// ===== V3.12 : RE-PHASAGE SUR LE HOST =====
// Une boucle enregistree sous synchro Host garde son lien avec la grille de Reaper (part_sp = position buffer de la phase 0).
// Si l'horloge de la boucle derive (arrondi de longueur, seek / boucle de Reaper...), on la recale sur la phase Host.
// Conditions (sinon aucune correction : la boucle n'a plus de rapport avec la synchro courante) :
//   - Master Sync a l'option Re-phase ON (gmem[93]), la part est verrouillee Host (gmem[off] == 2) et le transport joue
//   - la boucle a ete enregistree contre le Host (part_sref == 9) ET sous la MEME session de synchro (part_sep == epoch courant :
//     l'epoch est incremente par Master Sync a chaque reactivation de la synchro Host)
//   - le tempo n'a pas change depuis l'enregistrement (part_sm == duree de mesure actuelle)
//   - la longueur est un multiple (ou un sous-multiple entier) de la mesure : sinon la phase n'est pas determinable
function rp_check() local(idx, M, P, n, ok, thr, ph, e) (
  idx = active_part - 1; ok = 0; P = 1;
  rp_part != active_part ? ( rp_pend = 0; rp_cnt = 0; rp_part = active_part; );
  (gmem[93] > 0.5 && (play_state & 1) && length > 0 && idx >= 0 && idx < 3
   && gmem[idx * 10] == 2 && part_sref[idx] == 9 && part_sp[idx] >= 0
   && gmem[914 + idx] > 0 && part_sep[idx] == gmem[914 + idx]
   && (state == 0 || state == 2 || state == 3 || state == 4 || state == 5)) ? (
    M = host_measure_len();
    abs(part_sm[idx] - M) < M * 0.0002 ? (
      n = length / M;
      n >= 0.999 ? (
        abs(length - floor(n + 0.5) * M) < 8 ? ( P = M; ok = 1; );
      ) : (
        n = M / length;
        abs(M - floor(n + 0.5) * length) < 8 * floor(n + 0.5) ? ( P = length; ok = 1; );
      );
    );
  );
  ok ? (
    thr = max(8, srate * 0.001 * (gmem[92] > 0 ? gmem[92] : 2));
    ph = ref_host_phase();
    e = master_pos - part_sp[idx] - ph;
    e -= P * floor(e / P + 0.5);
    abs(e) > thr ? (
      rp_cnt += 1;
      rp_cnt >= 2 ? (
        abs(e) > srate * 0.05 ? (
          // gros ecart (seek, relocalisation Reaper...) : on recale tout de suite
          master_pos -= e; master_pos -= length * floor(master_pos / length);
          active_part == 1 ? master_pos1 = master_pos : (active_part == 2 ? master_pos2 = master_pos : master_pos3 = master_pos);
          sync_hard_resync = 1; rp_pend = 0; rp_cnt = 0;
        ) : (
          rp_pend = -e;   // petite derive : appliquee au prochain bouclage de l'horloge (voir @sample)
        );
      );
    ) : ( rp_cnt = 0; rp_pend = 0; );
  ) : ( rp_cnt = 0; rp_pend = 0; );
);

function finish_rec(new_state) local(ms_off) (
  length = max(pos, 1); base_loop_length = length; mult_len = length;
  memcpy(base_backup_l, left_buf, length); memcpy(base_backup_r, right_buf, length);
  active_part == 1 ? ( len_part1 = length; base_len_part1 = base_loop_length; );
  active_part == 2 ? ( len_part2 = length; base_len_part2 = base_loop_length; );
  active_part == 3 ? ( len_part3 = length; base_len_part3 = base_loop_length; );
  hist_len[active_history_idx] = length; dirty_len = max(dirty_len, length);
  loop_start = 0; loop_width = length; smooth_start = 0; smooth_width = length; pos = 0; master_pos = 0; clk_cyc = 0;
  active_part == 1 ? master_pos1 = 0 : active_part == 2 ? master_pos2 = 0 : master_pos3 = 0;
  xfade_pos_active = 0; memset(delay_buf_l, 0, delay_len * 2); delay_idx = 0;
  state = new_state; start_analysis();
  sync_hard_resync = 1;
  sync_store(active_part - 1);

  ms_off = (active_part - 1) * 10;
  gmem[ms_off] == 0 && length > 0 ? (
      gmem[ms_off] = 1; gmem[ms_off+1] = instance_id;
      gmem[ms_off+2] = base_loop_length; gmem[ms_off+3] = master_pos;
  );
);

// V3.7: duree d'un temps (en samples) de la boucle maitre mid, lue dans le gmem de son instance (BPM publie sur la part active).
function master_beat_len(mid) local(i, b, p, bpm, r) (
  r = 0; i = 0;
  loop(max_inst,
    b = 1000 + i * 600;
    (r == 0 && mid > 0 && (gmem[b] == mid || gmem[b + 1] == mid)) ? (
      p = gmem[b + 42]; p < 1 ? p = 1;
      bpm = gmem[b + (p - 1) * 200 + gm_bpm];
      bpm > 1 ? r = 60.0 * srate / bpm;
    );
    i += 1;
  );
  r;
);

// V3.7: START SYNC (gmem[94]=1, regle dans Master Sync). Prepare la grille d'attente avant REC.
// qs_mode : 0 = pas de reference (REC immediat) | 1 = Host (unite en temps/noires) | 2 = looper maitre (unite en samples)
function qs_setup() local(ms_off, locked, mid, is_self, mlen, hb, nb, sg) (
  qs_mode = 0; qs_frac = 0;
  gmem[94] > 0.5 ? (
    ms_off = (active_part - 1) * 10;
    locked = gmem[ms_off]; mid = gmem[ms_off + 1];
    is_self = (locked == 1 && (mid == instance_id || mid == instance_alias));
    sg = max(0, min(4, floor(gmem[99] + 0.5)));
    qs_frac = (sg == 0);   // mode mesure : entrees autorisees au debut + 1/8, 1/4, 1/2 de la mesure / boucle maitre
    (locked == 2 && (play_state & 1)) ? (
      qs_mode = 1;
      qs_unit = sg == 0 ? (ts_num > 0 ? ts_num : 4) : 1.0 / sg;
    ) : (locked == 1 && !is_self && gmem[ms_off + 2] > 0) ? (
      mlen = gmem[ms_off + 2]; qs_unit = mlen;
      sg > 0 ? (
        hb = master_beat_len(mid); nb = hb > 0 ? mlen / hb : 0;
        (nb >= 1 && abs(nb - floor(nb + 0.5)) < 0.05) ? qs_unit = hb / sg : qs_frac = 1;
      );
      qs_mode = 2;
    );
  );
  qs_mode > 0;
);

// Appelee a chaque sample pendant l'attente : leve qs_hit quand la phase de la grille repasse a zero.
function qs_check() local(ph) (
  qs_mode == 1 ? (
    (play_state & 1) == 0 ? ( qs_hit = 1; ) : (
      ph = (qs_b0 + qs_i * tempo / (60.0 * srate)) / qs_unit; ph -= floor(ph);
      (qs_prev >= 0 && ph < qs_prev) ? ( qs_hit = 1; );
      (qs_frac && qs_prev >= 0 && ((qs_prev < 0.125 && ph >= 0.125) || (qs_prev < 0.25 && ph >= 0.25) || (qs_prev < 0.5 && ph >= 0.5))) ? ( qs_hit = 1; );
      qs_prev = ph;
    );
  ) : (
    ph = gmem[(active_part - 1) * 10 + 3] / qs_unit; ph -= floor(ph);
    (qs_prev >= 0 && ph < qs_prev) ? ( qs_hit = 1; );
    (qs_frac && qs_prev >= 0 && ((qs_prev < 0.125 && ph >= 0.125) || (qs_prev < 0.25 && ph >= 0.25) || (qs_prev < 0.5 && ph >= 0.5))) ? ( qs_hit = 1; );
    qs_prev = ph;
  );
);

function try_finish_rec(target, from_auto) local(ms_off, locked, mid, is_self, is_host, master_len, has_ref, k, sg, hb, nb, unit) (
  ms_off = (active_part - 1) * 10;
  locked = gmem[ms_off];
  mid = gmem[ms_off + 1];
  is_self = (locked == 1 && (mid == instance_id || mid == instance_alias));
  is_host = (locked == 2);
  master_len = is_host ? host_measure_len() 
             : (locked == 1 && !is_self && gmem[ms_off + 2] > 0) ? gmem[ms_off + 2] 
             : 0;
  has_ref = master_len > 0;
  
  // V3.7: grille de sortie (gmem[99], reglee dans Master Sync) : 0 Bar (defaut) | 1 Beat | 2 1/8 | 3 Triolet (1/3 de temps) | 4 1/16
  sg = max(0, min(4, floor(gmem[99] + 0.5))); unit = 0;
  has_ref && sg > 0 ? (
    hb = is_host ? (60.0 * srate / max(tempo, 20)) : master_beat_len(mid);
    nb = hb > 0 ? master_len / hb : 0;
    (nb >= 1 && abs(nb - floor(nb + 0.5)) < 0.05) ? unit = hb / sg;
  );
  has_ref ? (
      unit > 0 ? (
        k = from_auto ? max(1, floor(pos / unit + 0.5)) : max(1, ceil(pos / unit - 0.000001));
        target_sync_len = k * unit;
      ) : from_auto ? ( 
        k = max(1, floor(pos / master_len + 0.5)); 
        target_sync_len = k * master_len;
      ) : (
        target_sync_len = calc_sync_len(pos, master_len);
      );
      state = 8; pending_next_state = target;
  ) : (
      finish_rec(target);
  );
);
function switch_part(new_part) local(target_len, target_base_len, idx_old, idx_new) (
  xf_on = 0; rd_valid = 0; rp_tail_on = 0;
  dub_flush(); state == 1 ? try_finish_rec(2, 0);
  idx_old = active_part - 1; part_speed[idx_old] = speed; part_pitch[idx_old] = pitch; part_rev[idx_old] = rev_on; part_pingpong[idx_old] = pingpong_on; part_play_mode[idx_old] = play_mode; part_cloud_on[idx_old] = cloud_on; part_link_on[idx_old] = link_on;
  active_part == 1 ? ( master_pos1 = master_pos; clk_cyc1 = clk_cyc; len_part1 = length; base_len_part1 = base_loop_length; left_buf != buf_part1_l ? (memcpy(buf_part1_l, left_buf, length); memcpy(buf_part1_r, right_buf, length);); ) :
  active_part == 2 ? ( master_pos2 = master_pos; clk_cyc2 = clk_cyc; len_part2 = length; base_len_part2 = base_loop_length; left_buf != buf_part2_l ? (memcpy(buf_part2_l, left_buf, length); memcpy(buf_part2_r, right_buf, length);); ) :
                     ( master_pos3 = master_pos; clk_cyc3 = clk_cyc; len_part3 = length; base_len_part3 = base_loop_length; left_buf != buf_part3_l ? (memcpy(buf_part3_l, left_buf, length); memcpy(buf_part3_r, right_buf, length);); );
  active_part = new_part; history_head = 0; history_count = 1; hist_undo = 0; hist_redo = 0; dirty_len = 0;
  switch_history_slot(0);
  new_part == 1 ? ( target_len = len_part1; target_base_len = base_len_part1; ) : new_part == 2 ? ( target_len = len_part2; target_base_len = base_len_part2; ) : ( target_len = len_part3; target_base_len = base_len_part3; );
  length = target_len; base_loop_length = target_base_len; hist_len[0] = length;
  idx_new = new_part - 1; speed = part_speed[idx_new]; slider1 = speed; pitch = part_pitch[idx_new]; slider2 = pitch; rev_on = part_rev[idx_new]; slider16 = rev_on; pingpong_on = part_pingpong[idx_new]; slider17 = pingpong_on; play_mode = part_play_mode[idx_new]; slider6 = play_mode; cloud_on = part_cloud_on[idx_new]; slider23 = cloud_on; link_on = part_link_on[idx_new]; slider7 = link_on;
  loop_start = 0; loop_width = length > 0 ? length : 0; smooth_start = 0; smooth_width = loop_width; pos = 0;
  
  master_pos = 0;
  new_part == 1 ? ( master_pos1 = 0; ) : 
  new_part == 2 ? ( master_pos2 = 0; ) : 
                  ( master_pos3 = 0; );

  clk_len_ref = length; xfade_pos_active = 0;
  sync_hard_resync = 1;
  length <= 0 ? ( dirty_len = buf_len; state = 0; state_target = auto_on ? 7 : 1; master_pos = 0; clk_cyc = 0; ) : ( state = 2; state_target = 3; start_analysis(); );
  last_state_target = -1;
);
function push_new_history_state() local(src_l, src_r, new_idx) (
  new_idx = (active_history_idx + 1) % max_history; src_l = left_buf; src_r = right_buf; switch_history_slot(new_idx); history_head = new_idx;
  memcpy(left_buf, src_l, length); memcpy(right_buf, src_r, length); hist_len[new_idx] = length; dirty_len = max(dirty_len, length); hist_undo = min(hist_undo + 1, max_history - 1); hist_redo = 0; history_count = hist_undo + 1;
);
function sync_length_from_history() local(nl) ( nl = hist_len[active_history_idx]; nl > 0 && nl != length ? ( length = nl; loop_start = 0; loop_width = length; smooth_start = 0; smooth_width = length; pos >= length ? pos = 0; master_pos = min(master_pos, length); xfade_pos_active = 0; start_analysis(); ); );
function undo_state() ( 
  rp_tail_on = 0; dub_flush(); 
  hist_undo > 0 ? ( 
    active_history_idx = (active_history_idx - 1 + max_history) % max_history; 
    switch_history_slot(active_history_idx); 
    hist_undo -= 1; hist_redo += 1; 
    sync_length_from_history(); 
    sync_hard_resync = 1;
  ); 
);
function redo_state() ( 
  rp_tail_on = 0; dub_flush(); 
  hist_redo > 0 ? ( 
    active_history_idx = (active_history_idx + 1) % max_history; 
    switch_history_slot(active_history_idx); 
    hist_redo -= 1; hist_undo += 1; 
    sync_length_from_history(); 
    sync_hard_resync = 1;
  ); 
);
function get_slicer_len() ( slicer_mode == 5 ? max(1, trans_count) : (slicer_mode == 0 ? 16 : max(1, min(32, floor(slicer_steps + 0.5)))); );
function update_slicer_pitches(step_len) local(i, ratio_p, impact_pct, ext_pct, idx_norm, active_double) ( i = 0; loop(step_len, ratio_p = slicer_pitch_spread * 0.01; ratio_p <= 0.0001 ? ( slice_pitch_mem[i] = 0.0; ) : ratio_p <= 0.5 ? ( impact_pct = ratio_p * 2.0; (i / step_len) < impact_pct ? ( slice_pitch_mem[i] = (rand(1.0) < 0.5 ? -12.0 : 12.0); ) : ( slice_pitch_mem[i] = 0.0; ); ) : ( ext_pct = (ratio_p - 0.5) * 2.0; idx_norm = i / step_len; idx_norm < 0.5 ? ( slice_pitch_mem[i] = (rand(1.0) < 0.5 ? -12.0 : 12.0); ) : ( active_double = 0.5 + ext_pct * 0.5; idx_norm < active_double ? ( slice_pitch_mem[i] = (rand(1.0) < 0.5 ? -24.0 : 24.0); ) : ( slice_pitch_mem[i] = (rand(1.0) < 0.5 ? -12.0 : 12.0); ); ); ); i += 1; ); );
function generate_slicer_sequence(step_len) local(i, rnd_idx, temp, p) ( trans_count > 0 ? ( slicer_mode == 5 ? ( i = 0; loop(step_len, seq_mem[i] = trans_mem[i % trans_count]; i += 1; ); i = 0; loop(step_len, p = floor(rand(step_len)); temp = seq_mem[i]; seq_mem[i] = seq_mem[p]; seq_mem[p] = temp; i += 1; ); ) : ( i = 0; loop(step_len, rnd_idx = floor(rand(trans_count)); seq_mem[i] = trans_mem[rnd_idx]; i += 1; ); ); update_slicer_pitches(step_len); ); );
function calc_cloud_pitch(spread_val) local(ratio_p, impact_pct, ext_pct, r) ( ratio_p = spread_val * 0.01; ratio_p <= 0.0001 ? 0.0 : ( ratio_p <= 0.5 ? ( impact_pct = ratio_p * 2.0; rand(1.0) < impact_pct ? (rand(1.0) < 0.5 ? -12.0 : 12.0) : 0.0; ) : ( ext_pct = (ratio_p - 0.5) * 2.0; r = rand(1.0); r < 0.5 ? ( rand(1.0) < 0.5 ? -12.0 : 12.0 ) : ( r < (0.5 + ext_pct * 0.5) ? ( rand(1.0) < 0.5 ? -24.0 : 24.0 ) : ( rand(1.0) < 0.5 ? -12.0 : 12.0 ) ); ); ); );
function tape_write_span(w_from, w_to, w_mode) local(k, k_end, seg_a, seg_b, wgt, tn, vL, vR, w2, oldL, oldR, steps, total_span, fb, targetL, targetR, dev, cutoff, lpf_alpha, deg, deg_amt, p_angle, gL, gR, mono_src, clippedL, clippedR, drive, souffle) (
  deg = degradation; w_to > w_from ? ( k = floor(w_from); k_end = floor(w_to); k_end < k ? k_end = k; steps = min(k_end - k + 1, 24); total_span = max(w_to - w_from, 0.0001);
    loop(steps, k < buf_len ? ( seg_a = max(w_from, k); seg_b = min(w_to, k + 1); wgt = (seg_b - seg_a) * dens_g * sl_gate; wgt > 0 ? (
