    gmem[gmem_base + 175] = ana_mode;
    gmem[gmem_base + 176] = src_auto;
    gmem[gmem_base + 177] = slicer_link;
    gmem[gmem_base + gm_sampler_armed] = smp_mode;
    gmem[gmem_base + gm_sampler_pmode] = sampler_pitch_mode;
    gmem[gmem_base + gm_sampler_release] = sampler_release;
    gmem[gmem_base + gm_sampler_voices] = smp_nact;
    gmem[gmem_base + gm_bpm] = (length > 0) ? (60.0 * srate / loop_beat_len()) : 0;

    // Export metering for the external 8-looper panel (linear peak 0..1).
    // Offsets 172/173 are unused in the per-part 200-cell block.
    gmem[gmem_base + 172] = peak_in_vu;
    gmem[gmem_base + 173] = peak_out_vu;

    // Export parameter variables by their declared JSFX names.
    param_gmem_base = 110000 + ((inst_idx * 3) + p) * 60;
    gmem[param_gmem_base + 0] = speed;
    gmem[param_gmem_base + 1] = pitch;
    gmem[param_gmem_base + 2] = mix;
    gmem[param_gmem_base + 3] = grain_ms;
    gmem[param_gmem_base + 4] = fade_ms;
    gmem[param_gmem_base + 5] = play_mode;
    gmem[param_gmem_base + 6] = link_on;
    gmem[param_gmem_base + 7] = state_slider;
    gmem[param_gmem_base + 8] = loop_pos_pct;
    gmem[param_gmem_base + 9] = trans_sens;
    gmem[param_gmem_base + 10] = trans_hold_ms;
    gmem[param_gmem_base + 11] = grain_fade;
