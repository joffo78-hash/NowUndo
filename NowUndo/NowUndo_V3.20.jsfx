    wr_id == 10 ? ( length > 0 ? ( req_p = (max(0, min(100, wr_v)) * 0.01) * length; trigger_pos_jump(req_p); slider9 = (pos / length) * 100; last_slider9 = slider9; ); ) :
    wr_id == 13 ? ( grain_fade = max(5, min(50, wr_v)); slider12 = grain_fade; ) :
    wr_id == 19 ? ( feedback = max(0, min(2, wr_v)); slider18 = feedback; ) :
