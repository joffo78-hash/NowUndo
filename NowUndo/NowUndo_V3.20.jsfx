  gmem[gmem_base + 183] = sy_id(p, sy_plen);
  gmem[gmem_base + 184] = sy_len(p, sy_plen, sy_pbase);
  gmem[gmem_base + 185] = sy_live(p, sy_plen); gmem[gmem_base + 186] = srate;
  
  is_active = (p == (active_part - 1));
