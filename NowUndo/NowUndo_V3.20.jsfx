    gmem[param_gmem_base + 56] = slicer_link;
    gmem[param_gmem_base + 57] = instance_id;
    gmem[param_gmem_base + 58] = active_part;
    gmem[param_gmem_base + 59] = 1; // publish only after all values are written

    wave_export_slots = 100;
    max_len_exp = (length > 0) ? length : (state == 1 || state == 8 ? pos : 0);
    max_len_exp > 0 ? (
      wi_ex = 0; w_step_ex = max_len_exp / wave_export_slots;
      loop(wave_export_slots,
        w_val_ex = 0; wk_ex = 0;
        loop(4,
          w_idx_ex = floor(wi_ex * w_step_ex + wk_ex * w_step_ex * 0.25);
          w_tmp_ex = max(abs(left_buf[w_idx_ex]), abs(right_buf[w_idx_ex]));
          w_tmp_ex > w_val_ex ? w_val_ex = w_tmp_ex;
          wk_ex += 1;
        );
        gmem[gmem_base + 50 + wi_ex] = w_val_ex;
        wi_ex += 1;
      );
    ) : (
      wi_ex = 0; loop(100, gmem[gmem_base + 50 + wi_ex] = 0; wi_ex += 1;);
    );

    // EXPORT SLICES GMEM (8 instances x 3 song parts)
    // Table par instance/part : [0]=nombre, [1]=loop_start, [2]=loop_width,
    // puis 256 positions en samples relatives au debut de la region.
    // Base = 100000 + ((instance-1)*3 + (part-1))*259.
    slice_gmem_base = 100000 + ((inst_idx * 3) + (active_part - 1)) * 259;
    gmem[slice_gmem_base] = min(trans_count, max_transients);
    gmem[slice_gmem_base + 1] = loop_start;
    gmem[slice_gmem_base + 2] = loop_width;
    slice_gmem_i = 0;
    loop(max_transients,
      gmem[slice_gmem_base + 3 + slice_gmem_i] = slice_gmem_i < trans_count
        ? max(0, trans_mem[slice_gmem_i] - loop_start) : 0;
