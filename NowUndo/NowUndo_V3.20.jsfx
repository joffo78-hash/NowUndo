    gmem[param_gmem_base + 13] = slicer_sub;
    gmem[param_gmem_base + 14] = slice_decay_ms;
    gmem[param_gmem_base + 15] = rev_on;
    gmem[param_gmem_base + 16] = pingpong_on;
    gmem[param_gmem_base + 17] = feedback;
    gmem[param_gmem_base + 18] = degradation;
    gmem[param_gmem_base + 19] = stereo_width;
    gmem[param_gmem_base + 20] = out_vol;
    gmem[param_gmem_base + 21] = ghost_pos_pct;
