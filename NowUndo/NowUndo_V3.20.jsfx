    gmem[param_gmem_base + 39] = cloud_lfo_depth;
    gmem[param_gmem_base + 40] = looper_hue;
    gmem[param_gmem_base + 41] = sampler_root;
    gmem[param_gmem_base + 42] = sampler_pitch_mode;
    gmem[param_gmem_base + 43] = sampler_release;
    gmem[param_gmem_base + 44] = manual_id;
    gmem[param_gmem_base + 45] = clk_src;
    gmem[param_gmem_base + 46] = slicer_steps;
    gmem[param_gmem_base + 47] = max_slices;
    gmem[param_gmem_base + 48] = slicer_preset;
    gmem[param_gmem_base + 49] = det_thresh;
    gmem[param_gmem_base + 50] = det_hold_ms;
