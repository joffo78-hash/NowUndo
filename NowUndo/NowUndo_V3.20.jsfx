    wr_id == 49 ? ( slicer_preset = max(1, min(4, floor(wr_v + 0.5))); slider49 = slicer_preset; ) :
    wr_id == 50 ? ( det_thresh = max(0.001, min(0.8, wr_v)); slider50 = det_thresh; ) :
    wr_id == 55 ? ( slice_attack_ms = max(0, min(100, floor(wr_v + 0.5))); slider55 = slice_attack_ms; ) :
    wr_id == 58 ? ( slicer_link = wr_v >= 0.5 ? 1 : 0; slider57 = slicer_link; ) :
    wr_id == 56 ? ( slicer_regen(); ) :
    wr_id == 61 ? ( slx_mix = max(0, min(1, wr_v)); slider60 = slx_mix; ) :
    wr_id == 60 ? ( br_mix = max(0, min(1, wr_v)); slider59 = br_mix; ) :
    wr_id == 59 ? ( // BRF : fraction de quantification (0=Free,1=1/2,2=1/3,3=1/4,4=1/6,5=1/8,6=1/12,7=1/16,8=1/32,9=1/64)
      loop_quant = max(0, min(9, floor(wr_v + 0.5))); slider24 = loop_quant;
      br_on ? br_refresh() : ( length > 0 ? ( loop_start = apply_quant_start(loop_start); loop_width = apply_quant_width(loop_width, loop_start); sync_hard_resync = 1; ); );
    ) :
    wr_id == 51 ? ( det_hold_ms = max(30, min(1000, wr_v)); slider51 = det_hold_ms; ) :
    0;
    gmem[gmem_base + 180] = 0;
    gmem[gmem_base + 181] = 0;
  );
  
  gmem[gmem_base + 0]  = instance_id;
  gmem[gmem_base + 1]  = instance_alias;
  // V3.10 : point de synchro (+182 pos samples, -1 aucun | +183 id reference 1..8, 9 = Host | +184 longueur reference | +185 reference toujours active)
  sy_plen = (p == (active_part - 1)) ? length : (p == 0 ? len_part1 : (p == 1 ? len_part2 : len_part3));
  sy_pbase = (p == (active_part - 1)) ? base_loop_length : (p == 0 ? base_len_part1 : (p == 1 ? base_len_part2 : base_len_part3));
  (sy_plen > 0 && part_sp[p] < 0 && sy_is_master(p)) ? sy_make_own(p, sy_pbase > 0 ? sy_pbase : sy_plen);
  gmem[gmem_base + 187] = (sy_plen > 0 && sy_is_master(p)) ? 1 : 0;
