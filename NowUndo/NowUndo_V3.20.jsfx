@init
// Decay : position 0..100 <-> ms, interpolation exponentielle entre points :
// 0%=4ms 25%=20ms 50%=45ms 75%=150ms 90%=300ms 99%=500ms 100%=Infini (2000).
function decay_seg(x, x0, m0, x1, m1) ( m0 * ((m1 / m0) ^ ((x - x0) / (x1 - x0))); );
function decay_pos_to_ms(pos) (
  pos <= 0 ? 4 : pos < 25 ? decay_seg(pos, 0, 4, 25, 20) : pos < 50 ? decay_seg(pos, 25, 20, 50, 45) :
  pos < 75 ? decay_seg(pos, 50, 45, 75, 150) : pos < 90 ? decay_seg(pos, 75, 150, 90, 300) :
  pos < 99 ? decay_seg(pos, 90, 300, 99, 500) : pos < 100 ? decay_seg(pos, 99, 500, 100, 2000) : 2000;
);
function decay_iseg(ms, x0, m0, x1, m1) ( x0 + (x1 - x0) * log(ms / m0) / log(m1 / m0); );
function decay_ms_to_pos(ms) (
  ms > 1950 ? 100 : ms <= 4 ? 0 : ms < 20 ? decay_iseg(ms, 0, 4, 25, 20) : ms < 45 ? decay_iseg(ms, 25, 20, 50, 45) :
  ms < 150 ? decay_iseg(ms, 50, 45, 75, 150) : ms < 300 ? decay_iseg(ms, 75, 150, 90, 300) :
  ms < 500 ? decay_iseg(ms, 90, 300, 99, 500) : decay_iseg(ms, 99, 500, 100, 2000);
);
slice_decay_ms = 150;
ext_noinit = 1;

function fast_tanh(x) local(x2, x3, x5) ( 
  abs(x) > 3 ? ( x > 0 ? 1 : -1 ) : ( 
    x2 = x * x; 
    x3 = x2 * x; 
    x5 = x3 * x2; 
    x * (27 + x2) / (27 + 9 * x2) 
  ); 
);

function host_measure_len() local(t, n) ( 
  t = max(tempo, 20); 
  n = ts_num > 0 ? ts_num : 4; 
  srate * (60.0 / t) * n; 
);

// ---- IDENTIFICATION MANUELLE (slider45 + @serialize) ----
// manual_id est la variable du slider45. On force un entier 0..8.
// 0 = Auto -> instance_id 1 (attention collisions si plusieurs Auto).
manual_id = floor(manual_id + 0.5);
manual_id < 0 ? manual_id = 0 : manual_id > 8 ? manual_id = 8;
slider45 = manual_id;
instance_id = manual_id > 0 ? manual_id : 1;
instance_alias = instance_id;
inst_idx = instance_id - 1;
max_inst = 8;
saved_manual_id = manual_id; // miroir pour @serialize (survit mieux aux re-init)

max_loop_sec = 90;
mem_budget = 120000000;

single_buf_len = min(floor(srate * max_loop_sec), floor(mem_budget / 30)); 
buf_len = single_buf_len;
slot_size = single_buf_len * 2;

buf_part1_l = 0; buf_part1_r = single_buf_len;
buf_part2_l = slot_size; buf_part2_r = slot_size + single_buf_len;
buf_part3_l = slot_size * 2; buf_part3_r = slot_size * 2 + single_buf_len;

hist_mem_start = slot_size * 3;
available_slots = floor((mem_budget - hist_mem_start - slot_size - 20000) / slot_size);
max_history = max(2, min(8, available_slots + 1));

base_backup_l = hist_mem_start + (max_history - 1) * slot_size;
base_backup_r = base_backup_l + single_buf_len;

hist_len = base_backup_r + single_buf_len + 1000;   
i = 0; loop(16, hist_len[i] = 0; i += 1;);

active_part = 1; 
target_part = 1;
pending_part_switch = 0;

part_speed = hist_len + 50; part_pitch = part_speed + 3; part_rev = part_pitch + 3;
part_pingpong = part_rev + 3; part_play_mode = part_pingpong + 3;
part_cloud_on = part_play_mode + 3; part_link_on = part_cloud_on + 3;
// V3.10 : point de synchro par part (position en samples dans le buffer, -1 = aucun), id de reference, longueur de reference
part_sp = part_link_on + 3; part_sref = part_sp + 3; part_sm = part_sref + 3;
// V3.12 : epoch de la synchro Host sous laquelle la boucle a ete enregistree (publie par Master Sync dans gmem[914..916])
part_sep = part_sm + 3;
rp_pend = 0; rp_cnt = 0; rp_part = 0; ab_len = -1; ab_ts = -1; ab_nb = 4;
rec_ref_kind = 0; rec_ref_id = 0; rec_ref_len = 0; rec_ref_ph = 0; qs_snap = 0;
mclk_valid = 0; mclk_pos = 0; mclk_len = 0; mclk_len_prev = 0; mclk_cyc = 0;
i = 0; loop(3, part_sp[i] = -1; part_sref[i] = 0; part_sm[i] = 0; part_sep[i] = 0; i += 1;);

i = 0;
loop(3,
  part_speed[i] = 1.0; part_pitch[i] = 0.0; part_rev[i] = 0;
  part_pingpong[i] = 0; part_play_mode[i] = 0; part_cloud_on[i] = 0; part_link_on[i] = 0;
  i += 1;
);

len_part1 = 0; len_part2 = 0; len_part3 = 0;
base_len_part1 = 0; base_len_part2 = 0; base_len_part3 = 0;
history_head = 0; history_tail = 0; history_count = 1; active_history_idx = 0;
hist_undo = 0; hist_redo = 0; dirty_len = 0; left_buf = buf_part1_l; right_buf = buf_part1_r;

max_grains = 16; grain_data_size = 8; grain_mem = part_link_on + 100;
max_transients = 256; trans_mem = grain_mem + (max_grains * grain_data_size) + 100;
seq_mem = trans_mem + max_transients + 100; slice_pitch_mem = seq_mem + max_transients + 100;
trans_count = 0;

lut_size = 1024; lut_cos = slice_pitch_mem + max_transients + 100;
i = 0; loop(lut_size, lut_cos[i] = 0.5 - 0.5 * cos(2 * $pi * (i / lut_size)); i += 1; );

i = 0; 
loop(max_grains,
  base = grain_mem + (i * grain_data_size);
  base[0] = 0; base[1] = 0; base[2] = 0; base[3] = srate * 0.1; base[4] = 0; base[5] = 0; base[6] = 0; base[7] = 0;
  i += 1;
);
grain_dur = srate * 0.1; spawn_timer = 0;

delay_len = 32; delay_buf_l = lut_cos + lut_size + 100; delay_buf_r = delay_buf_l + delay_len; delay_idx = 0;

wg_mem = delay_buf_r + delay_len + 100; wg_stride = 5; max_wgrains = 16;
acc_len = single_buf_len; acc_size = acc_len * 3;
ih_size = 32768; ih_mask = 32767; ih_l = wg_mem + max_wgrains * wg_stride + 100; ih_r = ih_l + ih_size; memset(ih_l, 0, ih_size * 2); ih_n = 0; wg_prev_ok = 0; wg_prev_src = 0; wg_prev_n = 0; wg_Lcur = 0;
rd_tmp = ih_r + ih_size + 10; rd_prev_ok = 0; rd_prev_start = 0; rd_prev_n = 0; rd_prev_dur = 0;
acc_set0 = ih_r + ih_size + 400; acc_set1 = acc_set0 + acc_size; acc_end  = acc_set1 + acc_size;
acc_ok = (acc_end + 100) < mem_budget; acc_ok ? memset(acc_set0, 0, acc_size * 2);
acc_cur = 0; acc_cur_dirty = 0; acc_lo = 1000000000; acc_hi = -1;
acc_wmin = 0.5; acc_wrep = 0.9; acc_mode = 1; cm_mode = 1; wg_rf = 1; wg_hop = 0.5; wg_fade = 0.5;
wg_timer = 0; wg_es = 0; wg_el = 16; wg_gL = 1; wg_gR = 1;
cm_active = 0; cm_k = 0; cm_dir = 1; cm_lo = 0; cm_hi = 0; cm_sb = 0;
dub_gran = 0; dub_gran_prev = 0; gran_now = 0; auto_above_prev = 0;

dens_bag = acc_end + 200; dens_bag_i = 16; dens_carry = 0; dens_last_occ = -1;
dens_g = 1; dens_tgt = 1; dens_slot = -1; dens_rt = 0; dens_prev_state = -1; dens_force = 0; dens_len_f = dens_len;
dens_slew = 1.0 / (srate * 0.005);
sl_lo = 0; sl_hi = 0; sl_run = 1; sl_gate = 1; sl_slew = 1.0 / (srate * 0.003);
slice_mute_gate = 1.0; slice_mute_step = 0; slice_mute_target = 1.0;

current_slice_pitch = 0.0; cloud_lfo_phase = 0.0; cloud_center_draw = 0.0;
wow_phase = 0.0; flutter_phase = 0.0;
smp_nv = 16; smp_vs = 16; smp_voice = dens_bag + 16 + 100;
smp_evmax = 512; smp_ev_off = smp_voice + smp_nv * smp_vs + 100; smp_ev_note = smp_ev_off + smp_evmax; smp_ev_vel = smp_ev_note + smp_evmax;
memset(smp_voice, 0, smp_nv * smp_vs); memset(smp_ev_off, 0, smp_evmax * 3);
trans_str = smp_ev_vel + smp_evmax + 100; pslot = 4 + max_transients * 2; preset_mem = trans_str + max_transients + 100;
memset(trans_str, 0, max_transients); memset(preset_mem, 0, pslot * 4);
// Spectral-flux multi-bandes : buffers de travail placés après les presets.
odf_hop = max(32, floor(srate * 0.003));
odf_max_n = floor(single_buf_len / odf_hop) + 8;
odf_mem = preset_mem + pslot * 4 + 100;
odf_cs = odf_mem + odf_max_n + 16;
odf_floor = 0.000001; odf_n = 0; odf_cnt = 0;
odf_W = max(4, floor(srate * 0.1 / odf_hop));
odf_a_lo = 1 - exp(-2 * $pi * 150 / srate);
odf_a_mid = 1 - exp(-2 * $pi * 2500 / srate);
odf_c_lo = 1 - exp(-1 / (srate * 0.012));
odf_c_mid = 1 - exp(-1 / (srate * 0.004));
odf_c_hi = 1 - exp(-1 / (srate * 0.0015));
// ---- Detection v2 : flux spectral FFT (SuperFlux) + selection des N meilleurs pics ----
st_N = srate > 60000 ? 2048 : 1024; st_nb = 24; st_lag = 3; st_rp = 0;
odf2_mem = odf_cs + odf_max_n + 16;
cand_max = 4096;
cand_k = odf2_mem + odf_max_n + 16; cand_v = cand_k + cand_max + 16; cand_s = cand_v + cand_max + 16; cand_ok = cand_s + cand_max + 16;
cand_p = cand_ok + cand_max + 16; sel_k = cand_p + cand_max + 16; sel_s = sel_k + max_transients + 16;
st_win = sel_s + max_transients + 16; st_band = st_win + st_N + 16; st_ring = st_band + 64;
st_fft = ceil((st_ring + (st_lag + 1) * st_nb + 64) / 4096) * 4096;
i = 0; loop(st_N, st_win[i] = 0.5 - 0.5 * cos(2 * $pi * i / st_N); i += 1; );
st_fmax = min(16000, 0.45 * srate);
i = 0; loop(st_nb + 1,
  st_band[i] = floor(80 * exp(log(st_fmax / 80) * i / st_nb) / (srate / st_N));
  i > 0 && st_band[i] <= st_band[i - 1] ? st_band[i] = st_band[i - 1] + 1;
  i += 1;
);
i = 0; loop((st_lag + 1) * st_nb, st_ring[i] = 0; i += 1; );
det_cap = 32; LD_BASE = 1000000; LD_MAXN = 3500000; ld_active = 0; ld_i = 0; ld_n = 0; ld_ref = 0; ld_qid = 0; ld_part = 1; rec_force_free = 0; x_free = 0; xarm = 0; x_part = 1; x_ph_prev = -1; x_event = 0; x_mode = 0; x_ms = 0; x_per = 0; an_keep = 0; ana_mode = 0; sel_n = 0; cand_n = 0; an_N = 0; an_nr = 0; an_ne = 0; an_done = 0; an_dmin = 1; an_ns = 0;
an_gap = max(1, ceil(0.06 * srate / odf_hop));
// V3.13 : detecteur de slices leger (enveloppe rapide / fond lent + seuil + hold, comme l'auto-rec)
dv_rf = exp(-1 / (srate * 0.005)); dv_cs = 1 - exp(-1 / (srate * 0.12)); dv_trkn = max(1, floor(srate * 0.005));
dv_f = 0; dv_s = 0; dv_hold = 0; dv_trk = 0; dv_a = 0; det_chg = 0; det_rel = 0.04; dv_j = 0; dv_m = 0; dv_lim = 0;
an_exit_pending = 0; an_wrap_pending = 0; an_prev_state = -1; an_prev_hist = 0;
preset_cur = -1; last_preset = -1; last_steps = slicer_steps; last_max_sl = max_slices; steps_f = slicer_steps; maxsl_f = max_slices;
smp_att = 1.0 / (srate * 0.002); smp_tail = max(1, srate * 0.003); smp_choke_rel = 1.0 / (srate * 0.004); smp_quick_rel = 1.0 / (srate * 0.005);
smp_l = 0; smp_r = 0; smp_rl = 0; smp_rr = 0; smp_age = 0; smp_armed = 0; smp_kmode = 0; smp_mode = 0; smp_prev_mode = 0; smp_G = 4096; smp_Gh = 2048; smp_ev_n = 0; smp_ev_i = 0; smp_blk = 0; smp_alloff = 0; smp_nact = 0;
sampler_root_f = sampler_root; sampler_rel_u = sqrt(sampler_release / 3000);

gm_pspread_slicer = 34;
gm_pspread_cloud  = 35;
gm_sampler_root   = 150;
gm_sampler_armed  = 151;
gm_sampler_voices = 152;
gm_sampler_release = 154;
gm_sampler_pmode  = 153;
gm_bpm            = 155;

function calc_sync_len(current_len, ms_len) local(t) (
  ms_len > 0 ? (
    t = ms_len * 0.125; current_len <= t ? t :
    (t = ms_len * 0.25; current_len <= t ? t :
    (t = ms_len * 0.5;  current_len <= t ? t :
    (ceil(current_len / ms_len) * ms_len)
    ));
  ) : current_len;
);

// V3.12 : estimation du nombre de temps d'une boucle SANS reference de tempo (looper libre ou maitre).
// Avant : nb = round(longueur / temps_Reaper) -> circulaire (le resultat collait au tempo deja affiche dans Reaper, avec un
// nombre de temps quelconque : 21, 13...). Maintenant : nb ne peut etre qu'une subdivision/multiple musical de la mesure
// (puissances de 2, ou ts_num * 2^k pour les mesures non binaires), et on prend celui dont le BPM est le plus proche de 112
// (replie dans l'octave ~[79;158[). Le BPM exact vient alors de la longueur reelle : 60 * srate * nb / length.
function auto_nb() local(nb0, base, n, bpm, sc, bsc) (
  (length != ab_len || ts_num != ab_ts) ? (
    ab_len = length; ab_ts = ts_num;
    nb0 = max(1, floor((ts_num > 0 ? ts_num : 4) + 0.5));
    base = (nb0 & (nb0 - 1)) == 0 ? 1 : nb0;
    n = base; bsc = 1000000000; ab_nb = base;
    loop(9,
      bpm = 60.0 * srate * n / max(1, length);
      sc = abs(log(bpm / 112.0));
      sc < bsc ? ( bsc = sc; ab_nb = n; );
      n *= 2;
    );
  );
  ab_nb;
);
function loop_beat_len() local(hb, nb, lk, mid) (
  hb = (60 / max(tempo, 20)) * srate;
  length > 0 ? (
    lk = gmem[(active_part - 1) * 10]; mid = gmem[(active_part - 1) * 10 + 1];
    nb = loop_beats >= 1 ? floor(loop_beats + 0.5) :
         ((lk == 0 || (lk == 1 && (mid == instance_id || mid == instance_alias))) ? auto_nb() :   // libre ou maitre : pas de tempo de reference
          max(1, floor(length / hb + 0.5)));                                                       // Host / esclave : le tempo de reference fait foi
    hb = length / nb;
  );
  hb;
);

function dens_next() local(i, j, t, want, k) (
  (dens_bag_i >= 16 || dens_occ != dens_last_occ) ? (
    dens_occ != dens_last_occ ? dens_carry = 0;
    dens_last_occ = dens_occ;
    dens_occ <= 0.001 ? ( k = 0; dens_carry = 0; ) : (
      want = dens_occ * 0.16 + dens_carry;
      k = min(16, floor(want)); dens_carry = min(1, want - k);
    );
    i = 0; loop(16, dens_bag[i] = (i < k) ? 1 : 0; i += 1;);
    i = 15; loop(15, j = floor(rand(i + 1)); t = dens_bag[i]; dens_bag[i] = dens_bag[j]; dens_bag[j] = t; i -= 1;);
    dens_bag_i = 0;
  );
  dens_tgt = dens_bag[dens_bag_i]; dens_bag_i += 1;
);

// V3.20 : choisit le prochain fragment (rec ou silence). Alternance stricte, longueurs tirees au hasard (x0.25 .. x1.75
// de la moyenne) et corrigees par l'ecart cumule -> au final dens_occ % du temps enregistre, reparti un peu partout.
// Rec Density Length = longueur moyenne d'un fragment (fraction de mesure).
function dens_pick() local(p, L, mon, moff, err, ln, r) (
  p = max(0, min(1, dens_occ * 0.01));
  L = max(dens_minlen, loop_beat_len() * 4 * (2 ^ (-floor(dens_len + 0.5))));
  mon = 2 * L * p; moff = 2 * L * (1 - p);
  r = 0.25 + rand(1.5);
  err = p * dens_T - dens_Ton;
  p <= 0.001 ? dens_next_on = 0;
  dens_tgt = dens_next_on;
  ln = dens_tgt ? mon * r + 0.5 * err : moff * r - 0.5 * err;
  ln = max(dens_minlen, min(ln, 4 * L));
  dens_seg = ln; dens_T += ln; dens_tgt ? dens_Ton += ln;
  dens_next_on = p <= 0.001 ? 0 : !dens_tgt;
);
write_ptr = 0; state = 0; state_target = 2; last_state_target = 2; rec_cmd = 0; pending_next_state = 2; target_sync_len = 0;
pos = 0; old_pos_ptr = 0; length = 0; loop_start = 0; loop_width = 0; base_loop_length = 0; mult_len = 0;
master_pos = 0; clk_cyc = 0; master_pos1 = 0; master_pos2 = 0; master_pos3 = 0;
is_normal_playback = 0; prev_normal_playback = 0; can_sync = 0; last_ghost_pct = 0; prev_rev_on = 0;
clk_cyc = 0; clk_cyc1 = 0; clk_cyc2 = 0; clk_cyc3 = 0; clk_len_ref = 0;
sync_a = 0; sync_b = 0; sync_c_w = 0; sync_c_l = 0; sync_c_r = 0; prev_sync_key = 0; prev_cloud_on = 0; prev_xcl = 0;
ml_ok = 0; ml_fwd_free = 0; ml_cool = 0;
active_control = 0; smooth_start = 0; smooth_width = 0; param_smooth_coeff = 0.95;
xfade_pos_active = 0; xfade_pos_len = srate * 0.015; xfade_pos_count = 0;
// ===== V3.20 : SLICER PRECIS =====
// xf_* : voix fantome (l'ancien slice continue et s'efface pendant le fondu) ; rd_last_* : etat de la tete de lecture au sample precedent
xf_on = 0; xf_k = 0; xf_inc = 0; xf_eqp = 0; xf_l = 0; xf_r = 0; xf_p = 0; xf_st = 0; xf_ws = 0; xf_we = 1; xf_g = 0; xf_pan = 0; xf_pamt = 0;
rd_valid = 0; rd_last_l = 0; rd_last_r = 0; rd_last_p = 0; rd_last_st = 0; rd_last_ws = 0; rd_last_we = 1; rd_last_g = 0; rd_last_pan = 0; rd_last_pamt = 0;
xf_len_slice = max(16, floor(srate * 0.0025));   // fondu entre deux slices : 2.5 ms equi-puissance
xf_len_jump = max(16, floor(srate * 0.012));     // sortie du slicer : 12 ms
sl_pre_t = floor(srate * 0.002);                 // pre-roll : le fondu d'entree se termine SUR le point de coupe
pd_l = 0; pd_r = 0; pd_arm = 0; pd_prev_l = 0; pd_prev_r = 0; pd_k = exp(-1 / (srate * 0.0025));
sl_pan_amt = 0; sl_pan_k = 1 - exp(-1 / (srate * 0.004)); slice_hold = 0;
