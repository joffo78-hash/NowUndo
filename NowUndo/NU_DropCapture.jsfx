desc:NU Drop Capture (NowUndo V3.27 : enregistre tout depuis DROP ON, sur la piste de la cible)
// Pose TEMPORAIREMENT par le script Launchpad en BOUT de chaine de la piste du looper cible, puis retire.
// Entrees 1/2 = la cible apres ses effets (avant son fader) ; entrees 3/4 = les autres loopers du groupe, arrives par
// des sends post-fader sur 2 canaux libres de la piste (le script regle le routage des broches 3/4). Drop solo : rien en 3/4.
// Meme piste que la cible = meme bloc audio : l'instant du cycle (gmem[300 + (cible-1)*10 + 1], publie au debut de chaque
// bloc par la cible) est exact, quels que soient le traitement anticipe et la latence de REAPER.
// V3.27 : DROP ON / OFF. La capture enregistre TOUT depuis DROP ON (rien n'est ecrase), la cible recopie au fil de l'eau :
//   gmem[393] = jeton (depart) | [381] = cible 1..8 | [395] = gain des autres loopers (1 / volume de la piste cible)
//   publie : [392] = instant du cycle au 1er echantillon ecrit, [397] = nombre d'echantillons ecrits ; l'echantillon n est
//   en gmem[1000016 + (n mod 3500000)] (gauche) / [+ 3500000] (droite).
//   Arret : la cible a bascule (gmem[cible] = jeton + 0.5) ou abandon (gmem[380] = jeton + 0.75) ; refus : [394] = jeton + 0.75.
options:gmem=nowundo_sync
in_pin:left
in_pin:right
in_pin:groupe left
in_pin:groupe right
out_pin:left
out_pin:right
out_pin:groupe left
out_pin:groupe right

@init
DR = 300; LD_BASE = 1000000; LD_MAXN = 3500000;
st = 0; tok = gmem[393]; j = 0; n = 0; g = 1; tb = DR;

@block
(st == 0 && gmem[393] > 0 && gmem[393] != tok) ? (
  tok = gmem[393];
  tg = floor(gmem[381] + 0.5); tb = DR + (tg - 1) * 10;
  (tg >= 1 && tg <= 8 && gmem[tb] == tok && gmem[tb + 5] > 256) ? (
    g = gmem[395]; (g <= 0 || g > 100) ? g = 1;
    gmem[392] = floor(gmem[tb + 1] + 0.5);
    j = 0; n = 0; st = 1; gmem[397] = 0;
  ) : ( gmem[394] = tok + 0.75; );
);
(st == 1 && (gmem[380] == tok + 0.75 || gmem[tb] == tok + 0.5)) ? st = 0;

@sample
st == 1 ? (
  a = LD_BASE + 16 + j;
  gmem[a] = spl0 + spl2 * g; gmem[a + LD_MAXN] = spl1 + spl3 * g;
  j += 1; j >= LD_MAXN ? j = 0;
  n += 1; gmem[397] = n;
);
spl2 = 0; spl3 = 0;
