desc:NU Drop Capture (NowUndo V3.25 : enregistre le passage du drop de groupe, sur la piste de la cible)
// Pose TEMPORAIREMENT par le script Launchpad en BOUT de chaine de la piste du looper cible, puis retire.
// Entrees 1/2 = la cible apres ses effets (avant son fader) ; entrees 3/4 = les autres loopers du groupe, arrives par
// des sends post-fader sur 2 canaux libres de la piste (le script regle le routage des broches 3/4).
// Meme piste que la cible = meme bloc audio : l'horloge du passage (gmem[300 + (cible-1)*10 + 1], publiee au debut de
// chaque bloc par la cible) est exacte, quels que soient le traitement anticipe et la latence de REAPER.
//   gmem[393] = jeton (depart) | [381] = cible 1..8 | [395] = gain des autres loopers (1 / volume de la piste cible)
//   fin : gmem[394] = jeton (jeton + 0.75 = refus) ; abandon : gmem[380] = jeton + 0.75
// Le raccord est fondu : 10 ms de plus, melanges au debut de l'enregistrement. Sorties 1/2 inchangees, 3/4 muettes.
options:gmem=nowundo_sync
in_pin:left
in_pin:right
in_pin:groupe left
in_pin:groupe right
out_pin:left
out_pin:right
out_pin:groupe left
out_pin:groupe right

@init
DR = 300; LD_BASE = 1000000; LD_MAXN = 3500000;
st = 0; tok = gmem[393]; j = 0; n = 0; L = 0; X = 1; g = 1;

@block
(st == 0 && gmem[393] > 0 && gmem[393] != tok) ? (
  tok = gmem[393];
  tg = floor(gmem[381] + 0.5); tb = DR + (tg - 1) * 10;
  L = floor(gmem[tb + 5]); X = max(1, min(floor(srate * 0.01), floor(L / 4)));
  (tg >= 1 && tg <= 8 && gmem[tb] == tok && L > 256 && L + X <= LD_MAXN) ? (
    g = gmem[395]; (g <= 0 || g > 100) ? g = 1;
    j = floor(gmem[tb + 1] + 0.5); j -= L * floor(j / L);
    n = 0; st = 1;
  ) : ( gmem[394] = tok + 0.75; );
);
(st == 1 && gmem[380] == tok + 0.75) ? st = 0;

@sample
st == 1 ? (
  a = LD_BASE + 16 + j;
  vl = spl0 + spl2 * g; vr = spl1 + spl3 * g;
  n < L ? (
    gmem[a] = vl; gmem[a + LD_MAXN] = vr;
  ) : (
    // raccord : au debut le plus recent (continuite avec la fin), puis retour progressif a l'enregistrement du debut
    f = (n - L) / X;
    gmem[a] = vl * (1 - f) + gmem[a] * f;
    gmem[a + LD_MAXN] = vr * (1 - f) + gmem[a + LD_MAXN] * f;
  );
  j += 1; j >= L ? j = 0;
  n += 1;
  n >= L + X ? ( st = 0; gmem[394] = tok; );
);
spl2 = 0; spl3 = 0;
