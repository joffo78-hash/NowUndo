);

@slider
manual_id != slider45 ? manual_id = slider45;
loop_pos_pct != last_slider9 ? ( length > 0 ? ( req_p = (loop_pos_pct * 0.01) * length; abs(req_p - pos) > 10 ? trigger_pos_jump(req_p); ); last_slider9 = loop_pos_pct; );
(det_thresh != last_det_t || det_hold_ms != last_det_h) ? ( start_analysis(); last_det_t = det_thresh; last_det_h = det_hold_ms; ) : slicer_mode != last_slicer_mode ? ( step_len = get_slicer_len(); generate_slicer_sequence(step_len); last_slicer_mode = slicer_mode; slicer_current_step = 0; );
slicer_pitch_spread != last_pitch_spread ? ( last_pitch_spread = slicer_pitch_spread; update_slicer_pitches(get_slicer_len()); );
cloud_on = slider23; loop_quant = slider24; cloud_density = slider25; cloud_chaos = slider26; cloud_spread = slider27; cloud_pitch_spread = slider34; cloud_mix = slider35; cloud_pos_mode = slider36; cloud_pos_pct = slider37; cloud_lfo_shape = slider38; cloud_lfo_rate = slider39; cloud_lfo_depth = slider40; grid_sub = slider32; looper_hue = slider41;
loop_start != prev_loop_start || loop_width != prev_loop_width ? sync_hard_resync = 1;

@sample
in0 = spl0; in1 = spl1; wet_s0 = 0; wet_s1 = 0;
pos_step = 0;
peak_in_vu = max(peak_in_vu * vu_rel, max(abs(in0), abs(in1)));

ms_off = (active_part - 1) * 10;
is_slave = (gmem[ms_off] > 0 && gmem[ms_off + 1] != instance_id && gmem[ms_off + 1] != instance_alias);

is_slave && length > 0 ? (
    master_pos += 1.0;
    master_pos >= length ? (
        master_pos -= length;
        clk_cyc = (clk_cyc + 1) % 840;
        slicer_sample_counter = 1000000000;
    );
