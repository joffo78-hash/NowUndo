desc:aNowUndo V3.6.10 Looper (slicer: gate fix, master clock, steps, presets, max slices) (full hard-resync: reverse + exit slicer + leave stop + In/Out/speed rational)
options:gmem=nowundo_sync
options:maxmem=128000000
slider1:speed=1.0<0.01,100.0,0.01>-Speed
slider2:pitch=0.0<-48,48,0.01>-Pitch (st)
slider3:mix=1.0<0,1,0.01>-Mix
slider4:grain_ms=80.0<20,200,0.1>-Grain (ms)
slider5:fade_ms=10.0<0,500,1>-Fade (ms)
slider6:play_mode=0<0,2,1{Normal,Slicer,One-Shot}>-Playback Mode
slider7:link_on=0<0,1,1{Off,On}>-Link P/S
slider8:state_slider=2<0,8,1{Stop,Rec,Play,Dub,Replace,Auto-Rep,Multiply,Wait,Wait Sync}>-Transport State (interne)
slider9:loop_pos_pct=0.0<0,100,0.1>-Pos (%)
slider10:trans_sens=0.15<0.01,0.8,0.01>-Auto Thresh (Seuil)
slider11:trans_hold_ms=120<30,1000,10>-Auto Hold (ms)
slider12:grain_fade=25<5,50,1>-Grain Fade %
slider13:slicer_mode=0<0,5,1{Random,Steps,Steps,Steps,Steps,All}>-Slicer Mode
slider14:slicer_sub=0<0,5,1{1/4 (Noire),1/8 (Croche),1/12 (Triolet),1/16 (Double),1/24 (Triolet Double),1/32 (Triple)}>-Slicer Rate
slider15:slice_decay_ms=150<10,2000,5>-Slice Decay (ms)
slider16:rev_on=0<0,1,1{Off,On}>-Reverse
slider17:pingpong_on=0<0,1,1{Off,On}>-Ping-Pong
slider18:feedback=1.0<0,2,0.01>-Feedback
slider19:degradation=1.0<0,1,0.01>-Degradation
slider20:stereo_width=0.0<0,1,0.01>-Stereo Enhancer
slider21:out_vol=1.0<0,2,0.01>-Output Volume
slider22:ghost_pos_pct=0.0<0,100,0.1>-Clock (%)
slider23:cloud_on=0<0,1,1{Off,On}>-Cloud Mode
slider24:loop_quant=0<0,9,1{Free,1/2,1/3,1/4,1/6,1/8,1/12,1/16,1/32,1/64}>-Loop Quantize
slider25:cloud_density=0.5<0,1,0.01>-Cloud Density
slider26:cloud_chaos=0.0<0,1,0.01>-Cloud Chaos
slider27:cloud_spread=0.1<0,1,0.01>-Cloud Spread
slider28:dens_occ=100<0,100,0.1>-Density (%)
slider29:dens_len=2<0,6,1{1/1,1/2,1/4,1/8,1/16,1/32,1/64}>-Rec Density Length
slider30:loop_beats=0<0,64,1>-Loop Beats (0=Auto)
slider31:slicer_src=0<0,1,1{Transients,Grid}>-Slice Source
slider32:grid_sub=2<0,5,1{1/4 (Noire),1/8 (Croche),1/12 (Triolet),1/16 (Double),1/24 (Triolet Double),1/32 (Triple)}>-Grid Sub
slider33:slicer_pitch_spread=0.0<0,100,0.01>-Pitch Spread (%)
slider34:cloud_pitch_spread=0.0<0,100,0.01>-Cloud Pitch Spread (%)
slider35:cloud_mix=1.0<0,1,0.01>-Cloud Mix
slider36:cloud_pos_mode=1<0,1,1{Linked,Free}>-Cloud Pos Mode
slider37:cloud_pos_pct=50.0<0,100,0.1>-Cloud Pos (%)
slider38:cloud_lfo_shape=0<0,2,1{Sine,Saw,Inv Saw}>-Cloud LFO Shape
slider39:cloud_lfo_rate=1.0<0.1,4.0,0.01>-Cloud LFO Rate (Hz)
slider40:cloud_lfo_depth=0.0<0,100,0.01>-Cloud LFO Depth (%)
slider41:looper_hue=0<0,8,1{Auto,Rouge,Orange,Jaune,Vert,Cyan,Bleu,Violet,Rose}>-Panel Color
slider42:sampler_root=48<0,127,1>-Sampler Root Note (MIDI)
slider43:sampler_pitch_mode=0<0,1,1{Varispeed,Granular}>-Sampler Pitch Mode (Loop Keys)
slider44:sampler_release=0<0,3000,1>-Sampler Release (ms, 0 = off)
slider45:manual_id=0<0,8,1>-Looper ID (0=Auto)
slider46:clk_src=0<0,1,1{Master Looper,Own Loop}>-Slicer Clock
slider47:slicer_steps=16<1,32,1>-Slicer Steps
slider48:max_slices=0<0,64,1>-Max Slices (0=Off)
slider49:slicer_preset=1<1,4,1>-Slicer Table Preset
slider50:det_thresh=0.15<0.01,0.8,0.01>-Detect Thresh (Slicer)
slider51:det_hold_ms=120<30,1000,10>-Detect Hold (ms, Slicer)
slider52:dub_grain_ms=25<5,200,0.1>-Dub Grain (ms, compensation overdub)
slider53:dub_align_ms=6<0,20,0.1>-Dub Align (ms, 0=off) [WSOLA]
slider54:read_align_ms=6<0,20,0.1>-Read Align (ms, 0=off) [WSOLA lecture]

@init
ext_noinit = 1;

function fast_tanh(x) local(x2, x3, x5) ( 
  abs(x) > 3 ? ( x > 0 ? 1 : -1 ) : ( 
    x2 = x * x; 
    x3 = x2 * x; 
    x5 = x3 * x2; 
    x * (27 + x2) / (27 + 9 * x2) 
  ); 
);

function host_measure_len() local(t, n) ( 
  t = max(tempo, 20); 
  n = ts_num > 0 ? ts_num : 4; 
  srate * (60.0 / t) * n; 
);

// ---- IDENTIFICATION MANUELLE (slider45 + Sérialisation) ----
manual_id > 0 ? (slider45 = manual_id;) : (manual_id = slider45;);

instance_id = manual_id > 0 ? manual_id : 1;
instance_alias = instance_id;
inst_idx = instance_id - 1;
max_inst = 8;

max_loop_sec = 90;
mem_budget = 120000000;

single_buf_len = min(floor(srate * max_loop_sec), floor(mem_budget / 30)); 
buf_len = single_buf_len;
slot_size = single_buf_len * 2;

buf_part1_l = 0; buf_part1_r = single_buf_len;
buf_part2_l = slot_size; buf_part2_r = slot_size + single_buf_len;
buf_part3_l = slot_size * 2; buf_part3_r = slot_size * 2 + single_buf_len;

hist_mem_start = slot_size * 3;
available_slots = floor((mem_budget - hist_mem_start - slot_size - 20000) / slot_size);
max_history = max(2, min(8, available_slots + 1));

base_backup_l = hist_mem_start + (max_history - 1) * slot_size;
base_backup_r = base_backup_l + single_buf_len;

hist_len = base_backup_r + single_buf_len + 1000;   
i = 0; loop(16, hist_len[i] = 0; i += 1;);

active_part = 1; 
target_part = 1;
pending_part_switch = 0;

part_speed = hist_len + 50; part_pitch = part_speed + 3; part_rev = part_pitch + 3;
part_pingpong = part_rev + 3; part_play_mode = part_pingpong + 3;
part_cloud_on = part_play_mode + 3; part_link_on = part_cloud_on + 3;

i = 0;
loop(3,
  part_speed[i] = 1.0; part_pitch[i] = 0.0; part_rev[i] = 0;
  part_pingpong[i] = 0; part_play_mode[i] = 0; part_cloud_on[i] = 0; part_link_on[i] = 0;
  i += 1;
);

len_part1 = 0; len_part2 = 0; len_part3 = 0;
base_len_part1 = 0; base_len_part2 = 0; base_len_part3 = 0;
history_head = 0; history_tail = 0; history_count = 1; active_history_idx = 0;
hist_undo = 0; hist_redo = 0; dirty_len = 0; left_buf = buf_part1_l; right_buf = buf_part1_r;

max_grains = 16; grain_data_size = 8; grain_mem = part_link_on + 100;
max_transients = 256; trans_mem = grain_mem + (max_grains * grain_data_size) + 100;
seq_mem = trans_mem + max_transients + 100; slice_pitch_mem = seq_mem + max_transients + 100;
trans_count = 0;

lut_size = 1024; lut_cos = slice_pitch_mem + max_transients + 100;
i = 0; loop(lut_size, lut_cos[i] = 0.5 - 0.5 * cos(2 * $pi * (i / lut_size)); i += 1; );

i = 0; 
loop(max_grains,
  base = grain_mem + (i * grain_data_size);
  base[0] = 0; base[1] = 0; base[2] = 0; base[3] = srate * 0.1; base[4] = 0; base[5] = 0; base[6] = 0; base[7] = 0;
  i += 1;
);
grain_dur = srate * 0.1; spawn_timer = 0;

delay_len = 32; delay_buf_l = lut_cos + lut_size + 100; delay_buf_r = delay_buf_l + delay_len; delay_idx = 0;

wg_mem = delay_buf_r + delay_len + 100; wg_stride = 5; max_wgrains = 16;
acc_len = single_buf_len; acc_size = acc_len * 3;
ih_size = 32768; ih_mask = 32767; ih_l = wg_mem + max_wgrains * wg_stride + 100; ih_r = ih_l + ih_size; memset(ih_l, 0, ih_size * 2); ih_n = 0; wg_prev_ok = 0; wg_prev_src = 0; wg_prev_n = 0; wg_Lcur = 0;
rd_tmp = ih_r + ih_size + 10; rd_prev_ok = 0; rd_prev_start = 0; rd_prev_n = 0; rd_prev_dur = 0;
acc_set0 = ih_r + ih_size + 400; acc_set1 = acc_set0 + acc_size; acc_end  = acc_set1 + acc_size;
acc_ok = (acc_end + 100) < mem_budget; acc_ok ? memset(acc_set0, 0, acc_size * 2);
acc_cur = 0; acc_cur_dirty = 0; acc_lo = 1000000000; acc_hi = -1;
acc_wmin = 0.5; acc_wrep = 0.9; acc_mode = 1; cm_mode = 1; wg_rf = 1; wg_hop = 0.5; wg_fade = 0.5;
wg_timer = 0; wg_es = 0; wg_el = 16; wg_gL = 1; wg_gR = 1;
cm_active = 0; cm_k = 0; cm_dir = 1; cm_lo = 0; cm_hi = 0; cm_sb = 0;
dub_gran = 0; dub_gran_prev = 0; gran_now = 0; auto_above_prev = 0;

dens_bag = acc_end + 200; dens_bag_i = 16; dens_carry = 0; dens_last_occ = -1;
dens_g = 1; dens_tgt = 1; dens_slot = -1; dens_rt = 0; dens_prev_state = -1; dens_force = 0; dens_len_f = dens_len;
dens_slew = 1.0 / (srate * 0.005);
sl_lo = 0; sl_hi = 0; sl_run = 1; sl_gate = 1; sl_slew = 1.0 / (srate * 0.003);
slice_mute_gate = 1.0; slice_mute_step = 0; slice_mute_target = 1.0;

current_slice_pitch = 0.0; cloud_lfo_phase = 0.0; cloud_center_draw = 0.0;
wow_phase = 0.0; flutter_phase = 0.0;
smp_nv = 16; smp_vs = 16; smp_voice = dens_bag + 16 + 100;
smp_evmax = 512; smp_ev_off = smp_voice + smp_nv * smp_vs + 100; smp_ev_note = smp_ev_off + smp_evmax; smp_ev_vel = smp_ev_note + smp_evmax;
memset(smp_voice, 0, smp_nv * smp_vs); memset(smp_ev_off, 0, smp_evmax * 3);
trans_str = smp_ev_vel + smp_evmax + 100; pslot = 4 + max_transients * 2; preset_mem = trans_str + max_transients + 100;
memset(trans_str, 0, max_transients); memset(preset_mem, 0, pslot * 4);
preset_cur = -1; last_preset = -1; last_steps = slicer_steps; last_max_sl = max_slices; steps_f = slicer_steps; maxsl_f = max_slices;
smp_att = 1.0 / (srate * 0.002); smp_tail = max(1, srate * 0.003); smp_choke_rel = 1.0 / (srate * 0.004); smp_quick_rel = 1.0 / (srate * 0.005);
smp_l = 0; smp_r = 0; smp_rl = 0; smp_rr = 0; smp_age = 0; smp_armed = 0; smp_kmode = 0; smp_mode = 0; smp_prev_mode = 0; smp_G = 4096; smp_Gh = 2048; smp_ev_n = 0; smp_ev_i = 0; smp_blk = 0; smp_alloff = 0; smp_nact = 0;
sampler_root_f = sampler_root; sampler_rel_u = sqrt(sampler_release / 3000);

gm_pspread_slicer = 34;
gm_pspread_cloud  = 35;
gm_sampler_root   = 150;
gm_sampler_armed  = 151;
gm_sampler_voices = 152;
gm_sampler_release = 154;
gm_sampler_pmode  = 153;
gm_bpm            = 155;

function calc_sync_len(current_len, ms_len) local(t) (
  ms_len > 0 ? (
    t = ms_len * 0.125; current_len <= t ? t :
    (t = ms_len * 0.25; current_len <= t ? t :
    (t = ms_len * 0.5;  current_len <= t ? t :
    (ceil(current_len / ms_len) * ms_len)
    ));
  ) : current_len;
);

function loop_beat_len() local(hb, nb) (
  hb = (60 / max(tempo, 20)) * srate;
  length > 0 ? (
    nb = loop_beats >= 1 ? floor(loop_beats + 0.5) : max(1, floor(length / hb + 0.5));
    hb = length / nb;
  );
  hb;
);

function dens_next() local(i, j, t, want, k) (
  (dens_bag_i >= 16 || dens_occ != dens_last_occ) ? (
    dens_occ != dens_last_occ ? dens_carry = 0;
    dens_last_occ = dens_occ;
    dens_occ <= 0.001 ? ( k = 0; dens_carry = 0; ) : (
      want = dens_occ * 0.16 + dens_carry;
      k = min(16, floor(want)); dens_carry = min(1, want - k);
    );
    i = 0; loop(16, dens_bag[i] = (i < k) ? 1 : 0; i += 1;);
    i = 15; loop(15, j = floor(rand(i + 1)); t = dens_bag[i]; dens_bag[i] = dens_bag[j]; dens_bag[j] = t; i -= 1;);
    dens_bag_i = 0;
  );
  dens_tgt = dens_bag[dens_bag_i]; dens_bag_i += 1;
);

write_ptr = 0; state = 0; state_target = 2; last_state_target = 2; rec_cmd = 0; pending_next_state = 2; target_sync_len = 0;
pos = 0; old_pos_ptr = 0; length = 0; loop_start = 0; loop_width = 0; base_loop_length = 0; mult_len = 0;
master_pos = 0; clk_cyc = 0; master_pos1 = 0; master_pos2 = 0; master_pos3 = 0;
is_normal_playback = 0; prev_normal_playback = 0; can_sync = 0; last_ghost_pct = 0; prev_rev_on = 0;
clk_cyc = 0; clk_cyc1 = 0; clk_cyc2 = 0; clk_cyc3 = 0; clk_len_ref = 0;
sync_a = 0; sync_b = 0; sync_c_w = 0; sync_c_l = 0; sync_c_r = 0; prev_sync_key = 0; prev_cloud_on = 0; prev_xcl = 0;
ml_ok = 0; ml_fwd_free = 0; ml_cool = 0;
active_control = 0; smooth_start = 0; smooth_width = 0; param_smooth_coeff = 0.95;
xfade_pos_active = 0; xfade_pos_len = srate * 0.015; xfade_pos_count = 0;
slice_env = 1.0; slice_decay_samples = srate * 0.15; slice_decay_step = 1.0 / slice_decay_samples;
replace_fade = 0; replace_fade_coeff = 1.0 / (srate * 0.02); state_transition_fade = 1.0;
prev_in0 = 0; prev_in1 = 0; grain_mix = 0; xfade_coeff = 1.0 / (srate * 0.01); init_done = 0;
tape_lpf_l = 0; tape_lpf_r = 0; tape_lpf_l_b = 0; tape_lpf_r_b = 0; tape_lpf_l_c = 0; tape_lpf_r_c = 0; tape_lpf_l_d = 0; tape_lpf_r_d = 0;
slice_pan = 0; dub_pan = 0; last_slider9 = loop_pos_pct; last_sens = trans_sens; last_hold = trans_hold_ms; last_det_t = det_thresh; last_det_h = det_hold_ms;
last_slicer_mode = slicer_mode; last_grid_sub = grid_sub; last_pitch_spread = slicer_pitch_spread;
last_slicer_src = -1;
slicer_sample_counter = 0; slicer_current_step = 0; auto_rep_hold_counter = 0; auto_rep_active = 0; input_env = 0; ping_pong_dir = 1;  last_slicer_step = -1;
one_shot_playing = 0; one_shot_pp_state = 0;
analysing = 0; ana_k = 0; ana_end = 0; ana_max_peak = 0.0001; ana_min_dist = 0; ana_win_size = 0; ana_env = 0; ana_last_trig = 0;
ui_en = 1; ui_chg = 0; ui_hov = 0; ui_ar = 1; ui_ag = 1; ui_ab = 1; last_mouse_cap = 0; last_mouse_y = 0;
auto_on = 0; clr_press_time = 0; clr_long_pressed = 0; input_signal_active = 0; hold_samples_left = 0;
cloud_on = 0; cloud_density = 0.5; cloud_chaos = 0.0; cloud_spread = 0.1; cloud_pitch_spread = 0.0; cloud_mix = 1.0; cloud_pos_mode = 1; cloud_pos_pct = 50.0; cloud_lfo_shape = 0; cloud_lfo_rate = 1.0; cloud_lfo_depth = 0.0; loop_quant = 0;
grid_pending = 0; grid_sig = -1;
peak_in_vu = 0; peak_loop_vu = 0; vu_rel = exp(-1.0 / (srate * 0.4));

prev_sm_speed = -1; prev_loop_start = -1; prev_loop_width = -1;
prev_pitch_ratio_sig = -1; prev_pingpong_on = 0;
prev_play_mode = -1; prev_state_for_sync = -1;
sync_hard_resync = 0;
loop_edit_mode = 0;
rec_start_time = 0;

function slicer_beats() ( slicer_sub == 0 ? 1.0 : (slicer_sub == 1 ? 0.5 : (slicer_sub == 2 ? 1.0/3.0 : (slicer_sub == 3 ? 0.25 : (slicer_sub == 4 ? 1.0/6.0 : 0.125)))); );
function grid_beats() ( grid_sub == 0 ? 1.0 : (grid_sub == 1 ? 0.5 : (grid_sub == 2 ? 1.0/3.0 : (grid_sub == 3 ? 0.25 : (grid_sub == 4 ? 1.0/6.0 : 0.125)))); );
function grid_signature() ( length + loop_start * 3 + loop_width * 7 + loop_beat_len() * 13 + grid_sub * 101 + loop_beats * 1009; );
function grid_build() local(st, e) (
  st = max(srate * 0.005, loop_beat_len() * grid_beats()); e = loop_start + loop_width - 1; trans_count = 0;
  while (trans_count < max_transients && loop_start + trans_count * st < e) ( trans_mem[trans_count] = loop_start + trans_count * st; trans_count += 1; );
  analysing = 0; grid_pending = 1; grid_sig = grid_signature();
);
function start_analysis() ( 
  length > 0 ? ( 
    slicer_src == 1 ? grid_build() : ( 
      trans_count = 0; ana_max_peak = 0.0001; 
      ana_k = floor(loop_start); ana_end = floor(loop_start + loop_width); 
      ana_prev_l = 0; ana_prev_r = 0;
      analysing = 1; 
    ); 
  ); 
);
function switch_history_slot(idx) (
  active_history_idx = idx;
  idx == 0 ? ( left_buf = active_part == 1 ? buf_part1_l : (active_part == 2 ? buf_part2_l : buf_part3_l); right_buf = active_part == 1 ? buf_part1_r : (active_part == 2 ? buf_part2_r : buf_part3_r);
  ) : ( left_buf = hist_mem_start + (idx - 1) * slot_size; right_buf = left_buf + single_buf_len; );
);
function transparent_soft_clip(x) local(ax, excess) ( ax = abs(x); ax > 0.95 ? ( excess = ax - 0.95; (x > 0 ? 1 : -1) * (0.95 + 0.05 * (excess / (0.05 + excess))); ) : ( x; ); );
function wg_splat(a, b, env, sb) local(lo, hi, span, k, k_end, steps, seg_a, seg_b, wgt, tn, vL, vR, kk, w_, mono, yr_b, w_b) (
  lo = min(a, b); hi = max(a, b); span = max(hi - lo, 0.0001); k = floor(lo); k_end = floor(hi); steps = min(k_end - k + 1, 24); yr_b = sb + acc_len; w_b = sb + acc_len * 2;
  loop(steps,
    seg_a = max(lo, k); seg_b = min(hi, k + 1); wgt = seg_b - seg_a;
    wgt > 0 ? (
      tn = ((seg_a + seg_b) * 0.5 - lo) / span; a > b ? tn = 1.0 - tn;
      vL = wg_p0 + (wg_c0 - wg_p0) * tn; vR = wg_p1 + (wg_c1 - wg_p1) * tn;
      stereo_width > 0.0001 ? ( mono = (vL + vR) * 0.5; vL = mono * wg_gL; vR = mono * wg_gR; );
      kk = k - wg_es; kk -= floor(kk / wg_el) * wg_el; kk += wg_es;
      kk >= 0 && kk < (length > 0 ? length : buf_len) ? (
        w_ = env * wgt * wg_rf; sb[kk] += vL * w_; yr_b[kk] += vR * w_; w_b[kk] += w_;
        kk < acc_lo ? acc_lo = kk; kk > acc_hi ? acc_hi = kk;
      );
    ); k += 1;
  );
);
// V3.6.10 WSOLA : cherche le decalage source (-Sn..+Sn) dont le debut de grain colle le mieux a la suite du grain precedent.
function wg_pick(s_nom, t0, Sn, Wn) local(best, bestd, dd, k, c, num, en, sc, stp) (
  stp = (Sn * Wn > 40000) ? 2 : 1; best = -1000000000; bestd = 0; dd = -Sn;
  while (dd <= Sn) (
    num = 0; en = 0.000000001; k = 0;
    while (k < Wn) (
      c = ih_l[(s_nom + dd + k) & ih_mask] + ih_r[(s_nom + dd + k) & ih_mask];
      num += c * (ih_l[(t0 + k) & ih_mask] + ih_r[(t0 + k) & ih_mask]);
      en += c * c; k += stp;
    );
    sc = num / sqrt(en); sc > best ? ( best = sc; bestd = dd; );
    dd += stp;
  );
  bestd;
);
function ih_wrap() local(gi, gb) ( ih_n -= 1073741824; wg_prev_src -= 1073741824; wg_prev_n -= 1073741824; gi = 0; loop(max_wgrains, gb = wg_mem + gi * wg_stride; gb[3] -= 1073741824; gi += 1; ); );
// V3.6.10 WSOLA LECTURE : le debut de chaque grain de lecture est decale (-Sn..+Sn) pour coller a la suite du grain precedent.
function rd_tp(x) local(k) ( k = floor(x); k -= floor((k - floor(eff_start)) / max(floor(eff_end) - floor(eff_start), 1)) * max(floor(eff_end) - floor(eff_start), 1); k = max(floor(eff_start), min(floor(eff_end) - 1, k)); left_buf[k] + right_buf[k]; );
function rd_score(p, stp, n) local(i, num, en, c) ( num = 0; en = 0.000000001; i = 0; while (i < n) ( c = rd_tp(p + stp * i * 4); num += c * rd_tmp[i]; en += c * c; i += 1; ); num / sqrt(en); );
function rd_pick(p0, ts, ph_prev, Sn, Wn, rr, dir) local(k, n, dd, best, bestd, sc, st, en_) (
  n = 0; k = 0; while (k < Wn) ( rd_tmp[n] = rd_tp(ts + dir * rr * (ph_prev + k)); n += 1; k += 4; );
  best = -1000000000; bestd = 0; dd = -Sn;
  while (dd <= Sn) ( sc = rd_score(p0 + dd, dir * rr, n); sc > best ? ( best = sc; bestd = dd; ); dd += 4; );
  st = bestd; dd = st - 3;
  while (dd <= st + 3) ( dd >= -Sn && dd <= Sn ? ( sc = rd_score(p0 + dd, dir * rr, n); sc > best ? ( best = sc; bestd = dd; ); ); dd += 1; );
  bestd;
);
