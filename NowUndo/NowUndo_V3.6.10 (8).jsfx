function ui_log_knob(id, cx, cy, r, val, mn, mx, label, fmt, def) local(log_mn, log_mx, log_rng, log_val, hot, d, norm, ang, ua, tw, th, act) ( ui_chg = 0; log_mn = log(mn); log_mx = log(mx); log_rng = max(log_mx - log_mn, 0.000001); log_val = log(max(val, mn)); hot = ui_en && abs(mouse_x - cx) <= r + 5 && abs(mouse_y - cy) <= r + 5; ui_en && mouse_click && active_control == 0 && hot ? ( (mouse_cap & 4) ? ( val = def; ui_chg = 1; ) : ( active_control = id; ); ); ui_en && active_control == id ? ( d = last_mouse_y - mouse_y; (mouse_cap & 8) ? d *= 0.2; d != 0 ? ( log_val = max(log_mn, min(log_mx, log_val + d * log_rng / 200)); val = exp(log_val); ui_chg = 1; ); ); ua = ui_en ? 1 : 0.4; act = (active_control == id); norm = max(0, min(1, (log_val - log_mn) / log_rng)); ang = 0.75 * $pi + norm * 1.5 * $pi; gfx_set(0.12, 0.04, 0.05, ua); gfx_circle(cx, cy, r - 2, 1); gfx_set(0.30, 0.12, 0.15, ua); gfx_circle(cx, cy, r - 2, 0); gfx_set(0.24, 0.09, 0.11, ua); ui_arc(cx, cy, r + 3, 0.75 * $pi, 2.25 * $pi); norm > 0.004 ? ( gfx_set(ui_ar, ui_ag, ui_ab, ua); ui_arc(cx, cy, r + 3, 0.75 * $pi, ang); ); gfx_set(1, 1, 1, ua * (act ? 1 : 0.9)); gfx_line(cx + cos(ang) * r * 0.3, cy + sin(ang) * r * 0.3, cx + cos(ang) * (r - 4), cy + sin(ang) * (r - 4)); gfx_setfont(1); gfx_set(0.85, 0.75, 0.78, ua); gfx_measurestr(label, tw, th); gfx_x = cx - tw * 0.5; gfx_y = cy - r - 18; gfx_drawstr(label); sprintf(#knobval, fmt, val); (act || hot) ? gfx_set(1, 1, 1, ua) : gfx_set(0.9, 0.82, 0.84, ua); gfx_measurestr(#knobval, tw, th); gfx_x = cx - tw * 0.5; gfx_y = cy + r + 7; gfx_drawstr(#knobval); val; );

@serialize
file_var(0, manual_id);

@block
smp_ev_n = 0; smp_ev_i = 0;
// V3.6.10: Cloud et Slicer exclusifs. Le dernier active gagne.
(play_mode == 1 && cloud_on) ? ( cloud_on != prev_xcl ? ( play_mode = 0; slider6 = 0; ) : ( cloud_on = 0; slider23 = 0; ); );
prev_xcl = cloud_on;

// ---- SLICER CLOCK : suivi de la position du looper master ----
blk_ms = (active_part - 1) * 10;
mclk_on = (clk_src == 0 && gmem[blk_ms] == 1 && gmem[blk_ms + 1] != instance_id && gmem[blk_ms + 1] != instance_alias && gmem[blk_ms + 2] > 0);
mclk_on ? (
  mclk_len = gmem[blk_ms + 2]; mclk_m = gmem[blk_ms + 3];
  (!mclk_valid || mclk_len != mclk_len_prev) ? (
    mclk_pos = mclk_m; mclk_cyc = gmem[blk_ms + 4] % 840; mclk_valid = 1; mclk_len_prev = mclk_len; last_slicer_step = -1;
  ) : (
    mclk_d = mclk_m - mclk_pos; mclk_d -= mclk_len * floor(mclk_d / mclk_len + 0.5);
    mclk_np = mclk_pos + (abs(mclk_d) > 4096 ? mclk_d : mclk_d * 0.1);
    mclk_np >= mclk_len ? ( mclk_np -= mclk_len; mclk_cyc = (mclk_cyc + 1) % 840; ) : ( mclk_np < 0 ? ( mclk_np += mclk_len; mclk_cyc = (mclk_cyc + 839) % 840; ); );
    mclk_pos = mclk_np;
  );
) : ( mclk_valid = 0; );
while (midirecv(mo_off, mo_m1, mo_m2, mo_m3)) (
  midisend(mo_off, mo_m1, mo_m2, mo_m3);
  mo_t = mo_m1 & 240;
  (mo_t == 144 && mo_m3 > 0) ? (
    smp_ev_n < smp_evmax ? ( smp_ev_off[smp_ev_n] = mo_off; smp_ev_note[smp_ev_n] = mo_m2; smp_ev_vel[smp_ev_n] = mo_m3; smp_ev_n += 1; );
  ) : ((mo_t == 128 || mo_t == 144) ? (
    smp_ev_n < smp_evmax ? ( smp_ev_off[smp_ev_n] = mo_off; smp_ev_note[smp_ev_n] = mo_m2; smp_ev_vel[smp_ev_n] = 0; smp_ev_n += 1; );
  ) : (
    (mo_t == 176 && (mo_m2 == 123 || mo_m2 == 120)) ? smp_alloff = 1;
  ));
);

(slicer_src != last_slicer_src || grid_sub != last_grid_sub) ? ( last_slicer_src = slicer_src; last_grid_sub = grid_sub; grid_sig = -1; length > 0 ? start_analysis(); );
slicer_pitch_spread != last_pitch_spread ? ( last_pitch_spread = slicer_pitch_spread; update_slicer_pitches(get_slicer_len()); );
(slicer_src == 1 && length > 0 && grid_signature() != grid_sig) ? start_analysis();
grid_pending ? ( generate_slicer_sequence(get_slicer_len()); slicer_current_step = 0; grid_pending = 0; );
// ---- STEPS libres + PRESETS de table + MAX SLICES ----
slicer_steps != last_steps ? (
  slicer_mode == 1 ? slicer_resize(floor(last_steps + 0.5), floor(slicer_steps + 0.5));
  last_steps = slicer_steps;
);
preset_cur < 0 ? (
  preset_cur = max(0, min(3, floor(slicer_preset + 0.5) - 1)); last_preset = slicer_preset;
) : (
  slicer_preset != last_preset ? ( last_preset = slicer_preset; preset_switch(max(0, min(3, floor(slicer_preset + 0.5) - 1))); );
);
(max_slices != last_max_sl && active_control != 48) ? ( last_max_sl = max_slices; start_analysis(); );
analysing == 1 ? (
  i = 0; while(i < 16384 && ana_k < ana_end) ( s_l = left_buf[ana_k]; s_r = right_buf[ana_k]; hfc = abs(s_l - (ana_prev_l ? ana_prev_l : s_l)) + abs(s_r - (ana_prev_r ? ana_prev_r : s_r)); ana_prev_l = s_l; ana_prev_r = s_r; hfc > ana_max_peak ? ana_max_peak = hfc; ana_k += 1; i += 1; );
  ana_k >= ana_end ? ( ana_min_dist = srate * (det_hold_ms * 0.001); ana_last_trig = -ana_min_dist; ana_win_size = floor(srate * 0.004); ana_k = floor(loop_start); ana_env = 0; ana_prev_l = 0; ana_prev_r = 0; analysing = 2; );
) : analysing == 2 ? (
  i = 0; while(i < 64 && ana_k < ana_end - ana_win_size) (
    hfc_win = 0; j = 0; loop(ana_win_size, s_l = left_buf[ana_k + j]; s_r = right_buf[ana_k + j]; hfc = abs(s_l - (ana_prev_l ? ana_prev_l : s_l)) + abs(s_r - (ana_prev_r ? ana_prev_r : s_r)); ana_prev_l = s_l; ana_prev_r = s_r; hfc > hfc_win ? hfc_win = hfc; j += 1; );
    norm_s = hfc_win / max(ana_max_peak, 0.0001); prev_env = ana_env; ana_env = ana_env * 0.5 + norm_s * 0.5;
    (norm_s > det_thresh && (ana_env - prev_env) > (det_thresh * 0.15) && (ana_k - ana_last_trig) > ana_min_dist && trans_count < max_transients) ? ( trans_mem[trans_count] = ana_k; trans_str[trans_count] = norm_s; trans_count += 1; ana_last_trig = ana_k; );
    ana_k += ana_win_size; i += 1; );
  ana_k >= ana_end - ana_win_size ? ( slicer_src == 0 ? trans_cap(floor(max_slices + 0.5)); step_len = get_slicer_len(); generate_slicer_sequence(step_len); analysing = 0; );
);

// MAJ DE L'ID (slider manuel)
instance_id = manual_id > 0 ? manual_id : 1;
instance_alias = instance_id;
inst_idx = instance_id - 1;

gmem[100 + inst_idx] = instance_id;
gmem[130 + inst_idx] = time_precise();
gmem[160 + inst_idx] = looper_hue;

p = 0;
loop(3,
  gmem_base = 1000 + (inst_idx * 600) + p * 200;
  
  cmd = gmem[gmem_base + 48];
  cmd > 0 ? (
    // Remote transport / mode commands (Launchpad / Virtual Launchpad)
    // +48 = cmd, +49 = optional numeric arg (speed/pitch step, etc.)
    cmd_arg = gmem[gmem_base + 49];
    // cmd 12 = switch de part quantize (comme les boutons Main/Chorus/Bridge de l'UI) :
    //   length > 0 -> pending jusqu'a fin de cycle ; sinon switch immediat.
    //   re-tap sur la part active / cible = annule le pending.
    cmd == 12 ? (
      req_part = p + 1;
      req_part == active_part ? (
        pending_part_switch = 0;
      ) : (
        pending_part_switch && target_part == req_part ? (
          pending_part_switch = 0; // re-tap = annule
        ) : (
          length > 0 ? ( target_part = req_part; pending_part_switch = 1; ) : switch_part(req_part);
        );
      );
    ) : (
      // autres commandes : bascule d'abord sur la part du slot si besoin
      p != (active_part - 1) ? switch_part(p + 1);
      cmd == 1 ? ( length > 0 && state != 1 && state != 8 ? state_target = (state == 3 ? 2 : 3) : rec_cmd = 1; ) :
      cmd == 2 ? ( do_clear(0); state_target = 0; ) :
      cmd == 3 ? ( state_target = (state == 0 || state == 7) ? 2 : 0; ) :
      cmd == 4 ? ( rev_on = !rev_on; slider16 = rev_on; ) :
      cmd == 5 ? ( pingpong_on = !pingpong_on; slider17 = pingpong_on; ) :
      cmd == 6 ? ( play_mode = (play_mode == 1 ? 0 : 1); slider6 = play_mode; play_mode == 1 ? ( cloud_on = 0; slider23 = 0; ); ) :
      cmd == 7 ? ( cloud_on = !cloud_on; slider23 = cloud_on; cloud_on && play_mode == 1 ? ( play_mode = 0; slider6 = 0; ); ) :
      cmd == 8 ? ( link_on = !link_on; slider7 = link_on; ) :
      cmd == 9 ? ( state_target = (state == 4 ? 2 : 4); ) :
      cmd == 10 ? ( state_target = (state == 5 ? 2 : 5); ) :
      cmd == 11 ? ( do_clear(1); state_target = 0; ) :
      cmd == 13 ? ( state_target = (state == 6 ? 2 : 6); ) : // Multiply
    cmd == 14 ? undo_state() :
    cmd == 15 ? redo_state() :
    cmd == 16 ? trigger_restart() :
    cmd == 17 ? ( do_clear(0); state_target = 1; ) : // Re-Rec
    cmd == 18 ? ( // One-Shot toggle
      play_mode = (play_mode == 2 ? 0 : 2); slider6 = play_mode;
      play_mode == 2 ? ( cloud_on = 0; slider23 = 0; );
    ) :
    cmd == 19 ? ( auto_on = !auto_on; ) :
    cmd == 20 ? ( // relative speed step: arg in semitones-ish ratio factors via 2^(st/12)
      st = cmd_arg;
      abs(st) < 0.0001 ? st = 12;
      speed = max(0.01, min(100, speed * (2 ^ (st / 12)))); slider1 = speed;
    ) :
    cmd == 21 ? ( // relative pitch step in semitones
      st = cmd_arg;
      abs(st) < 0.0001 ? st = 12;
      pitch = max(-48, min(48, pitch + st)); slider2 = pitch;
    ) :
    cmd == 22 ? ( // Full Loop
      length > 0 ? ( loop_start = 0; loop_width = length; sync_hard_resync = 1; );
    ) :
    cmd == 23 ? ( // Quantise In/Out cycle
      loop_quant = (loop_quant >= 9 ? 0 : loop_quant + 1); slider24 = loop_quant;
      length > 0 ? ( loop_start = apply_quant_start(loop_start); loop_width = apply_quant_width(loop_width, loop_start); sync_hard_resync = 1; );
    ) :
    0;
    );
    gmem[gmem_base + 48] = 0;
    gmem[gmem_base + 49] = 0;
  );

  // Dashboard Twister In/Out/Width:
  // 160=1 +161=in  -> set In, keep Out fixed (mode Out)
  // 160=5 +161=in  -> set In, keep Width fixed (mode Width) ; shrink width if hits end
  // 160=2 +162=out -> set Out absolute
  // 160=3 +162=w   -> set Width
  // 160=4          -> reset full loop
  edit_cmd = gmem[gmem_base + 160];
  edit_cmd > 0 ? (
    p != (active_part - 1) ? switch_part(p + 1);
    length > 0 ? (
      edit_cmd == 1 ? (
        // Mode Out: move In, preserve end
        new_in = gmem[gmem_base + 161];
        new_in = apply_quant_start(max(0, min(new_in, length - min_width())));
        old_end = loop_start + loop_width;
        loop_start = new_in;
        loop_width = max(min_width(), old_end - loop_start);
        loop_width = min(loop_width, length - loop_start);
        sync_hard_resync = 1;
      ) :
      edit_cmd == 5 ? (
        // Mode Width: move In, preserve width (shrink only if right edge hits length)
        new_in = gmem[gmem_base + 161];
        keep_w = loop_width;
        new_in = apply_quant_start(max(0, min(new_in, length - min_width())));
        loop_start = new_in;
        loop_width = max(min_width(), min(keep_w, length - loop_start));
        sync_hard_resync = 1;
      ) :
      
      edit_cmd == 2 ? (
        new_out = gmem[gmem_base + 162];
        gq = quant_grid();
        gq > 0 ? new_out = floor(new_out / gq + 0.5) * gq;
        new_out = max(loop_start + min_width(), min(new_out, length));
        loop_width = new_out - loop_start;
        sync_hard_resync = 1;
      ) :
      edit_cmd == 3 ? (
        new_w = gmem[gmem_base + 162];
        loop_width = apply_quant_width(new_w, loop_start);
        sync_hard_resync = 1;
      ) :
      edit_cmd == 4 ? (
        loop_start = 0;
        loop_width = length;
        sync_hard_resync = 1;
      );
    );
    gmem[gmem_base + 160] = 0;
    gmem[gmem_base + 161] = 0;
    gmem[gmem_base + 162] = 0;
  );

  // Remote param write (ReaImGui / external): +180 = param id, +181 = value
  // Applied only on the active part; id mirrors export offsets.
  wr_id = gmem[gmem_base + 180];
  wr_id > 0 ? (
    p != (active_part - 1) ? switch_part(p + 1);
    wr_v = gmem[gmem_base + 181];
    wr_id == 3  ? ( speed = max(0.01, min(100, wr_v)); slider1 = speed; ) :
    wr_id == 4  ? ( pitch = max(-48, min(48, wr_v)); slider2 = pitch; ) :
    wr_id == 5  ? ( mix = max(0, min(1, wr_v)); slider3 = mix; ) :
    wr_id == 6  ? ( grain_ms = max(20, min(200, wr_v)); slider4 = grain_ms; ) :
    wr_id == 7  ? ( fade_ms = max(0, min(500, wr_v)); slider5 = fade_ms; ) :
    wr_id == 10 ? ( length > 0 ? ( req_p = (max(0, min(100, wr_v)) * 0.01) * length; trigger_pos_jump(req_p); slider9 = (pos / length) * 100; last_slider9 = slider9; ); ) :
    wr_id == 13 ? ( grain_fade = max(5, min(50, wr_v)); slider12 = grain_fade; ) :
    wr_id == 19 ? ( feedback = max(0, min(2, wr_v)); slider18 = feedback; ) :
    wr_id == 20 ? ( degradation = max(0, min(1, wr_v)); slider19 = degradation; ) :
    wr_id == 21 ? ( stereo_width = max(0, min(1, wr_v)); slider20 = stereo_width; ) :
    wr_id == 22 ? ( out_vol = max(0, min(2, wr_v)); slider21 = out_vol; ) :
    wr_id == 26 ? ( cloud_density = max(0, min(1, wr_v)); slider25 = cloud_density; ) :
    wr_id == 27 ? ( cloud_chaos = max(0, min(1, wr_v)); slider26 = cloud_chaos; ) :
    wr_id == 28 ? ( cloud_spread = max(0, min(1, wr_v)); slider27 = cloud_spread; ) :
    wr_id == 29 ? ( dens_occ = max(0, min(100, wr_v)); slider28 = dens_occ; ) :
    wr_id == 34 ? ( slicer_pitch_spread = max(0, min(100, wr_v)); slider33 = slicer_pitch_spread; ) :
    wr_id == 35 ? ( cloud_pitch_spread = max(0, min(100, wr_v)); slider34 = cloud_pitch_spread; ) :
    wr_id == 36 ? ( cloud_mix = max(0, min(1, wr_v)); slider35 = cloud_mix; ) :
    wr_id == 38 ? ( cloud_pos_pct = max(0, min(100, wr_v)); slider37 = cloud_pos_pct; ) :
    wr_id == 40 ? ( cloud_lfo_rate = max(0.1, min(4, wr_v)); slider39 = cloud_lfo_rate; ) :
    wr_id == 41 ? ( cloud_lfo_depth = max(0, min(100, wr_v)); slider40 = cloud_lfo_depth; ) :
    0;
    gmem[gmem_base + 180] = 0;
    gmem[gmem_base + 181] = 0;
  );
  
  gmem[gmem_base + 0]  = instance_id;
  gmem[gmem_base + 1]  = instance_alias;
  
  is_active = (p == (active_part - 1));
  is_active ? (
    gmem[gmem_base + 2]  = state;
    gmem[gmem_base + 3]  = speed;
    gmem[gmem_base + 4]  = pitch;
    gmem[gmem_base + 5]  = mix;
    gmem[gmem_base + 6]  = grain_ms;
    gmem[gmem_base + 7]  = fade_ms;
    gmem[gmem_base + 8]  = play_mode;
    gmem[gmem_base + 9]  = link_on;
    gmem[gmem_base + 10] = loop_pos_pct;
    gmem[gmem_base + 47] = length > 0 ? (pos / length) * 100.0 : 0;
    gmem[gmem_base + 11] = trans_sens;
    gmem[gmem_base + 12] = trans_hold_ms;
    gmem[gmem_base + 13] = grain_fade;
    gmem[gmem_base + 14] = slicer_mode;
    gmem[gmem_base + 15] = slicer_sub;
    gmem[gmem_base + 16] = slice_decay_ms;
    gmem[gmem_base + 17] = rev_on;
    gmem[gmem_base + 18] = pingpong_on;
    gmem[gmem_base + 19] = feedback;
    gmem[gmem_base + 20] = degradation;
    gmem[gmem_base + 21] = stereo_width;
    gmem[gmem_base + 22] = out_vol;
    gmem[gmem_base + 23] = length > 0 ? (master_pos / length) * 100.0 : 0;
    gmem[gmem_base + 24] = cloud_on;
    gmem[gmem_base + 25] = loop_quant;
    gmem[gmem_base + 26] = cloud_density;
    gmem[gmem_base + 27] = cloud_chaos;
    gmem[gmem_base + 28] = cloud_spread;
    gmem[gmem_base + 29] = dens_occ;
    gmem[gmem_base + 30] = dens_len;
    gmem[gmem_base + 31] = loop_beats;
    gmem[gmem_base + 32] = slicer_src;
    gmem[gmem_base + 33] = grid_sub;
    gmem[gmem_base + gm_pspread_slicer] = slicer_pitch_spread;
    gmem[gmem_base + gm_pspread_cloud] = cloud_pitch_spread;
    gmem[gmem_base + 36] = cloud_mix;
    gmem[gmem_base + 37] = cloud_pos_mode;
    gmem[gmem_base + 38] = cloud_pos_pct;
    gmem[gmem_base + 39] = cloud_lfo_shape;
    gmem[gmem_base + 40] = cloud_lfo_rate;
    gmem[gmem_base + 41] = cloud_lfo_depth;
    gmem[gmem_base + 42] = active_part;
    gmem[gmem_base + 163] = pending_part_switch;
    gmem[gmem_base + 164] = target_part;
    gmem[gmem_base + 43] = auto_on;
    gmem[gmem_base + 44] = loop_start;
    gmem[gmem_base + 45] = loop_width;
    gmem[gmem_base + 46] = length;
    gmem[gmem_base + gm_sampler_root] = sampler_root;
    gmem[gmem_base + gm_sampler_armed] = smp_mode;
    gmem[gmem_base + gm_sampler_pmode] = sampler_pitch_mode;
    gmem[gmem_base + gm_sampler_release] = sampler_release;
    gmem[gmem_base + gm_sampler_voices] = smp_nact;
    gmem[gmem_base + gm_bpm] = (length > 0) ? (60.0 * srate / loop_beat_len()) : 0;
    
    wave_export_slots = 100;
    max_len_exp = (length > 0) ? length : (state == 1 || state == 8 ? pos : 0);
    max_len_exp > 0 ? (
