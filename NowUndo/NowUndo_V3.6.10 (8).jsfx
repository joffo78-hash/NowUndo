      );
    ) : (
      wi_ex = 0; loop(100, gmem[gmem_base + 50 + wi_ex] = 0; wi_ex += 1;);
    );
  ) : (
    gmem[gmem_base + 2] = 0;
    p_len = (p == 0 ? len_part1 : (p == 1 ? len_part2 : len_part3));
    gmem[gmem_base + 46] = p_len;
    gmem[gmem_base + 10] = 0;
    gmem[gmem_base + 23] = 0;
    gmem[gmem_base + 42] = active_part;
    gmem[gmem_base + 163] = pending_part_switch;
    gmem[gmem_base + 164] = target_part;
    
    p_len == 0 ? (
